(* PWL 2.0 - Pathway Layout Language. Grammar as implemented by ecmapper/pwl/syntax.py.
   Whitespace separates tokens; '//' starts a comment that runs to the end of the line.
   A comment on the line of a link is kept as the comment of its reactions; it carries no meaning. *)

file          = 'pwl' VERSION ';' 'subsystem' SUBID STR '{' { statement } '}' ;
statement     = flow | compartment | compound | port
              | chain [ wrap ] ';' | ring | star | react | motif | effector ;

(* ---------------------------------------------------------------- declarations *)
flow          = 'flow' ( 'down' | 'up' | 'left' | 'right' ) ';' ;          (* at most once *)
compartment   = 'compartment' ID [ STR ] ';' ;
compound      = 'compound' TOKEN [ STR ] { XREF } ';' ;                    (* every token used must be declared *)
XREF          = NAMESPACE ':' ( ID | NUM ) ;                                (* brenda:29  kegg:C00024 *)
port          = 'port' species 'side' ( 'U' | 'D' | 'L' | 'R' ) [ 'to' SUBID ] ';' ;

(* ---------------------------------------------------------------- reactions *)
chain         = node link node { link node } ;
node          = participant                                                (* one compound *)
              | '(' participant '+' participant { '+' participant } ')'    (* compounds on the SAME side *)
              | '_' ;                                                      (* no drawn compound on this side *)
participant   = [ COEF '*' ] species ;
species       = TOKEN [ '#' INT ] [ '@' ID ] ;                             (* #n: n-th drawn copy (n >= 2); @: compartment *)
COEF          = NUM | 'n' ;

link          = OPEN [ TURN ] '[' reactions ']' CLOSE ;
(* allowed (OPEN, CLOSE) pairs and the direction they give, from the left node to the right node:
     -[..]-    unknown          -[..]->   left -> right     <-[..]-   right -> left
     <-[..]->  reversible       -[..]=>   irreversible, left -> right
                                <=[..]-   irreversible, right -> left
   every other combination is an error *)
OPEN          = '-' | '<-' | '<=' ;
CLOSE         = '-' | '->' | '=>' ;
TURN          = 'F' | 'L' | 'R' | 'B' ;                                    (* drawn step relative to the heading *)

reactions     = reaction { '||' reaction } ;                               (* fan: parallel reactions *)
reaction      = RID ':' [ DIR ] [ '~' ] enzyme [ '|' cofactor { ',' cofactor } ] [ '^' ( 'L' | 'R' ) ] [ attrs ] ;
(* DIR: direction of this reaction from the left to the right node; only inside a plain link -[..]-
   (a link with arrows gives the direction of all its reactions) *)
DIR           = '->' | '<-' | '<->' | '=>' | '<=' ;
enzyme        = EC { '/' EC } | '?' ;                                      (* '~?' = spontaneous *)
cofactor      = cof_species '>' cof_species                                (* consumed > produced *)
              | '-' cof_species                                            (* consumed *)
              | '+' cof_species ;                                          (* produced *)
cof_species   = [ COEF '*' ] TOKEN [ '@' ID ] ;
attrs         = '{' KEY '=' VALUE { ',' KEY '=' VALUE } '}' ;              (* free annotations, see PWL.md *)

react         = 'react' '[' reaction ']' '{' participant { ',' participant } '}' ';' ;
(* a reaction whose main metabolites are not known to be split into sides; it has no direction *)

(* ---------------------------------------------------------------- layout blocks *)
wrap          = 'wrap' ( 'serpentine' | 'spiral' | 'column' ) 'period' INT ;
ring          = 'ring' ( 'cw' | 'ccw' ) '{' ring_stmt { ring_stmt } '}' ;
ring_stmt     = chain ';' | 'chord' chain ';' | react ;                    (* no flow, port, ring ... inside *)
star          = 'star' species 'arc' INT 'order' ( 'cw' | 'ccw' ) '{' { spoke ';' } '}' ;
spoke         = link node { link node } ;                                  (* starts at the hub *)

(* ---------------------------------------------------------------- motifs and regulation *)
motif         = 'motif' KIND { KEY '=' ( ID | NUM | STR ) } members { ROLE members } ';' ;
members       = '{' { ID [ '@' ID ] } '}' ;                                (* compound tokens or reaction IDs *)
(* KIND/ROLE checked for: cycle, substrate_cycle (forward, backward), shunt (bypasses), repeat,
   carrier (forward, backward), transport (via); other kinds are accepted without checks *)
effector      = 'effector' species ( 'inhibits' | 'activates' ) RID { ',' RID } ';' ;

(* ---------------------------------------------------------------- lexical *)
TOKEN         = ID - KEYWORD ;                                             (* compound token, no '+' *)
KEYWORD       = 'pwl' | 'subsystem' | 'compartment' | 'compound' | 'flow' | 'port' | 'ring' | 'chord'
              | 'star' | 'react' | 'motif' | 'effector' | 'wrap' ;
ID            = [A-Za-z0-9_]+ ;
RID           = ID ;                                                       (* reaction ID, unique in the file *)
SUBID         = [A-Za-z0-9_][A-Za-z0-9_-]* ;                               (* only after 'subsystem' and 'to' *)
EC            = DIGITS '.' SEG '.' SEG [ '.' SEG ] ;                       (* SEG = [0-9A-Za-z?-]+ *)
NUM           = DIGITS [ '.' DIGITS ] ;                                    (* not followed by a letter, digit, '_' or '.' *)
INT           = DIGITS ;
VERSION       = '2.0' ;
STR           = "'" { any character except quote, backslash, newline | '\' any character } "'" ;
KEY           = [A-Za-z_][A-Za-z0-9_]* ;
VALUE         = [A-Za-z0-9_.+:/-]+ ;
