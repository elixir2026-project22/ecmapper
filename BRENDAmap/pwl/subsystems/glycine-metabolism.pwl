pwl 2.0;
subsystem glycine-metabolism 'glycine metabolism' {
  // BRENDA subsystem: 12 reactions (12 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2OG brenda:34 kegg:C00026;
  compound 5_10_methylenetetrahydrofolate '5,10-methylenetetrahydrofolate' brenda:401 kegg:C00143;
  compound 6S_THFA '(6S)-THFA' brenda:207 brenda:235324 kegg:C00101;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Ala brenda:103 kegg:C00041;
  compound Arg brenda:123 kegg:C00062;
  compound CO2 brenda:28 kegg:C00011;
  compound Creatine brenda:433 kegg:C00300;
  compound Glu brenda:41 kegg:C00025;
  compound Gly brenda:72 kegg:C00037;
  compound Guanidinoacetate brenda:1788 kegg:C00581;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound HPR brenda:389 kegg:C00168;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NH3 brenda:27;
  compound NH4 'NH4+' brenda:4224;
  compound O2 brenda:9 brenda:1180;
  compound Orn brenda:192 kegg:C00077;
  compound Pi brenda:16 kegg:C00009;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound Ser brenda:95 kegg:C00065;
  compound acetate brenda:47 kegg:C00033;
  compound acetyl_phosphate 'acetyl phosphate' brenda:358 kegg:C00227;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound glycolate brenda:479 kegg:C00160;
  compound glyoxylate brenda:101 kegg:C00048;
  compound pyruvate brenda:31 kegg:C00022;
  compound thioredoxin brenda:121 kegg:C00342;
  compound thioredoxin_disulfide 'thioredoxin disulfide' brenda:476 kegg:C00343;
  port Gly side R to threonine-metabolism;
  port Ser side L to serine-metabolism;

  glycolate
    -B[node3477: 1.1.3.15 | -O2, +H2O2 ^L {br=BS257485, ev=cof+eq}]-> glyoxylate  // (S)-2-hydroxy-acid oxidase
    -R[node5531: -> 2.6.1.44 | Ala>pyruvate {br=BR47693, ev=cof+eq} || node5253: <- 2.6.1.4 | 2OG>Glu {br=BR47690, ev=cof+eq} || node5526: -> 2.6.1.45 | -Ser, +HPR {br=BR47394, ev=cof+eq} || node5540: <- 1.4.3.3 | -O2, -H2O, +H2O2, +NH3 {br=BR40536, ev=cof+eq} || node5534: <- 1.4.2.1 | -2*ferricytochrome_c, -H2O, +2*H, +2*ferrocytochrome_c, +NH3 {br=BR36872, ev=cof+eq}]- Gly  // alanine-glyoxylate transaminase; glycine transaminase; serine-glyoxylate transaminase; D-amino-acid oxidase; glycine dehydrogenase (cytochrome)
    -R[node12356: 1.21.4.2 | -Pi, -thioredoxin, +H2O, +NH3, +thioredoxin_disulfide {br=BR47373, ev=cof-eq}]-> acetyl_phosphate  // glycine reductase
    -[node12349: 2.7.2.1 | ADP>ATP ^L {br=BR47820, ev=cof-eq}]-> acetate;  // acetate kinase

  Gly
    -[node5124: 2.1.4.1 | -Arg, +Orn ^R {br=BR43955, ev=cof+eq}]-> Guanidinoacetate  // glycine amidinotransferase
    -R[node5120: 2.1.1.2 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine, +H {br=BR43886, ev=cof+eq}]-> Creatine;  // guanidinoacetate N-methyltransferase

  Gly
    -B[node5416: 2.1.2.1 | -5_10_methylenetetrahydrofolate, -H2O, +6S_THFA {br=BR40573, ev=cof+eq}]-> Ser;  // glycine hydroxymethyltransferase

  (CO2 + NH4) -[node5131: 1.4.1.27 | NADH>NAD, -5_10_methylenetetrahydrofolate, +6S_THFA {br=BR53167, ev=cof-eq}]-> Gly;  // glycine cleavage system
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { Gly glyoxylate } forward { node5253 node5540 node5534 } backward { node5531 node5526 };
