pwl 2.0;
subsystem alanine-metabolism 'alanine metabolism' {
  // BRENDA subsystem: 38 reactions (35 with direction), 37 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 3_APA '3-APA' brenda:5485 kegg:C05665;
  compound 3_Hydroxypropanoyl_CoA '3-Hydroxypropanoyl-CoA' brenda:30964 kegg:C05668;
  compound 3_Hydroxypropionate '3-Hydroxypropionate' brenda:1632 kegg:C01013;
  compound 3_methyl_2_oxobutanoate '3-methyl-2-oxobutanoate' brenda:829 kegg:C00141;
  compound 3_ureidopropionate '3-ureidopropionate' brenda:43370 kegg:C02642;
  compound 4_Methylthio_2_oxobutanoate '4-Methylthio-2-oxobutanoate' brenda:4211 kegg:C01180;
  compound 4_aminobutanal '4-aminobutanal' brenda:3440 kegg:C00555;
  compound 4_aminobutanoate '4-aminobutanoate' brenda:597 kegg:C00334;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound Ala brenda:103 kegg:C00041;
  compound Asp brenda:97 kegg:C00049;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Cys brenda:74 kegg:C00097;
  compound D_Ala 'D-Ala' brenda:164 kegg:C00133;
  compound D_Asp 'D-Asp' brenda:634 kegg:C00402;
  compound D_Glu 'D-Glu' brenda:344 kegg:C00217;
  compound D_Met 'D-Met' brenda:957 kegg:C00855;
  compound D_lactate 'D-lactate' brenda:600 kegg:C00256;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound H2O2_L22 'H2O2' brenda:22 kegg:C00027;
  compound L_alanyl_tRNAAla 'L-alanyl-tRNAAla' brenda:8121 kegg:C00886;
  compound L_malate 'L-malate' brenda:200 brenda:247;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound R_lactoyl_CoA '(R)-lactoyl-CoA' brenda:52057 kegg:C00827;
  compound Ura brenda:334 kegg:C00106;
  compound Val brenda:246 kegg:C00183;
  compound a_quinol 'a quinol' brenda:2695;
  compound a_quinone 'a quinone' brenda:1992;
  compound acceptor brenda:66 brenda:3161;
  compound acetate brenda:47 kegg:C00033;
  compound acryloyl_CoA 'acryloyl-CoA' brenda:2191 kegg:C00894;
  compound beta_Ala 'beta-Ala' brenda:494 kegg:C00099;
  compound dihydrouracil brenda:2336 kegg:C00429;
  compound enzyme_S_sulfanylcysteine '[enzyme]-S-sulfanylcysteine' brenda:33030 brenda:84978 kegg:C15812;
  compound enzyme_cysteine '[enzyme]-cysteine' brenda:33029 kegg:C15811;
  compound malonate_semialdehyde 'malonate semialdehyde' brenda:2969 kegg:C00222;
  compound oxaloacetate brenda:57 kegg:C00036;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound oxidized_electron_transferring_flavoprotein 'oxidized electron-transferring flavoprotein' brenda:99538;
  compound propane_1_3_diamine 'propane-1,3-diamine' brenda:721 kegg:C00986;
  compound propanoate brenda:949 kegg:C00163;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound reduced_electron_transferring_flavoprotein 'reduced electron-transferring flavoprotein' brenda:1892 brenda:3252 kegg:C04570;
  compound spermidine brenda:148 kegg:C00315;
  compound spermine brenda:197 kegg:C00750;
  compound tRNAAla brenda:2503 kegg:C01635;
  port Ala side R to biotin-biosynthesis;
  port Ala side U to selenocysteine-biosynthesis;
  port Ala side U to serine-metabolism;
  port Asp side U to histidine-metabolism;
  port Cys side U to cysteine-metabolism;
  port L_malate side L to citric-acid-cycle;
  port NH3 side D to nitrate-assimilation;
  port oxaloacetate side L to aspartate-and-asparagine-metabolism;
  port propanoate#2 side R to threonine-metabolism;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    pyruvate#2
      <-L[node5303: 2.6.1.41 | -4_Methylthio_2_oxobutanoate, +D_Met ^L {br=BR47395, ev=cof-eq}]- Ala  // D-methionine-pyruvate transaminase
      -R[node5310: 4.1.1.12 | -CO2, +H ^L {br=BR273, ev=cof-eq}]-> Asp  // aspartate 4-decarboxylase
      -R[node5307: 4.1.1.11 | -H, +CO2 {br=BR272, ev=cof+eq}]-> beta_Ala  // aspartate 1-decarboxylase
      -[node5296: 2.6.1.19 | 2OG>Glu]- malonate_semialdehyde;  // 4-aminobutyrate-2-oxoglutarate transaminase
    (Ala + malonate_semialdehyde) -[node5297: 2.6.1.18 {br=BR47385, ev=eq, match=kegg}]-> (pyruvate#2 + beta_Ala);  // beta-alanine-pyruvate transaminase
  }

  // ring: cycle of the drawing (6 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    propane_1_3_diamine
      -R[node5088: 1.4.3.22 | -H2O, -O2, +H, +NH3, +H2O2 {br=BS259126, ev=cof+eq}]-> 3_APA#2  // diamine oxidase
      -[node5081: 1.2.1.3 | NADP>NADPH, -H2O {br=BS371812, ev=cof+eq, match=single}]-> beta_Ala  // aldehyde dehydrogenase (NAD+)
      <-L[node5732: 1.2.1.3 | NADP>NADPH, -H2O {br=BS371812, ev=cof+eq, match=single}]- 3_APA;  // aldehyde dehydrogenase (NAD+)
    spermidine -[node5076: 1.5.99.6 | oxidized_electron_acceptor>reduced_electron_acceptor, -H2O {br=BR36917, ev=cof+eq}]-> (4_aminobutanal + propane_1_3_diamine);  // spermidine dehydrogenase
    spermine -[node5727: 1.5.3.16 | -H2O, -O2, +H2O2_L22 {br=BR48997, ev=cof+eq}]-> (spermidine + 3_APA);  // spermine oxidase
  }

  pyruvate#2
    -L[node5102: 1.4.5.1 | -H2O, -a_quinone, +a_quinol, +NH3 || node5304: <- 2.6.1.21 | -2OG, +D_Glu {br=BR47398, ev=cof+eq}]- D_Ala  // D-amino acid dehydrogenase (quinone); D-amino-acid transaminase
    <-[node5311: 5.1.1.1 {br=BR162, ev=eq, rev=eq}]-> Ala  // Alanine racemase
    -L[node5697: 1.4.1.1 | NAD>NADH, -H2O, +NH3, +H {br=BR33794, ev=cof+eq}]-> pyruvate  // alanine dehydrogenase
    -L[node2872: <- 1.1.99.6 | acceptor>reduced_acceptor {br=BR29379, ev=cof+eq} || node5098: -> 1.1.1.28 | NADH>NAD {br=BR29291, ev=cof-eq}]- D_lactate  // D-lactate dehydrogenase (acceptor); D-lactate dehydrogenase
    -L[node2891: 2.8.3.1 | -propanoyl_CoA, +propanoate ^R {br=BS360569, ev=cof+eq}]-> R_lactoyl_CoA  // propionate CoA-transferase
    -[node2889: 4.2.1.54 | +H2O ^R {br=BR3400, ev=cof+eq}]-> acryloyl_CoA  // lactoyl-CoA dehydratase
    -[node2888: 1.3.1.95 | NADH>NAD ^R {br=BR50238, ev=cof-eq}]-> propanoyl_CoA  // acrylyl-CoA reductase (NADH)
    -[node2887: 2.8.3.1 | -acetate, +Ac_CoA ^R {br=BR48124, ev=cof-eq}]-> propanoate;  // propionate CoA-transferase

  Asp
    <-L[node5460: 5.1.1.13 {br=BR166, ev=eq, rev=eq}]-> D_Asp  // Aspartate racemase
    -L[node5462: 1.4.3.1 | -O2, -H2O, +NH3, +H2O2 {br=BR36873, ev=cof+eq}]-> oxaloacetate  // D-aspartate oxidase
    -L[node5741: 1.1.1.37 | NADH>NAD ^L {br=BR29300, ev=cof-eq}]-> L_malate;  // malate dehydrogenase

  Cys
    -[node5106: 2.8.1.7 | -enzyme_cysteine, +enzyme_S_sulfanylcysteine {br=BR49765, ev=cof+eq}]-> Ala;  // cysteine desulfurase

  Ura
    -R[node5714: 1.3.1.2 | NADPH>NADP ^R {br=BR33762, ev=cof-eq, match=kegg}]-> dihydrouracil  // dihydropyrimidine dehydrogenase (NADP+)
    -[node5718: 3.5.2.2 | -H2O, +H ^R {br=BR22718, ev=cof+eq, match=kegg}]-> 3_ureidopropionate  // dihydropyrimidinase
    -[node5722: 3.5.1.6 | -H2O, -H, +CO2, +NH3 {br=BR19250, ev=cof+eq, match=kegg}]-> beta_Ala;  // beta-ureidopropionase

  propanoate#2
    -[node5070: 6.2.1.17 | ATP>AMP, -CoA, +PPi {br=BR68, ev=cof+eq}]-> propanoyl_CoA#2  // Propionate-CoA ligase
    -[node5064: 1.3.8.1 | oxidized_electron_transferring_flavoprotein>reduced_electron_transferring_flavoprotein, -H {br=BS370161, ev=cof-eq}]-> acryloyl_CoA#2  // short-chain acyl-CoA dehydrogenase
    -[node5059: 4.2.1.17 | -H2O ^L {br=BR49125, ev=cof-eq}]-> 3_Hydroxypropanoyl_CoA  // enoyl-CoA hydratase
    -[node5056: 3.1.2.4 | -H2O, +CoA ^L]- 3_Hydroxypropionate  // 3-hydroxyisobutyryl-CoA hydrolase
    -B[node5052: 1.1.1.59 | NAD>NADH ^R {br=BR29322, ev=cof+eq, match=kegg}]-> malonate_semialdehyde;  // 3-hydroxypropionate dehydrogenase

  3_methyl_2_oxobutanoate
    -R[node5109: 2.6.1.42 | Glu>2OG ^L {br=BS356553, ev=cof-eq}]-> Val;  // branched-chain-amino-acid transaminase

  Glu
    -[node5094: 1.4.1.2 | NAD>NADH, -H2O, +2OG {br=BR36868, ev=cof+eq}]-> NH3;  // glutamate dehydrogenase

  4_aminobutanal
    -[node2691: 1.2.1.19 | NAD>NADH, -H2O, +H {br=BR29390, ev=cof+eq}]-> 4_aminobutanoate;  // aminobutyraldehyde dehydrogenase

  (Val + pyruvate) -[node5112: 2.6.1.66 | +3_methyl_2_oxobutanoate {br=BR47703, ev=cof+eq}]-> Ala;  // valine-pyruvate transaminase
  (Ala + tRNAAla) -[node10956: 6.1.1.7 | ATP>AMP, +PPi {br=BR58, ev=cof+eq}]-> L_alanyl_tRNAAla;  // Alanine-tRNA ligase
  Ala -[node5322: 2.6.1.2 | -2OG {br=BR47397, ev=cof+eq}]-> (pyruvate + Glu);  // alanine transaminase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { Ala D_Ala pyruvate };
  motif substrate_cycle { D_lactate pyruvate } forward { node2872 } backward { node5098 };
  motif substrate_cycle { acryloyl_CoA propanoyl_CoA } forward { node2888 } backward { node5064 };
  motif substrate_cycle { propanoate propanoyl_CoA } forward { node5070 } backward { node2887 };
  motif shunt { malonate_semialdehyde beta_Ala } bypasses { malonate_semialdehyde pyruvate Ala beta_Ala };
  motif shunt { spermine 3_APA } bypasses { spermine spermidine propane_1_3_diamine 3_APA };
  motif carrier { 2OG Glu } forward { node5296 } backward { node5109 };
  motif carrier { NAD NADH } forward { node2691 node5052 node5094 node5697 } backward { node2888 node5098 node5741 };
  motif carrier { NADP NADPH } forward { node5081 node5732 } backward { node5714 };
}
