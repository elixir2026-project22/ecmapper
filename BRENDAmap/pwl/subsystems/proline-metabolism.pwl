pwl 2.0;
subsystem proline-metabolism 'proline metabolism' {
  // BRENDA subsystem: 16 reactions (13 with direction), 13 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1_pyrroline_2_carboxylate '1-pyrroline-2-carboxylate' brenda:177473 kegg:C03564;
  compound 2OG brenda:34 kegg:C00026;
  compound 5_amino_2_oxopentanoate '5-amino-2-oxopentanoate' brenda:8022 kegg:C01110;
  compound 5_aminopentanoate '5-aminopentanoate' brenda:2715 kegg:C00431;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound D_Pro 'D-Pro' brenda:921 kegg:C00763;
  compound FAD brenda:20 kegg:C00016;
  compound FADH2 brenda:256 kegg:C01352;
  compound Glu brenda:41 kegg:C00025;
  compound Glu_5_semialdehyde 'Glu 5-semialdehyde' brenda:9197 kegg:C01165;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_glutamyl_5_phosphate 'L-glutamyl 5-phosphate' brenda:31670 kegg:C03287;
  compound L_prolyl_tRNAPro 'L-prolyl-tRNAPro' brenda:44330 kegg:C02702;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound Orn brenda:192 kegg:C00077;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound Pro brenda:243 kegg:C00148;
  compound acceptor brenda:66 brenda:3161;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound pyrroline_5_carboxylate 'pyrroline-5-carboxylate' brenda:3430 kegg:C03912;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound tRNAPro brenda:2671 kegg:C01649;
  port Glu side L to glutamate-and-glutamine-metabolism;
  port Glu_5_semialdehyde side U to arginine-metabolism;
  port Orn side R to urea-cycle;
  port Pro side D to fumitremorgin-biosynthesis;
  port Pro side L to 5R-carbapenem-carboxylate-biosynthesis;
  port Pro side R to ornithine-metabolism;
  port Pro side U to arginine-metabolism;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    Glu_5_semialdehyde
      -B[node5805: ~? | +H2O ^L {br=BR52883, ev=cof+eq}]-> pyrroline_5_carboxylate  // spontaneous reaction
      -L[node5826: 1.2.1.88 | NAD>NADH, -H2O, +H]- Glu#2;  // L-glutamate gamma-semialdehyde dehydrogenase
    Orn -[node4989: 2.6.1.13 | -2OG {br=BS380017, ev=cof+eq, match=single}]-> (Glu_5_semialdehyde + Glu#2);  // ornithine aminotransferase
    chord Glu_5_semialdehyde -B[node5812: 1.2.1.88 | NAD>NADH, -H2O, +H {br=BR36889, ev=cof+eq}]-> Glu#2;  // L-glutamate gamma-semialdehyde dehydrogenase
  }

  pyrroline_5_carboxylate
    -L[node5808: -> 1.5.1.2 | NADPH>NADP {br=BR36895, ev=cof-eq} || node5823: 1.5.5.2 | FAD>FADH2 || node2307: <- 1.5.99.B2 | acceptor>reduced_acceptor {br=BR51015, ev=cof+eq}]- Pro  // pyrroline-5-carboxylate reductase; proline dehydrogenase; proline dehydrogenase (acceptor)
    -[node11564: -> 1.5.1.49 | NADP>NADPH {br=BR36888, ev=cof+eq} || node5820: <- 1.5.1.1 | NADPH>NADP {br=BR36888, ev=cof-eq}]- 1_pyrroline_2_carboxylate  // 1-pyrroline-2-carboxylate reductase [NAD(P)H]; 1-piperideine-2-carboxylate/1-pyrroline-2-carboxylate reductase [NAD(P)H]
    -R[node5819: ~?]- 5_amino_2_oxopentanoate;  // spontaneous reaction

  Pro
    <-[node5845: 5.1.1.4 {br=BR172, ev=eq, rev=eq}]-> D_Pro  // Proline racemase
    -[node2387: 1.21.4.1 | NADH>NAD ^R {br=BS370299, ev=cof+eq}]-> 5_aminopentanoate;  // D-proline reductase

  D_Pro
    -B[node10848: 1.5.99.13 | -oxidized_electron_acceptor, +reduced_acceptor {br=BR49168, ev=cof+eq}]-> 1_pyrroline_2_carboxylate;  // D-proline dehydrogenase

  Glu
    -[node5797: 2.7.2.11 | ATP>ADP ^L {br=BR47821, ev=cof+eq, match=kegg}]-> L_glutamyl_5_phosphate  // glutamate 5-kinase
    -B[node5800: 1.2.1.41 | NADPH>NADP, +Pi {br=BR36782, ev=cof+eq}]-> Glu_5_semialdehyde;  // glutamate-5-semialdehyde dehydrogenase

  (Pro + tRNAPro) -[node11031: 6.1.1.15 | ATP>AMP, +PPi {br=BR45, ev=cof+eq}]-> L_prolyl_tRNAPro;  // Proline-tRNA ligase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { 1_pyrroline_2_carboxylate Pro D_Pro };
  motif cycle { Glu L_glutamyl_5_phosphate Glu_5_semialdehyde };
  motif substrate_cycle { 1_pyrroline_2_carboxylate Pro } forward { node5820 } backward { node11564 };
  motif substrate_cycle { Pro pyrroline_5_carboxylate } forward { node2307 } backward { node5808 };
  motif shunt { Orn Glu_5_semialdehyde } bypasses { Orn Glu L_glutamyl_5_phosphate Glu_5_semialdehyde };
  motif carrier { NAD NADH } forward { node5812 node5826 } backward { node2387 };
  motif carrier { NADP NADPH } forward { node11564 } backward { node5800 node5808 node5820 };
}
