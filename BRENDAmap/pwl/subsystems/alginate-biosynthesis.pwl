pwl 2.0;
subsystem alginate-biosynthesis 'alginate biosynthesis' {
  // BRENDA subsystem: 3 reactions (3 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1_4_beta_D_mannuronosyl_n '[(1->4)-beta-D-mannuronosyl]n' brenda:202712;
  compound GDP brenda:53 kegg:C00035;
  compound GDP_Man 'GDP-Man' brenda:3633 kegg:C00096;
  compound GDP_ManA 'GDP-ManA' brenda:103884;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound alginate_alpha_L_guluronate '[alginate]-alpha-L-guluronate' brenda:205992;
  compound mannuronan_beta_D_mannuronate '[mannuronan]-beta-D-mannuronate' brenda:205993;
  port GDP_Man side R to d-mannose-degradation;

  GDP_Man
    -[node8739: 1.1.1.132 | 2*NAD>2*NADH, -H2O, +2*H {br=BR29199, ev=cof+eq}]-> GDP_ManA  // GDP-mannose 6-dehydrogenase
    -R[node8737: 2.4.1.33 | -1_4_beta_D_mannuronosyl_n, +GDP ^R {br=BR44214, ev=cof+eq, match=single}]-> mannuronan_beta_D_mannuronate  // mannuronan synthase
    -R[node2124: 5.1.3.37 {br=BR51540, ev=eq}]-> alginate_alpha_L_guluronate;  // mannuronan 5-epimerase
}
