pwl 2.0;
subsystem heme-metabolism 'heme metabolism' {
  // BRENDA subsystem: 23 reactions (22 with direction), 20 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 12_18_didecarboxysiroheme '12,18-didecarboxysiroheme' brenda:195017 kegg:C21835;
  compound 5_aminolevulinate '5-aminolevulinate' brenda:43523 kegg:C00430;
  compound 5_deoxyadenosine '5\'-deoxyadenosine' brenda:943 kegg:C05198;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CO brenda:3261 kegg:C00237;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Fe2 'Fe2+' brenda:25 kegg:C14818;
  compound Fe_coproporphyrin_III 'Fe-coproporphyrin III' brenda:199180 kegg:C21284;
  compound Glu brenda:41 kegg:C00025;
  compound Glu_1_semialdehyde 'Glu 1-semialdehyde' brenda:55894;
  compound Gly brenda:72 kegg:C00037;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound L_glutamyl_tRNAGlu 'L-glutamyl-tRNAGlu' brenda:6545 kegg:C02987;
  compound Met brenda:88 kegg:C00073;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound acetate brenda:47 kegg:C00033;
  compound bilirubin brenda:599 kegg:C00486;
  compound biliverdin brenda:1713 kegg:C00500;
  compound coproporphyrinogen_III 'coproporphyrinogen III' brenda:4234 kegg:C03263;
  compound hydroxymethylbilane brenda:2845 kegg:C01024;
  compound menaquinol brenda:3003 kegg:C05819;
  compound menaquinone brenda:2295 kegg:C00828;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound porphobilinogen brenda:1763 kegg:C00931;
  compound precorrin_1 'precorrin-1' brenda:72196 kegg:C15527;
  compound precorrin_2 'precorrin-2' brenda:6581 kegg:C02463;
  compound protoheme brenda:3360 kegg:C00032;
  compound protoporphyrin_IX 'protoporphyrin IX' brenda:868 kegg:C02191;
  compound protoporphyrinogen_IX 'protoporphyrinogen IX' brenda:1119 kegg:C01079;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound siroheme brenda:1288 kegg:C00748;
  compound sirohydrochlorin brenda:5216 kegg:C05778;
  compound succinyl_CoA 'succinyl-CoA' brenda:224 kegg:C00091;
  compound tRNAGlu brenda:1988 kegg:C01641;
  compound uroporphyrinogen_III 'uroporphyrinogen-III' brenda:2363 kegg:C01051;
  port precorrin_2 side R to vitamin-B12-metabolism;
  port protoporphyrin_IX side L to chlorophyll-metabolism;

  // ring: cycle of the drawing (11 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    uroporphyrinogen_III
      -[node6538: 2.1.1.107 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine, +H {br=BR43866, ev=cof+eq}]-> precorrin_1  // uroporphyrinogen-III C-methyltransferase
      -[node6534: 2.1.1.107 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR49530, ev=cof+eq}]-> precorrin_2  // uroporphyrinogen-III C-methyltransferase
      -[node6933: 1.3.1.76 | NAD>NADH, +H ^R {br=BR47985, ev=cof+eq}]-> sirohydrochlorin  // precorrin-2 dehydrogenase
      -B[node6932: 4.99.1.4 | -Fe2, +2*H ^R {br=BR48009, ev=cof-eq}]-> siroheme  // sirohydrochlorin ferrochelatase
      -[node2240: 4.1.1.111 | -H, +2*CO2 ^R {br=BR51140, ev=cof+eq}]-> 12_18_didecarboxysiroheme  // siroheme decarboxylase
      -L[node2238: 4.1.3.- | reduced_electron_acceptor>oxidized_electron_acceptor, -S_adenosyl_L_methionine, +acetate, +Met, +H, +5_deoxyadenosine]- Fe_coproporphyrin_III  // Fe-coproporphyrin synthase
      -[node1473: 1.3.98.5 | -2*H2O2, +2*CO2, +4*H2O {br=BR52578, ev=cof+eq} || node2236: 1.3.98.6 | -2*S_adenosyl_L_methionine, +2*5_deoxyadenosine, +2*Met, +2*CO2 {br=BR52577, ev=cof+eq}]-> protoheme  // hydrogen peroxide-dependent heme synthase; AdoMet-dependent heme synthase
      -R[node4225: 4.98.1.1 | -2*H, +Fe2 ^L {br=BR3454, ev=cof+eq, match=kegg}]-> protoporphyrin_IX  // protoporphyrin ferrochelatase
      <-R[node4219: 1.3.3.4 | -3*O2, +H, +3*H2O2 {br=BR36840, ev=cof+eq} || node2223: 1.3.5.3 | -menaquinone, +menaquinol {br=BR49166, ev=eq}]- protoporphyrinogen_IX  // protoporphyrinogen oxidase; protoporphyrinogen IX dehydrogenase (quinone)
      <-[node4217: 1.3.98.3 | -2*S_adenosyl_L_methionine, +2*5_deoxyadenosine, +2*CO2, +2*Met {br=BR48612, ev=cof+eq} || node4213: 1.3.3.3 | -2*H, -O2, +2*CO2, +2*H2O {br=BR36839, ev=cof+eq}]- coproporphyrinogen_III  // coproporphyrinogen dehydrogenase; coproporphyrinogen oxidase
      <-[node4212: 4.1.1.37 | -H, +4*CO2 ^L {br=BR296, ev=cof+eq}]- uroporphyrinogen_III;  // Uroporphyrinogen decarboxylase
  }

  protoheme
    -[node3186: 1.14.14.18 | reduced_electron_acceptor>oxidized_electron_acceptor, -3*O2, +3*H2O, +CO, +Fe2 {br=BR40384, ev=cof+eq}]-> biliverdin  // heme oxygenase (biliverdin-producing)
    -[node3194: 1.3.1.24 | NADPH>NADP ^R {br=BR40361, ev=cof-eq}]-> bilirubin;  // biliverdin reductase

  Glu
    <-[node6473: 6.1.1.17 | ATP>AMP, -H, -tRNAGlu, +PPi {br=BR47443, ev=eq}]- L_glutamyl_tRNAGlu  // Glutamate-tRNA ligase
    -[node6470: 1.2.1.70 | NADPH>NADP, +tRNAGlu {br=BR48497, ev=cof-eq}]-> Glu_1_semialdehyde  // glutamyl-tRNA reductase
    -[node6467: 5.4.3.8 {br=BR32, ev=eq}]-> 5_aminolevulinate  // glutamate-1-semialdehyde 2,1-aminomutase
    -R[node6474: 4.2.1.24 | +H, +2*H2O ^R {br=BR22826, ev=cof+eq}]-> porphobilinogen  // porphobilinogen synthase
    -R[node4221: 2.5.1.61 | -H2O, +4*NH3 ^R {br=BR44288, ev=cof+eq}]-> hydroxymethylbilane  // hydroxymethylbilane synthase
    -[node6468: 4.2.1.75 | +H2O ^L {br=BR452, ev=cof+eq}]-> uroporphyrinogen_III;  // uroporphyrinogen-III synthase

  Gly
    -B[node3418: 2.3.1.37 | succinyl_CoA>CoA, -H, +CO2 {br=BR44037, ev=cof+eq}]-> 5_aminolevulinate;  // 5-aminolevulinate synthase
}
