pwl 2.0;
subsystem CMP-KDO-biosynthesis 'CMP-KDO biosynthesis' {
  // BRENDA subsystem: 6 reactions (4 with direction), 8 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 2_dehydro_3_deoxy_D_octonate_8_phosphate '2-dehydro-3-deoxy-D-octonate 8-phosphate' brenda:16184 kegg:C04478;
  compound 3_8_dideoxy_8_oxo_alpha_D_manno_octulosonate '3,8-dideoxy-8-oxo-alpha-D-manno-octulosonate' brenda:201108;
  compound 3_deoxy_D_manno_octulosonate '3-deoxy-D-manno-octulosonate' brenda:2708 kegg:C01187;
  compound 3_deoxy_alpha_D_manno_octulopyranosonate '3-deoxy-alpha-D-manno-octulopyranosonate' brenda:201107;
  compound 8_amino_3_8_dideoxy_alpha_D_manno_octulosonate '8-amino-3,8-dideoxy-alpha-D-manno-octulosonate' brenda:202592;
  compound Ara_5_P 'Ara 5-P' brenda:538 kegg:C01112;
  compound CMP_alpha_Kdo 'CMP-alpha-Kdo' brenda:8231 kegg:C04121;
  compound CTP brenda:60 kegg:C00063;
  compound D_Rul_5_P 'D-Rul 5-P' brenda:443 kegg:C00199;
  compound Glu brenda:41 kegg:C00025;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2_L22 'H2O2' brenda:22 kegg:C00027;
  compound O2 brenda:9 brenda:1180;
  compound PEP brenda:51 kegg:C00074;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  port CMP_alpha_Kdo side L to lipid-A-biosynthesis;
  port D_Rul_5_P side U to degradation-of-pentoses;

  3_deoxy_D_manno_octulosonate
    -L[node9641: 2.7.7.38 | -CTP, +PPi {br=BR48080, ev=cof+eq}]-> CMP_alpha_Kdo;  // 3-deoxy-manno-octulosonate cytidylyltransferase

  3_deoxy_alpha_D_manno_octulopyranosonate
    -L[node2017: 1.1.3.48 | -O2, +H2O2_L22 ^L {br=BR51341, ev=cof+eq}]-> 3_8_dideoxy_8_oxo_alpha_D_manno_octulosonate  // 3-deoxy-alpha-D-manno-octulosonate 8-oxidase
    -[node2015: 2.6.1.109 | +Glu, +2OG ^L {br=BR51410, ev=conflict, match=single}]- 8_amino_3_8_dideoxy_alpha_D_manno_octulosonate;  // 8-amino-3,8-dideoxy-alpha-D-manno-octulosonate transaminase

  Ara_5_P
    -R[node9640: 2.5.1.55 | -PEP, -H2O, +Pi {br=BR47464, ev=cof+eq, match=kegg}]-> 2_dehydro_3_deoxy_D_octonate_8_phosphate;  // 3-deoxy-8-phosphooctulonate synthase

  Ara_5_P
    -L[node10080: 5.3.1.13 {br=BR222, ev=eq}]-> D_Rul_5_P;  // Arabinose-5-phosphate isomerase

  react [node9645: 3.1.3.45 | -H2O, +Pi] {3_deoxy_D_manno_octulosonate, 2_dehydro_3_deoxy_D_octonate_8_phosphate, 3_deoxy_alpha_D_manno_octulopyranosonate};  // 3-deoxy-manno-octulosonate-8-phosphatase
}
