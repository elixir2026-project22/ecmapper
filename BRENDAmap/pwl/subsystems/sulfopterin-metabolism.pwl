pwl 2.0;
subsystem sulfopterin-metabolism 'sulfopterin metabolism' {
  // BRENDA subsystem: 7 reactions (1 with direction), 8 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_5_diamino_6_5_triphosphoryl_3_4_trihydroxy_2_oxopentyl_amino_4_oxopyrimidine '2,5-diamino-6-(5\'-triphosphoryl-3\',4\'-trihydroxy-2\'-oxopentyl)-amino-4-oxopyrimidine' brenda:182183 kegg:C06148;
