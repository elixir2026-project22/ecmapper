    -B[node9143: 3.5.4.16]- H2NTP  // GTP cyclohydrolase I
    -[node10365: 4.2.3.12 | +PPPi ^L {br=BR48350, ev=cof+eq, match=single}]-> 6_Pyruvoyltetrahydropterin;  // 6-pyruvoyltetrahydropterin synthase

  H2NTP
    -[node9144: 3.1.3.1 | -H2O, +Pi ^L]- NPR  // alkaline phosphatase
