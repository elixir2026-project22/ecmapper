  compound 6_Pyruvoyltetrahydropterin '6-Pyruvoyltetrahydropterin' brenda:6471 kegg:C03684;
  compound GTP brenda:37 kegg:C00044;
  compound H2NTP brenda:4130;
  compound H2O brenda:1 kegg:C00001;
  compound NPR brenda:3544 kegg:C04874;
  compound PPPi brenda:940 kegg:C00536;
