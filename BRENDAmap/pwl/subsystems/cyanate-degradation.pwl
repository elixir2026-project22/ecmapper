pwl 2.0;
subsystem cyanate-degradation 'cyanate degradation' {
  // BRENDA subsystem: 3 reactions (2 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound HCO3 brenda:195 kegg:C00288;
  compound NH3 brenda:27;
  compound carbamate brenda:3992 kegg:C01563;
  compound cyanate brenda:1376 kegg:C01417;

  cyanate
    -[node7023: 4.2.1.104 | -HCO3, -H, +CO2 {br=BR48801, ev=cof+eq}]-> carbamate  // cyanase
    -[node7021: 4.2.1.104 | -H, +NH3 ^L {br=BR48802, ev=cof+eq}]-> CO2  // cyanase
    -B[node7019: 4.2.1.1 | -H2O ^R]- HCO3;  // carbonic anhydrase
}
