pwl 2.0;
subsystem carotenoid-biosynthesis 'carotenoid biosynthesis' {
  // BRENDA subsystem: 25 reactions (24 with direction), 24 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 15_9_dicis_phytofluene '15,9\'-dicis-phytofluene' brenda:28122 kegg:C19765;
  compound 15_cis_phytoene '15-cis-phytoene' brenda:2061 kegg:C05421;
  compound 7_9_9_tricis_neurosporene '7,9,9\'-tricis-neurosporene' brenda:7825 kegg:C19759;
  compound 9_15_9_tricis_zeta_carotene '9,15,9\'-tricis-zeta-carotene' brenda:5443 kegg:C19764;
  compound 9_9_dicis_zeta_carotene '9,9\'-dicis-zeta-carotene' brenda:12006 kegg:C15857;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_ascorbate 'L-ascorbate' brenda:548 kegg:C00072;
  compound L_dehydroascorbate 'L-dehydroascorbate' brenda:8124 kegg:C05422;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound a_quinol 'a quinol' brenda:2695;
  compound a_quinone 'a quinone' brenda:1992;
  compound acceptor brenda:66 brenda:3161;
  compound all_trans_lycopene 'all-trans-lycopene' brenda:5062 kegg:C05432;
  compound alpha_carotene 'alpha-carotene' brenda:3878 kegg:C05433;
  compound antheraxanthin brenda:3283 kegg:C08579;
  compound bacterioruberin brenda:197907 kegg:C22349;
  compound beta_carotene 'beta-carotene' brenda:858 kegg:C02094;
  compound beta_cryptoxanthin 'beta-cryptoxanthin' brenda:3892 kegg:C08591;
  compound bisanhydrobacterioruberin brenda:197908 kegg:C22347;
  compound delta_carotene 'delta-carotene' brenda:166871 kegg:C08586;
  compound dihydrobisanhydrobacterioruberin brenda:197909 kegg:C22060;
  compound dihydroisopentenyldehydrorhodopin brenda:197910 kegg:C22058;
  compound dimethylallyl_PP 'dimethylallyl-PP' brenda:157;
  compound gamma_carotene 'gamma-carotene' brenda:8104 kegg:C05435;
  compound isopentenyldehydrorhodopin brenda:197912 kegg:C22059;
  compound lutein brenda:16796 kegg:C08601;
  compound monoanhydrobacterioruberin brenda:197924 kegg:C22348;
  compound oxidized_ferredoxin_Fe_S_cluster 'oxidized ferredoxin [Fe-S] cluster' brenda:202698 kegg:C00139;
  compound plastoquinol brenda:3663 kegg:C16693;
  compound plastoquinone brenda:3359 kegg:C02061;
  compound prephytoene_PP 'prephytoene-PP' brenda:9247 kegg:C03427;
  compound prolycopene brenda:10238 kegg:C15858;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound reduced_ferredoxin_Fe_S_cluster 'reduced ferredoxin [Fe-S] cluster' brenda:202701 kegg:C00138;
  compound violaxanthin brenda:3412 kegg:C08614;
  compound zeaxanthin brenda:1849 kegg:C06098;
  compound zeinoxanthin brenda:41764 kegg:C08590;
  port prephytoene_PP side R to isoprenoid-biosynthesis;

  prephytoene_PP
    -R[node2828: 2.5.1.32 | +PPi ^L {br=BR48482, ev=cof+eq}]-> 15_cis_phytoene  // 15-cis-phytoene synthase
    -[node2827: 1.3.5.5 | -plastoquinone, +plastoquinol ^L {br=BR49667, ev=cof+eq}]-> 15_9_dicis_phytofluene  // 15-cis-phytoene desaturase
    -L[node2826: 1.3.5.5 | -plastoquinone, +plastoquinol ^L {br=BR49668, ev=cof+eq}]-> 9_15_9_tricis_zeta_carotene  // 15-cis-phytoene desaturase
    -L[node2825: 5.2.1.12 {br=BR49728, ev=eq}]-> 9_9_dicis_zeta_carotene  // zeta-carotene isomerase
    -R[node2824: 1.3.5.6 | -a_quinone, +a_quinol ^R {br=BR49638, ev=cof+eq}]-> 7_9_9_tricis_neurosporene  // 9,9'-dicis-zeta-carotene desaturase
    -R[node2823: 1.3.5.6 | -a_quinone, +a_quinol ^R {br=BR49639, ev=cof+eq}]-> prolycopene  // 9,9'-dicis-zeta-carotene desaturase
    -L[node2822: 5.2.1.13 {br=BR49729, ev=eq}]-> all_trans_lycopene  // prolycopene isomerase
    -[node2805: 5.5.1.19 {br=BS417227, ev=eq}]-> gamma_carotene  // lycopene beta-cyclase
    -[node2804: 5.5.1.19 {br=BS427448, ev=eq}]-> beta_carotene  // lycopene beta-cyclase
    -[node2803: 1.14.15.24 | NADH>NAD, -O2, -H, +H2O {br=BR49602, ev=cof+eq}]-> beta_cryptoxanthin  // beta-carotene 3-hydroxylase
    -[node2802: 1.14.15.24 | NADH>NAD, -O2, -H, +H2O {br=BR49603, ev=cof+eq}]-> zeaxanthin  // beta-carotene 3-hydroxylase
    -[node2798: -> 1.14.15.21 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +H2O {br=BR48604, ev=cof+eq} || node2797: <- 1.23.5.1 | -L_ascorbate, +H2O, +L_dehydroascorbate {br=BR48597, ev=cof+eq}]- antheraxanthin  // zeaxanthin epoxidase; violaxanthin de-epoxidase
    -[node2795: -> 1.14.15.21 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +H2O {br=BR48605, ev=cof+eq} || node2794: <- 1.23.5.1 | -L_ascorbate, +H2O, +L_dehydroascorbate {br=BR48596, ev=cof+eq}]- violaxanthin;  // zeaxanthin epoxidase; violaxanthin de-epoxidase

  all_trans_lycopene
    -[node2814: 5.5.1.18 {br=BS415670, ev=eq}]-> delta_carotene  // lycopene epsilon-cyclase
    -[node2813: 5.5.1.19 {br=BS427424, ev=eq}]-> alpha_carotene  // lycopene beta-cyclase
    -[node2812: 1.14.99.- | NADPH>NADP, -O2, -H, +H2O]- zeinoxanthin  // beta-ring hydroxylase
    -[node2811: 1.14.14.158 | NADPH>NADP, -O2, -H, +H2O {br=BR52468, ev=cof+eq}]-> lutein;  // carotenoid epsilon hydroxylase

  all_trans_lycopene
    -R[node11409: 2.5.1.150 | -H2O, -dimethylallyl_PP, +PPi {br=BR52589, ev=cof+eq}]-> dihydroisopentenyldehydrorhodopin  // lycopene elongase/hydratase (dihydrobisanhydrobacterioruberin-forming)
    -L[node11411: 1.3.99.37 | acceptor>reduced_acceptor ^L {br=BR51282, ev=cof+eq}]-> isopentenyldehydrorhodopin  // 1-hydroxy-2-isopentenylcarotenoid 3,4-desaturase
    -[node11413: 2.5.1.150 | -H2O, -dimethylallyl_PP, +PPi ^L {br=BR52590, ev=cof+eq}]-> dihydrobisanhydrobacterioruberin  // lycopene elongase/hydratase (dihydrobisanhydrobacterioruberin-forming)
    -[node11415: 1.3.99.37 | acceptor>reduced_acceptor ^L {br=BR51283, ev=cof+eq}]-> bisanhydrobacterioruberin  // 1-hydroxy-2-isopentenylcarotenoid 3,4-desaturase
    -[node11417: 4.2.1.161 | -H2O ^L {br=BR51281, ev=cof-eq}]-> monoanhydrobacterioruberin  // bisanhydrobacterioruberin hydratase
    -[node11419: 4.2.1.161 | -H2O ^L {br=BR51280, ev=cof-eq}]-> bacterioruberin;  // bisanhydrobacterioruberin hydratase
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { antheraxanthin violaxanthin } forward { node2795 } backward { node2794 };
  motif substrate_cycle { antheraxanthin zeaxanthin } forward { node2797 } backward { node2798 };
}
