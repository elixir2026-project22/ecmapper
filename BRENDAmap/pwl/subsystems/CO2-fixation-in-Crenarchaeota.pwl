pwl 2.0;
subsystem CO2-fixation-in-Crenarchaeota 'CO2 fixation in Crenarchaeota' {
  // BRENDA subsystem: 20 reactions (17 with direction), 18 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 3_Hydroxypropanoyl_CoA '3-Hydroxypropanoyl-CoA' brenda:30964 kegg:C05668;
  compound 3_Hydroxypropionate '3-Hydroxypropionate' brenda:1632 kegg:C01013;
  compound 4_hydroxybutanoate '4-hydroxybutanoate' brenda:4210 kegg:C00989;
  compound 4_hydroxybutanoyl_CoA '4-hydroxybutanoyl-CoA' brenda:8018 kegg:C11062;
  compound 4_oxobutanoate '4-oxobutanoate' brenda:6454 kegg:C00232;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound HCO3 brenda:195 kegg:C00288;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound R_methylmalonyl_CoA '(R)-methylmalonyl-CoA' brenda:21229;
  compound S_3_OH_butanoyl_CoA '(S)-3-OH-butanoyl-CoA' brenda:7958;
  compound S_methylmalonyl_CoA '(S)-methylmalonyl-CoA' brenda:2455;
  compound acetate brenda:47 kegg:C00033;
  compound acetoacetyl_CoA 'acetoacetyl-CoA' brenda:187 kegg:C00332;
  compound acryloyl_CoA 'acryloyl-CoA' brenda:2191 kegg:C00894;
  compound crotonyl_CoA 'crotonyl-CoA' brenda:406 kegg:C00877;
  compound malonate_semialdehyde 'malonate semialdehyde' brenda:2969 kegg:C00222;
  compound malonyl_CoA 'malonyl-CoA' brenda:76 kegg:C00083;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  compound succinyl_CoA 'succinyl-CoA' brenda:224 kegg:C00091;
  port crotonyl_CoA side U to ethylmalonyl-CoA-pathway;

  // ring: cycle of the drawing (16 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    malonyl_CoA
      -L[node10126: 1.2.1.75 | NADPH>NADP, +CoA ^R {br=BR49113, ev=cof-eq}]-> malonate_semialdehyde  // malonyl-CoA reductase (malonate semialdehyde-forming)
      -[node10147: 1.1.1.298 | NADPH>NADP ^R {br=BR49111, ev=cof-eq, match=kegg}]-> 3_Hydroxypropionate  // 3-hydroxypropionate dehydrogenase (NADP+)
      -L[node10140: 6.2.1.36 | ATP>AMP, -CoA, +PPi {br=BR49558, ev=cof+eq, match=kegg}]-> 3_Hydroxypropanoyl_CoA  // 3-hydroxypropionyl-CoA synthase
      -[node10137: 4.2.1.116 | +H2O ^R {br=BR49125, ev=cof+eq}]-> acryloyl_CoA  // 3-hydroxypropionyl-CoA dehydratase
      -[node10131: 1.3.1.84 | NADPH>NADP ^R {br=BR49115, ev=cof-eq}]-> propanoyl_CoA;  // acrylyl-CoA reductase (NADPH)
    S_methylmalonyl_CoA
      -R[node9112: 5.1.99.1]- R_methylmalonyl_CoA  // Methylmalonyl-CoA epimerase
      -[node9198: 5.4.99.2 {br=BR249, ev=eq}]-> succinyl_CoA  // Methylmalonyl-CoA mutase
      -[node9138: 1.2.1.76 | NADPH>NADP, -H, +CoA {br=BR49114, ev=cof-eq, match=kegg}]-> 4_oxobutanoate  // succinate-semialdehyde dehydrogenase (acylating)
      -[node9122: 1.1.1.61 | NADH>NAD {br=BR29325, ev=cof-eq, match=kegg} || node2297: 1.1.1.B47 | NADPH>NADP {br=BR51069, ev=cof-eq, match=kegg}]-> 4_hydroxybutanoate  // 4-hydroxybutyrate dehydrogenase; succinate semialdehyde reductase (NADPH)
      -L[node9197: 6.2.1.40 | ATP>AMP, -CoA, +PPi {br=BR51010, ev=cof+eq} || node11232: 2.8.3.1 | -Ac_CoA, +acetate {br=BS425667, ev=cof+eq, match=kegg}]-> 4_hydroxybutanoyl_CoA  // 4-hydroxybutyrate-CoA ligase (AMP-forming); propionate CoA-transferase
      -[node9093: 4.2.1.120 | +H2O ^R {br=BR49128, ev=cof+eq, match=kegg}]-> crotonyl_CoA  // 4-hydroxybutanoyl-CoA dehydratase
      -[node9091: 4.2.1.55 | -H2O || node2299: 4.2.1.150 | -H2O]- S_3_OH_butanoyl_CoA  // 3-Hydroxybutyryl-CoA dehydratase; short-chain-enoyl-CoA hydratase
      -[node9133: <-> 1.1.1.36 | NAD>NADH {br=BS188053, ev=cof+eq, rev=eq, match=kegg} || node2298: -> 1.1.1.35 | NAD>NADH {br=BS188053, ev=cof+eq, match=kegg}]- acetoacetyl_CoA  // acetoacetyl-CoA reductase; 3-hydroxyacyl-CoA dehydrogenase
      -L[node9109: 2.3.1.9 | -CoA ^R {br=BR44092, ev=cof-eq}]-> Ac_CoA;  // acetyl-CoA C-acetyltransferase
    (Ac_CoA + HCO3#2) -[node10132: 6.4.1.2 | ATP>ADP, +Pi {br=BR6444, ev=cof+eq, match=kegg}]-> malonyl_CoA;  // acetyl-CoA carboxylase
    (HCO3 + propanoyl_CoA) -[node9104: 6.4.1.3 | ATP>ADP, +Pi {br=BR155, ev=cof+eq}]-> S_methylmalonyl_CoA;  // propionyl-CoA carboxylase
  }
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { HCO3 S_methylmalonyl_CoA } bypasses { HCO3 malonyl_CoA malonate_semialdehyde 3_Hydroxypropionate 3_Hydroxypropanoyl_CoA acryloyl_CoA propanoyl_CoA S_methylmalonyl_CoA };
  motif carrier { NAD NADH } forward { node2298 node9133 } backward { node9122 };
}
