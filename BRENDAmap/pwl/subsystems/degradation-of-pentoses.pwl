    -[node11401: 4.2.1.25 | +H2O ^R {br=BR407, ev=cof+eq}]-> 2_dehydro_3_deoxy_L_arabinonate  // L-Arabinonate dehydratase
    -R[node3777: 4.2.1.43 {br=BR3395, ev=eq}]-> 2_5_dioxopentanoate  // 2-dehydro-3-deoxy-L-arabinonate dehydratase
    -[node10107: 1.2.1.26 | NADP>NADPH, -H2O, +H {br=BR29396, ev=cof+eq}]-> 2OG;  // 2,5-dioxovalerate dehydrogenase

