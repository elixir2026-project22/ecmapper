    <-B[node9944: 2.7.1.47 | ATP>ADP ^R {br=BR47781, ev=cof+eq}]- D_ribulose  // D-ribulokinase
    <-[node9952: 5.3.1.3 {br=BR234, ev=eq}]- D_arabinose  // D-arabinose isomerase
    -[node2859: 1.1.1.427 | NADP>NADPH, +H {br=BR50382, ev=cof+eq} || node2171: 1.1.1.117 | NADP>NADPH, +H {br=BR36704, ev=cof+eq} || node11394: 1.1.1.116 | NAD>NADH {br=BR29182, ev=cof+eq}]-> D_arabinono_1_4_lactone  // D-arabinose 1-dehydrogenase (NADP+); D-arabinose 1-dehydrogenase [NAD(P)+]; D-arabinose 1-dehydrogenase (NAD+)
    -[node10101: 3.1.1.30 | -H2O ^R {br=BR11714, ev=cof+eq}]-> D_arabinonate  // D-arabinonolactonase
    -L[node3776: 4.2.1.5 | +H2O ^L {br=BR429, ev=cof+eq}]-> 2_dehydro_3_deoxy_D_arabinonate  // Arabinonate dehydratase
    -R[node2868: 4.2.1.141 | +H2O ^R {br=BR50477, ev=cof+eq}]-> 2_5_dioxopentanoate;  // 2-dehydro-3-deoxy-D-arabinonate dehydratase

  D_arabinose
    -[node10122: 3.2.1.55 | -H2O ^R]- arabinan;  // non-reducing end alpha-L-arabinofuranosidase

  2_Phosphoglycolate
    -[node7722: 3.1.3.18 | -H2O, +Pi {br=BR6356, ev=cof+eq}]-> glycolate  // phosphoglycolate phosphatase
    <-[node9954: 1.2.1.21 | NAD>NADH, -H2O {br=BR36774, ev=cof+eq}]- glycolaldehyde#2  // glycolaldehyde dehydrogenase
    -B[node6973: 1.2.1.21 | NAD>NADH ^R]- enzyme_cysteine_L1410;  // glycolaldehyde dehydrogenase

  2_dehydro_3_deoxy_L_arabinonate -[node2244: 4.1.2.18 {br=BR349, ev=eq, match=kegg}]-> (glycolaldehyde + pyruvate);  // 2-dehydro-3-deoxy-L-pentonate aldolase
  (glycerone_phosphate + glycolaldehyde#2) -[node9947: 4.1.2.17 {br=BS1689, ev=eq}]-> D_Ribulose_1_phosphate;  // L-Fuculose-phosphate aldolase
}
