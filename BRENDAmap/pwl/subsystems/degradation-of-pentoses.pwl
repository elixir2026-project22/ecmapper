  compound H2O brenda:1 kegg:C00001;
  compound L_Rul_5_P 'L-Rul 5-P' brenda:1106 kegg:C01101;
  compound L_Xul_5_P 'L-Xul 5-P' brenda:10703 kegg:C03291;
  compound L_arabinonate 'L-arabinonate' brenda:8879 kegg:C00545;
  compound L_arabinono_1_4_lactone 'L-arabinono-1,4-lactone' brenda:10687 kegg:C01114;
  compound L_arabinose 'L-arabinose' brenda:206;
  compound L_lyxose 'L-lyxose' brenda:1647 kegg:C01508;
  compound L_ribulose 'L-ribulose' brenda:1621 kegg:C00508;
  compound L_xylulose 'L-xylulose' brenda:1238 kegg:C00312;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound Pi brenda:16 kegg:C00009;
  compound arabinan brenda:12428 kegg:C02474;
  compound beta_D_ribopyranose 'beta-D-ribopyranose' brenda:186622;
  compound enzyme_cysteine_L1410 '[enzyme]-cysteine' brenda:1410;
  compound glycerone_phosphate 'glycerone phosphate' brenda:482 kegg:C00111;
  compound glycolaldehyde brenda:604 kegg:C00266;
  compound glycolate brenda:479 kegg:C00160;
