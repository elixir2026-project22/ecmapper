  port D_Rul_5_P side D to CMP-KDO-biosynthesis;
  port D_Xul_5_P side D to degradation-of-sugar-alcohols;
  port D_ribulose side L to degradation-of-sugar-alcohols;
  port glycerone_phosphate side L to degradation-of-sugar-alcohols;
  port glycolate side D to glycolate-and-glyoxylate-degradation;

  beta_D_ribopyranose
    -[node6882: 5.4.99.62]- D_ribose  // D-ribose pyranase
    -[node6881: ~?]- D_ribose#2  // spontaneous reaction
    -[node6884: 2.7.1.15 | ATP>ADP, +H {br=BR47755, ev=cof+eq}]-> D_Rib_5_P;  // ribokinase

  L_lyxose
    -B[node6876: 5.3.1.3/5.3.1.6/5.3.1.8/5.3.1.14/5.3.1.15 {br=BS1022, ev=eq}]-> L_xylulose  // D-arabinose isomerase;ribose-5-phosphate isomerase;mannose-6-phosphate isomerase;L-rhamnose isomerase;D-lyxose ketol-isomerase
