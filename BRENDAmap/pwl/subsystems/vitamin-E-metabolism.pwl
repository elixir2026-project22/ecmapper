pwl 2.0;
subsystem vitamin-E-metabolism 'vitamin E metabolism' {
  // BRENDA subsystem: 12 reactions (10 with direction), 15 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_3_dimethyl_6_phytyl_1_4_benzoquinone '2,3-dimethyl-6-phytyl-1,4-benzoquinone' brenda:189073;
  compound 2_methyl_6_phytyl_1_4_benzoquinone '2-methyl-6-phytyl-1,4-benzoquinone' brenda:189072;
  compound 6_geranylgeranyl_2_3_dimethylbenzene_1_4_diol '6-geranylgeranyl-2,3-dimethylbenzene-1,4-diol' brenda:42523 kegg:C20738;
  compound 6_geranylgeranyl_2_methylbenzene_1_4_diol '6-geranylgeranyl-2-methylbenzene-1,4-diol' brenda:19765 kegg:C20737;
  compound Alpha_tocotrienol 'Alpha-tocotrienol' brenda:164156 kegg:C14153;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound PPi brenda:17 kegg:C00013;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound alpha_tocopherol 'alpha-tocopherol' brenda:5933 kegg:C02477;
  compound beta_tocopherol 'beta-tocopherol' brenda:43869 kegg:C14152;
  compound beta_tocotrienol 'beta-tocotrienol' brenda:212198 kegg:C14154;
  compound delta_tocopherol 'delta-tocopherol' brenda:10634 kegg:C14151;
  compound delta_tocotrienol 'delta-tocotrienol' brenda:84180 kegg:C14156;
  compound gamma_tocopherol 'gamma-tocopherol' brenda:8106 kegg:C02483;
  compound gamma_tocotrienol 'gamma-tocotrienol' brenda:84186 kegg:C14155;
  compound geranylgeranyl_diphosphate 'geranylgeranyl diphosphate' brenda:231 kegg:C00353;
  compound homogentisate brenda:1826 kegg:C00544;
  compound phytyl_PP 'phytyl-PP' brenda:3092 kegg:C05427;

  beta_tocopherol
    -B[node6500: 2.1.1.95 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L]- delta_tocopherol  // tocopherol C-methyltransferase
    -[node6502: 5.5.1.24 {br=BR50791, ev=eq, match=single}]-> 2_methyl_6_phytyl_1_4_benzoquinone  // tocopherol cyclase
    -B[node6494: 2.1.1.295 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R]- 2_3_dimethyl_6_phytyl_1_4_benzoquinone  // 2-methyl-6-phytyl-1,4-hydroquinone methyltransferase
    <-[node6490: 5.5.1.24 {br=BR50792, ev=eq, match=single}]- gamma_tocopherol  // tocopherol cyclase
    -[node6498: 2.1.1.95 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR43934, ev=cof+eq}]-> alpha_tocopherol;  // tocopherol C-methyltransferase

  delta_tocotrienol
    -[node2059: 2.1.1.95 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR52802, ev=cof+eq}]-> beta_tocotrienol;  // tocopherol C-methyltransferase

  delta_tocotrienol
    -B[node2061: 5.5.1.24 {br=BR50793, ev=eq}]-> 6_geranylgeranyl_2_methylbenzene_1_4_diol  // tocopherol cyclase
    -B[node2055: 2.1.1.295 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR50941, ev=cof+eq}]-> 6_geranylgeranyl_2_3_dimethylbenzene_1_4_diol  // 2-methyl-6-phytyl-1,4-hydroquinone methyltransferase
    <-[node2053: 5.5.1.24 {br=BR50794, ev=eq}]- gamma_tocotrienol  // tocopherol cyclase
    -[node2051: 2.1.1.95 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR52801, ev=cof+eq}]-> Alpha_tocotrienol;  // tocopherol C-methyltransferase

  (geranylgeranyl_diphosphate + homogentisate) -[node2063: 2.5.1.116 {br=BR50959, ev=eq}]-> 6_geranylgeranyl_2_methylbenzene_1_4_diol;  // homogentisate geranylgeranyltransferase
  (homogentisate + phytyl_PP) -[node6505: 2.5.1.115 | -H, +PPi, +CO2 {br=BR50958, ev=cof+eq, match=single}]-> 2_methyl_6_phytyl_1_4_benzoquinone;  // homogentisate phytyltransferase
}
