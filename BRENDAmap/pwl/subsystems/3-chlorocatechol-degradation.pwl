pwl 2.0;
subsystem 3-chlorocatechol-degradation '3-chlorocatechol degradation' {
  // BRENDA subsystem: 5 reactions (5 with direction), 6 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_chloro_cis_cis_muconate '2-chloro-cis,cis-muconate' brenda:2005 kegg:C03572;
  compound 3_chlorocatechol '3-chlorocatechol' brenda:1707 kegg:C05618;
  compound 3_oxoadipate '3-oxoadipate' brenda:2817 kegg:C00846;
  compound 5_chloromuconolactone '5-chloromuconolactone' brenda:29589;
  compound Cl 'Cl-' brenda:298 kegg:C00698;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound maleylacetate brenda:9021 kegg:C02222;
  compound trans_4_carboxymethylenebut_2_en_4_olide 'trans-4-carboxymethylenebut-2-en-4-olide' brenda:5246 kegg:C12838;
  port 3_oxoadipate side U to 4-hydroxymandelate-degradation;

  3_chlorocatechol
    -[node10796: 1.13.11.1 | -O2 ^L {br=BS260574, ev=cof+eq}]-> 2_chloro_cis_cis_muconate  // catechol 1,2-dioxygenase
    -[node10798: 5.5.1.7 {br=BS1271, ev=eq}]-> 5_chloromuconolactone  // chloromuconate cycloisomerase
    -[node10793: 5.5.1.7 | +Cl ^L {br=BS1280, ev=cof+eq, match=single}]-> trans_4_carboxymethylenebut_2_en_4_olide  // Chloromuconate cycloisomerase
    -B[node10791: 3.1.1.45 | -H2O ^R {br=BR11718, ev=cof+eq, match=kegg}]-> maleylacetate  // carboxymethylenebutenolidase
    -[node10789: 1.3.1.32 | NADPH>NADP ^R {br=BR36814, ev=cof-eq}]-> 3_oxoadipate;  // maleylacetate reductase
}
