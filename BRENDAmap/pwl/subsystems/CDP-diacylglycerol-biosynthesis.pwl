pwl 2.0;
subsystem CDP-diacylglycerol-biosynthesis 'CDP-diacylglycerol biosynthesis' {
  // BRENDA subsystem: 4 reactions (4 with direction), 5 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 1_2_diacyl_sn_glycerol_3_phosphate '1,2-diacyl-sn-glycerol 3-phosphate' brenda:4752 kegg:C00416;
  compound 1_acyl_sn_glycerol_3_phosphate '1-acyl-sn-glycerol 3-phosphate' brenda:2185 kegg:C00681;
  compound CDP_diacylglycerol 'CDP-diacylglycerol' brenda:1248 kegg:C00269;
  compound CTP brenda:60 kegg:C00063;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPi brenda:17 kegg:C00013;
  compound acyl_CoA 'acyl-CoA' brenda:492 kegg:C00040;
  compound glycerone_phosphate 'glycerone phosphate' brenda:482 kegg:C00111;
  compound sn_glycerol_3_phosphate 'sn-glycerol 3-phosphate' brenda:422 kegg:C00093;
  port CDP_diacylglycerol side R to cardiolipin-biosynthesis;
  port CDP_diacylglycerol side R to phosphatidylethanolamine-bioynthesis;
  port glycerone_phosphate side L to degradation-of-sugar-alcohols;
  port sn_glycerol_3_phosphate side U to teichoic-acid-biosynthesis;

  glycerone_phosphate
    -L[node9576: 1.1.1.94 | NADPH>NADP, -H {br=BR29350, ev=cof-eq, match=single}]-> sn_glycerol_3_phosphate  // glycerol-3-phosphate dehydrogenase [NAD(P)+]
    -[node9579: 2.3.1.15 | -acyl_CoA, +CoA {br=BR44007, ev=cof+eq, match=similar}]-> 1_acyl_sn_glycerol_3_phosphate  // glycerol-3-phosphate 1-O-acyltransferase
    -R[node9559: 2.3.1.51 | -acyl_CoA, +CoA ^R {br=BR44053, ev=cof+eq}]-> 1_2_diacyl_sn_glycerol_3_phosphate  // 1-acylglycerol-3-phosphate O-acyltransferase
    -R[node9584: 2.7.7.41 | -CTP, +PPi ^R {br=BR47885, ev=cof+eq, match=kegg}]-> CDP_diacylglycerol;  // phosphatidate cytidylyltransferase
}
