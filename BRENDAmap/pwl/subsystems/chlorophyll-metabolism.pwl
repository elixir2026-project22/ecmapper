pwl 2.0;
subsystem chlorophyll-metabolism 'chlorophyll metabolism' {
  // BRENDA subsystem: 19 reactions (12 with direction), 18 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 131_hydroxy_magnesium_protoporphyrin_IX_13_monomethyl_ester '131-hydroxy-magnesium-protoporphyrin IX 13-monomethyl ester' brenda:32785 kegg:C11829;
  compound 131_oxo_magnesium_protoporphyrin_IX_13_monomethyl '131-oxo-magnesium-protoporphyrin IX 13-monomethyl' brenda:32786 kegg:C11830;
  compound 7_1_hydroxychlorophyll_a '7(1)-hydroxychlorophyll a' brenda:192228 kegg:C18151;
  compound 7_hydroxychlorophyllide_a '7-hydroxychlorophyllide a' brenda:23585;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CDP brenda:212 kegg:C00112;
  compound CTP brenda:60 kegg:C00063;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound MG2 'MG2+' brenda:6551 kegg:C00305;
  compound Mg_protoporphyrin 'Mg-protoporphyrin' brenda:50840;
  compound Mg_protoporphyrin_monomethyl_ester 'Mg-protoporphyrin monomethyl ester' brenda:15836 kegg:C04536;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound chlorophyll_a 'chlorophyll a' brenda:2647 kegg:C05306;
  compound chlorophyll_b 'chlorophyll b' brenda:5270 kegg:C05307;
  compound chlorophyllide_a 'chlorophyllide a' brenda:2400 kegg:C02139;
  compound chlorophyllide_b 'chlorophyllide b' brenda:6086 kegg:C16541;
  compound dihydrogeranygeranyl_chlorophyll_a 'dihydrogeranygeranyl-chlorophyll a' brenda:189759;
  compound divinyl_protochlorophyllide_a 'divinyl protochlorophyllide a' brenda:61381;
  compound geranylgeranyl_diphosphate 'geranylgeranyl diphosphate' brenda:231 kegg:C00353;
  compound geranylgeranylchlorophyllide_a 'geranylgeranylchlorophyllide a' brenda:113548;
  compound monovinyl_protochlorophyllide_a 'monovinyl protochlorophyllide a' brenda:61382;
  compound phytol brenda:2351 kegg:C01389;
  compound phytyl_PP 'phytyl-PP' brenda:3092 kegg:C05427;
  compound phytyl_phosphate 'phytyl phosphate' brenda:42713 kegg:C20764;
  compound protoporphyrin_IX 'protoporphyrin IX' brenda:868 kegg:C02191;
  compound tetrahydrogeranylgeranyl_chlorophyll_a 'tetrahydrogeranylgeranyl-chlorophyll a' brenda:189758;
  port protoporphyrin_IX side R to heme-metabolism;

  // ring: cycle of the drawing (9 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    geranylgeranylchlorophyllide_a
      <-R[node7069: 2.5.1.62 | -geranylgeranyl_diphosphate, +PPi ^L {br=BS356295, ev=cof+eq}]- chlorophyllide_a  // chlorophyll synthase
      -R[node7082: 1.14.13.122 | NADPH>NADP, -O2, -H, +H2O {br=BR48662, ev=cof+eq, match=single}]-> 7_hydroxychlorophyllide_a  // chlorophyllide-a oxygenase
      -L[node7084: 1.14.13.122 | NADPH>NADP, -H, -O2, +2*H2O {br=BR50345, ev=cof+eq, match=single}]-> chlorophyllide_b  // chlorophyllide-a oxygenase
      -L[node7080: 2.5.1.62 | -phytyl_PP, +PPi]- chlorophyll_b  // chlorophyll synthase
      -[node7086: 1.1.1.294 | -H, -NADPH, +NADP {br=BS404659, ev=cof+eq, match=kegg}]-> 7_1_hydroxychlorophyll_a  // chlorophyll(ide) b reductase
      -L[node7079: 1.17.7.2 | Fd_red>Fd_ox, -H, +H2O]- chlorophyll_a  // 7-hydroxymethyl chlorophyll a reductase
      -R[node7070: ? | NADPH>NADP, -H]- tetrahydrogeranylgeranyl_chlorophyll_a  // geranylgeranyl diphosphate reductase
      -L[node7075: ? | NADPH>NADP, -H]- dihydrogeranygeranyl_chlorophyll_a  // geranylgeranyl diphosphate reductase
      -L[node7072: ? | NADPH>NADP, -H ^R]- geranylgeranylchlorophyllide_a;  // geranylgeranyl diphosphate reductase
    chord chlorophyll_a -B[node7078: 2.5.1.62 | -PPi, +H, +phytyl_PP ^L {br=BR47669, ev=cof-eq}]-> chlorophyllide_a;  // chlorophyll synthase
  }

  phytyl_phosphate
    -L[node1932: 2.7.1.182 | -CDP, +CTP ^R {br=BR50968, ev=cof-eq}]-> phytol  // phytol kinase
    -L[node1936: 3.1.1.14 | -H2O, -chlorophyllide_a {br=BS363953, ev=conflict, match=single}]- chlorophyll_a;  // chlorophyllase

  protoporphyrin_IX
    -R[node7055: 6.6.1.1 | ATP>ADP, -H2O, -MG2, +Pi, +2*H {br=BR47981, ev=cof+eq, match=single}]-> Mg_protoporphyrin  // magnesium chelatase
    -[node7057: 2.1.1.11 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR43869, ev=cof+eq, match=single}]-> Mg_protoporphyrin_monomethyl_ester  // magnesium protoporphyrin IX methyltransferase
    -L[node7064: 1.14.13.81 | NADPH>NADP, -O2, -H, +H2O {br=BR51936, ev=cof+eq, match=kegg}]-> 131_hydroxy_magnesium_protoporphyrin_IX_13_monomethyl_ester  // magnesium-protoporphyrin IX monomethyl ester (oxidative) cyclase
    -L[node7058: 1.14.13.81 | NADPH>NADP, -O2, -H, +2*H2O {br=BR51937, ev=cof+eq}]-> 131_oxo_magnesium_protoporphyrin_IX_13_monomethyl  // magnesium-protoporphyrin IX monomethyl ester (oxidative) cyclase
    -[node7068: 1.14.13.81 | NADPH>NADP, -H, -O2, +2*H2O {br=BR51938, ev=cof+eq, match=single}]-> divinyl_protochlorophyllide_a  // magnesium-protoporphyrin IX monomethyl ester (oxidative) cyclase
    -R[node7065: 1.3.1.75 | NADPH>NADP, -H]- monovinyl_protochlorophyllide_a  // 3,8-divinyl protochlorophyllide a 8-vinyl-reductase (NADPH)
    -[node7062: 1.3.1.33 | NADPH>NADP, -H {br=BR36964, ev=cof-eq, match=single}]-> chlorophyllide_a;  // protochlorophyllide reductase
}
