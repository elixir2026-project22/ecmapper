pwl 2.0;
subsystem adipate-degradation 'adipate degradation' {
  // BRENDA subsystem: 4 reactions (1 with direction), 5 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2_3_didehydroadipoyl_CoA '2,3-didehydroadipoyl-CoA' brenda:190023 kegg:C14144;
  compound 3S_3_hydroxyadipyl_CoA '(3S)-3-hydroxyadipyl-CoA' brenda:155011 kegg:C14145;
  compound 3_oxoadipyl_CoA '3-oxoadipyl-CoA' brenda:9045 kegg:C02232;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound FAD brenda:20 kegg:C00016;
  compound FADH2 brenda:256 kegg:C01352;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound PPi brenda:17 kegg:C00013;
  compound adipate brenda:1712 kegg:C06104;
  compound adipyl_CoA 'adipyl-CoA' brenda:4221 kegg:C14143;
  port 3_oxoadipyl_CoA side D to phenylacetate-degradation-aerobic;
  port adipate side D to cyclohexanol-degradation;

  adipate
    -[node8582: 6.2.1.14 | ATP>AMP, -CoA, +PPi]- adipyl_CoA  // 6-carboxyhexanoate-CoA ligase
    -[node8572: 1.3.99.- | FAD>FADH2 ^L]- 2_3_didehydroadipoyl_CoA  // acyl-CoA dehydrogenase
    -[node8570: 4.2.1.17 | -H2O ^L]- 3S_3_hydroxyadipyl_CoA  // enoyl-CoA hydratase
    -[node8584: 1.1.1.35 | NAD>NADH ^L {br=BS417822, ev=cof+eq}]-> 3_oxoadipyl_CoA;  // 3-hydroxyacyl-CoA dehydrogenase
}
