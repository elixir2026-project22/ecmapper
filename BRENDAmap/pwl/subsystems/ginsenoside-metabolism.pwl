  compound ginsenoside_Rg2 'ginsenoside Rg2' brenda:28873;
  compound ginsenoside_Rg3 'ginsenoside Rg3' brenda:10261 kegg:C20778;
  compound ginsenoside_Rh1 'ginsenoside Rh1' brenda:11912 kegg:C22129;
  compound ginsenoside_Rh2 'ginsenoside Rh2' brenda:78769;
  compound ginsenoside_Ro 'ginsenoside Ro' brenda:42558 kegg:C17543;
  compound gypenoside_XVII 'gypenoside XVII' brenda:78719 kegg:C20736;
  compound oleanolate brenda:200991 kegg:C17148;
  compound oleanolate_3_O_beta_D_glucoside 'oleanolate 3-O-beta-D-glucoside' brenda:230376 kegg:C22130;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound protopanaxadiol brenda:19767 kegg:C20715;
