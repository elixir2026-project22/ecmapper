    -[node2104: -> 2.4.1.314 | UDP_Glc_L364>UDP {br=BR50801, ev=cof+eq} || node2085: 3.2.1.195 | -H2O, +D_glucose || node2075: <- 3.2.1.192 | -H2O, +D_glucose {br=BR50699, ev=cof+eq}]- ginsenoside_Rb1  // ginsenoside Rd glucosyltransferase; 20-O-multi-glycoside ginsenosidase; ginsenoside Rb1 beta-glucosidase
    -L[node2084: 3.2.1.191 | -H2O, +D_glucose {br=BS423597, ev=cof+eq}]-> gypenoside_XVII;  // ginsenosidase type III

