    -L[node2102: 1.14.14.121 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50787, ev=cof+eq}]-> protopanaxatriol  // protopanaxadiol 6-hydroxylase
    -R[node11967: 2.4.1.363/2.4.1.366 | UDP_Glc_L364>UDP ^R {br=BS448197, ev=cof+eq}]-> ginsenoside_F1  // ginsenoside 20-O-glucosyltransferase;ginsenoside F1 6-O-glucosyltransferase
    -[node11974: 3.2.1.194 | +H2O, +D_glucose {br=BS423616, ev=conflict} || node2100: -> 2.4.1.366/2.4.1.367 | UDP_Glc_L364>UDP {br=BR52744, ev=cof+eq}]- ginsenoside_Rg1;  // ginsenosidase type IV; ginsenoside F1 6-O-glucosyltransferase;ginsenoside 6-O-glucosyltransferase

  protopanaxatriol
    -[node11977: 2.4.1.367 | UDP_Glc_L364>UDP ^L {br=BR52745, ev=cof+eq}]-> ginsenoside_Rh1  // ginsenoside 6-O-glucosyltransferase
    -[node11981: 2.4.1.- | dTDP_beta_L_rhamnose>dTDP ^L]- ginsenoside_Rg2;  // unknown

  protopanaxadiol
    <-R[node2111: 1.14.14.120 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50786, ev=cof+eq}]- dammarenediol_II  // dammarenediol 12-hydroxylase
    <-R[node2115: 4.2.1.125 | -H2O ^L {br=BR48943, ev=cof-eq}]- 3S_2_3_epoxy_2_3_dihydrosqualene  // dammarenediol II synthase
    -R[node2116: 5.4.99.39 {br=BR48944, ev=eq}]-> beta_amyrin  // beta-amyrin synthase
    -[node2112: 1.14.14.126 | 3*reduced_NADPH_hemoprotein_reductase>3*oxidized_NADPH_hemoprotein_reductase, -3*O2, +4*H2O {br=BR51297, ev=cof+eq}]-> oleanolate  // beta-amyrin 28-monooxygenase
    -B[node2108: 2.4.1.368 | UDP_Glc_L364>UDP {br=BR52747, ev=cof+eq}]-> oleanolate_3_O_beta_D_glucoside  // oleanolate 3-O-glucosyltransferase
    -[node1443: ?]- ginsenoside_Ro;  // unknown
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { ginsenoside_F2 ginsenoside_Rd } forward { node11990 } backward { node2082 };
  motif substrate_cycle { ginsenoside_Rb1 ginsenoside_Rd } forward { node2075 } backward { node2104 };
  motif substrate_cycle { ginsenoside_Rd ginsenoside_Rg3 } forward { node2074 } backward { node1269 };
