  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;

  // ring: cycle of the drawing (6 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    protopanaxadiol
      -[node2106: 2.4.1.363 | UDP_Glc_L364>UDP ^R {br=BR52739, ev=cof+eq}]-> ginsenoside_C_K  // ginsenoside 20-O-glucosyltransferase
      -[node11986: 2.4.1.364 | UDP_Glc_L364>UDP ^L {br=BR52741, ev=cof+eq}]-> ginsenoside_F2  // protopanaxadiol-type ginsenoside 3-O-glucosyltransferase
      -[node2082: <- 3.2.1.191 | -H2O, +D_glucose {br=BS423611, ev=cof+eq} || node11990: -> 2.4.1.365 | UDP_Glc_L364>UDP {br=BR52743, ev=cof+eq}]- ginsenoside_Rd  // ginsenosidase type III; protopanaxadiol-type ginsenoside-3-O-glucoside 2''-O-glucosyltransferase
      -B[node2074: -> 3.2.1.192 | -H2O, +D_glucose {br=BR50700, ev=cof+eq, match=single} || node1269: <- 2.4.1.363 | UDP_Glc_L364>UDP {br=BS448222, ev=cof+eq}]- ginsenoside_Rg3  // ginsenoside Rb1 beta-glucosidase; ginsenoside 20-O-glucosyltransferase
      -[node2073: 3.2.1.21 | -H2O, +D_glucose || node11996: 2.4.1.365 | UDP_Glc_L364>UDP]- ginsenoside_Rh2  // beta-glucosidase; protopanaxadiol-type ginsenoside-3-O-glucoside 2''-O-glucosyltransferase
      <-[node11994: 2.4.1.364 | UDP_Glc_L364>UDP ^R {br=BR52740, ev=cof+eq}]- protopanaxadiol;  // protopanaxadiol-type ginsenoside 3-O-glucosyltransferase
    chord ginsenoside_Rh2 -L[node1266: 2.4.1.363 | UDP_Glc_L364>UDP {br=BS448223, ev=cof+eq}]-> ginsenoside_F2;  // ginsenoside 20-O-glucosyltransferase
