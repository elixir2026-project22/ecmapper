pwl 2.0;
subsystem glycolysis 'glycolysis' {
  // BRENDA subsystem: 18 reactions (15 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 1_3_BPG '1,3-BPG' brenda:2125;
  compound 2_phospho_D_glycerate '2-phospho-D-glycerate' brenda:10090 kegg:C00631;
  compound 3_phosphoglycerate '3-phosphoglycerate' brenda:194;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound DHAP brenda:278 kegg:C00111;
  compound D_Glc_6_P 'D-Glc 6-P' brenda:105 kegg:C00092;
  compound D_glucose 'D-glucose' brenda:35 brenda:1969 kegg:C00031;
  compound FBP brenda:6523;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound Fru_6_P 'Fru 6-P' brenda:87 kegg:C00085;
  compound GAP brenda:147 kegg:C00118;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PEP brenda:51 kegg:C00074;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound pyruvate brenda:31 kegg:C00022;
  port 2_phospho_D_glycerate side L to degradation-of-sugar-acids;
  port 2_phospho_D_glycerate side R to serine-metabolism;
  port 3_phosphoglycerate side L to mannosylglycerate-biosynthesis;
  port 3_phosphoglycerate side R to serine-metabolism;
  port DHAP side L to degradation-of-sugar-alcohols;
  port DHAP side L to lipid-metabolism;
  port DHAP side R to grixazone-biosynthesis;
  port D_Glc_6_P side L to degradation-of-hexoses;
  port D_Glc_6_P side L to kanosamine-biosynthesis-II;
  port D_Glc_6_P side R to pentose-phosphate-pathway;
  port D_Glc_6_P side U to metabolism-of-disaccharids;
  port D_Glc_6_P side U to myo-inositol-biosynthesis;
  port FBP side L to degradation-of-hexoses;
  port Fru_6_P side L to UDP-GlcNAc-biosynthesis;
  port Fru_6_P side L to d-mannose-degradation;
  port Fru_6_P side L to metabolism-of-amino-sugars-and-derivatives;
  port Fru_6_P side L to metabolism-of-disaccharids;
  port Fru_6_P side R to pentose-phosphate-pathway;
  port Fru_6_P side R to ribulose-monophosphate-pathway;
  port Fru_6_P side U to metabolism-of-disaccharids;
  port GAP side R to pentose-phosphate-pathway;
  port GAP side U to metabolism-of-disaccharids;
  port PEP side U to gluconeogenesis;
  port pyruvate side L to acetoin-degradation;
  port pyruvate side L to anapleurotic-synthesis-of-oxalacetate;
  port pyruvate side L to ethanol-fermentation;
  port pyruvate side R to gluconeogenesis;
  port pyruvate side R to lactate-fermentation;
  port pyruvate side R to oxidative-decarboxylation-of-pyruvate;
  port pyruvate side R to serine-metabolism;

  D_glucose
    -[node11143: 2.7.1.147 | ADP>AMP || node10636: -> 2.7.1.1 | ATP>ADP {br=BR47759, ev=cof+eq}]- D_Glc_6_P  // ADP-specific glucose/glucosamine kinase; hexokinase
    <-[node8565: 5.3.1.9 {br=BR240, ev=eq, rev=eq}]-> Fru_6_P  // Glucose-6-phosphate isomerase
    -[node11140: -> 2.7.1.146 | ADP>AMP {br=BR37044, ev=cof+eq} || node8581: -> 2.7.1.11 | ATP>ADP {br=BR47724, ev=cof+eq} || node8421: <- 3.1.3.11 | -H2O, +Pi {br=BR19198, ev=cof+eq} || node11150: -> 2.7.1.90 | PPi>Pi {br=BR47815, ev=cof+eq}]- FBP;  // ADP-specific phosphofructokinase; 6-phosphofructokinase; fructose-bisphosphatase; diphosphate-fructose-6-phosphate 1-phosphotransferase

  GAP
    -[node8585: 1.2.1.12 | NAD>NADH, -Pi ^L {br=BR1125-a, ev=cof+eq, match=similar}]-> 1_3_BPG  // glyceraldehyde-3-phosphate dehydrogenase (phosphorylating)
    -[node8583: 2.7.2.3 | ADP>ATP ^L {br=BS422744, ev=cof-eq, match=single}]-> 3_phosphoglycerate  // phosphoglycerate kinase
    -[node8573: <- 5.4.2.11 {br=BR17, ev=eq} || node2849: 5.4.2.12]- 2_phospho_D_glycerate  // phosphoglycerate mutase (2,3-diphosphoglycerate-dependent); phosphoglycerate mutase (2,3-diphosphoglycerate-independent)
    -[node8571: 4.2.1.11 | +H2O ^R {br=BR3384, ev=cof+eq}]-> PEP  // phosphopyruvate hydratase
    -[node8577: 2.7.1.40 | ADP>ATP ^R {br=BR47778, ev=cof-eq}]-> pyruvate;  // pyruvate kinase

  3_phosphoglycerate
    -B[node2304: 1.2.1.90 | NAD>NADH, -H2O, +H || node8284: <- 1.2.7.6 | Fd_ox>Fd_red, -H2O, +2*H {br=BR48033, ev=cof+eq} || node8708: <- 1.2.1.9 | NADP>NADPH, -H2O, +H {br=BR29425, ev=cof+eq}]- GAP  // glyceraldehyde-3-phosphate dehydrogenase [NAD(P)+]; glyceraldehyde-3-phosphate dehydrogenase (ferredoxin); glyceraldehyde-3-phosphate dehydrogenase (NADP+)
    -L[node8593: 5.3.1.1 {br=BR219, ev=eq, match=kegg}]-> DHAP;  // Triose-phosphate isomerase

  FBP -[node8579: 4.1.2.13 {br=BR344, ev=eq, match=kegg}]-> (DHAP + GAP);  // Fructose-bisphosphate aldolase
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { FBP Fru_6_P } forward { node8421 } backward { node11140 node8581 node11150 };
  motif carrier { ADP ATP } forward { node8577 node8583 } backward { node10636 node8581 };
}
