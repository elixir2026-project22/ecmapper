    -[node11576: 2.4.1.308 | GDP_beta_L_fucose>GDP ^L {br=BR50657, ev=cof+eq}]-> alpha_L_Fuc_1_2_beta_D_Gal_1_3_alpha_D_GalNAc_1_3_alpha_D_GalNAc_diphospho_ditrans_octacis_undecaprenol  // GDP-Fuc:beta-D-Gal-1,3-alpha-D-GalNAc-1,3-alpha-GalNAc-diphosphoundecaprenol alpha-1,2-fucosyltransferase
    -[node11578: 2.4.1.309 | UDP_alpha_D_galactose>UDP ^L {br=BR50658, ev=cof+eq}]-> alpha_D_Gal_1_3_alpha_L_Fuc_1_2_beta_D_Gal_1_3_alpha_D_GalNAc_1_3_alpha_D_GalNAc_diphospho_ditrans_octacis_undecaprenol;  // UDP-Gal:alpha-L-Fuc-1,2-beta-Gal-1,3-alpha-GalNAc-1,3-alpha-GalNAc-diphosphoundecaprenol alpha-1,3-galactosyltransferase
