pwl 2.0;
subsystem 4-hydroxymandelate-degradation '4-hydroxymandelate degradation' {
  // BRENDA subsystem: 11 reactions (8 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_carboxy_2_5_dihydro_5_oxofuran_2_acetate '2-carboxy-2,5-dihydro-5-oxofuran-2-acetate' brenda:5096 kegg:C01278;
  compound 3_4_dihydroxybenzoate '3,4-dihydroxybenzoate' brenda:736 kegg:C00230;
  compound 3_carboxy_cis_cis_muconate '3-carboxy-cis,cis-muconate' brenda:5907 kegg:C01163;
  compound 3_oxoadipate '3-oxoadipate' brenda:2817 kegg:C00846;
  compound 3_oxoadipyl_CoA '3-oxoadipyl-CoA' brenda:9045 kegg:C02232;
  compound 4_5_dihydro_5_oxofuran_2_acetate '4,5-dihydro-5-oxofuran-2-acetate' brenda:95914 kegg:C03586;
  compound 4_hydroxybenzaldehyde '4-hydroxybenzaldehyde' brenda:711 kegg:C00633;
  compound 4_hydroxybenzoate '4-hydroxybenzoate' brenda:365 kegg:C00156;
  compound 4_hydroxyphenylglyoxylate '4-hydroxyphenylglyoxylate' brenda:29547 kegg:C03590;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound R_4_hydroxymandelate '(R)-4-hydroxymandelate' brenda:182349;
  compound S_4_hydroxymandelate '(S)-4-hydroxymandelate' brenda:42263;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound succinate brenda:58 kegg:C00042;
  compound succinyl_CoA 'succinyl-CoA' brenda:224 kegg:C00091;
  port 3_4_dihydroxybenzoate side U to quinate-degradation;
