    -[node7437: 1.2.1.7 | NADP>NADPH, -H2O, +2*H {br=BR51337, ev=cof+eq} || node7439: 1.2.1.64 | NAD>NADH, -H2O, +H {br=BR29420, ev=cof+eq}]-> 4_hydroxybenzoate  // benzaldehyde dehydrogenase (NADP+); 4-hydroxybenzaldehyde dehydrogenase (NAD+)
    -[node7457: 1.14.13.2 | NADPH>NADP, -O2, -H, +H2O {br=BR36759, ev=cof+eq}]-> 3_4_dihydroxybenzoate  // 4-hydroxybenzoate 3-monooxygenase
    -B[node7465: 1.13.11.3 | -O2, +H {br=BR40477, ev=cof+eq}]-> 3_carboxy_cis_cis_muconate  // protocatechuate 3,4-dioxygenase
    -[node7471: 5.5.1.2 {br=BR260, ev=eq, match=kegg}]-> 2_carboxy_2_5_dihydro_5_oxofuran_2_acetate  // 3-Carboxy-cis,cis-muconate cycloisomerase
    -[node7467: 4.1.1.44 | +CO2 ^R {br=BS18492, ev=cof+eq}]-> 4_5_dihydro_5_oxofuran_2_acetate  // 4-carboxymuconolactone decarboxylase
    -B[node7474: 3.1.1.24 | -H2O ^R {br=BR11711, ev=cof+eq, match=kegg}]-> 3_oxoadipate  // 3-oxoadipate enol-lactonase
    -[node7478: 2.8.3.6 | -succinyl_CoA, +succinate ^R {br=BR48131, ev=cof+eq}]-> 3_oxoadipyl_CoA;  // 3-oxoadipate CoA-transferase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NADP NADPH } forward { node7437 } backward { node7457 };
