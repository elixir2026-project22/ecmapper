  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound amorpha_4_11_diene 'amorpha-4,11-diene' brenda:9853 kegg:C16028;
  compound arteannuin_B '(-)-arteannuin B' brenda:245113;
  compound artemisinate brenda:86264 kegg:C20309;
  compound artemisinic_alcohol 'artemisinic alcohol' brenda:19554 kegg:C20307;
  compound artemisinic_aldehyde 'artemisinic aldehyde' brenda:6337 kegg:C20308;
  compound artemisinin brenda:169885 kegg:C09538;
  compound dihydroartemisinate brenda:168374;
  compound dihydroartemisinic_acid_hydroperoxide 'dihydroartemisinic acid hydroperoxide' brenda:245114;
  compound eupatolide brenda:228471 kegg:C09440;
  compound germacra_1_10_4_11_13_trien_12_al 'germacra-1(10),4,11(13)-trien-12-al' brenda:82545 kegg:C19677;
  compound germacra_1_10_4_11_13_trien_12_oate 'germacra-1(10),4,11(13)-trien-12-oate' brenda:15033 kegg:C19678;
  compound germacra_1_10_4_11_13_trien_12_ol 'germacra-1(10),4,11(13)-trien-12-ol' brenda:19280 kegg:C19676;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound plus_R_gemacrene_A '(+)-(R)-gemacrene A' brenda:169967;
  compound plus_costunolide '(+)-costunolide' brenda:23210 kegg:C09382;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  port 2E_6E_farnesyl_PP side U to isoprenoid-biosynthesis;

  artemisinin
    -L[node1124: ~? | -O2, -H, +H2O {br=BR53094, ev=cof+eq, match=similar}]-> dihydroartemisinic_acid_hydroperoxide  // spontaneous reaction
    <-[node1127: ~? | -O2 ^L {br=BR53094, ev=eq, match=similar}]- dihydroartemisinate  // spontaneous reaction
    -L[node1133: ? | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O]- 11R_dihydroartemisinic_aldehyde  // dihydroartemisinic aldehyde oxidase
    <-[node1134: 1.3.1.92 | NADPH>NADP, -H {br=BR50092, ev=cof-eq}]- artemisinic_aldehyde  // artemisinic aldehyde DELTA11(13)-reductase
    -L[node12400: 1.14.14.114 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50106, ev=cof+eq}]-> artemisinate  // amorpha-4,11-diene 12-monooxygenase
    -[node1143: ~? | -O2, -H, +H2O {br=BR53094, ev=cof+eq}]-> arteannuin_B;  // spontaneous reaction

  artemisinic_aldehyde
    <-[node12390: 1.14.14.114 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +2*H2O {br=BR50105, ev=cof+eq}]- artemisinic_alcohol  // amorpha-4,11-diene 12-monooxygenase
    <-[node12384: 1.14.14.114 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50356, ev=cof+eq}]- amorpha_4_11_diene  // amorpha-4,11-diene 12-monooxygenase
    <-[node12379: 4.2.3.24 | +PPi ^L {br=BR48696, ev=cof+eq}]- 2E_6E_farnesyl_PP  // amorpha-4,11-diene synthase
    -[node1117: 4.2.3.23 | +PPi ^L {br=BR50766, ev=cof+eq}]-> plus_R_gemacrene_A  // germacrene-A synthase
    -[node1111: 1.14.14.95 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52444, ev=cof+eq, match=single}]-> germacra_1_10_4_11_13_trien_12_ol  // germacrene A hydroxylase
    -B[node1107: 1.14.14.95 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +2*H2O {br=BR52445, ev=cof+eq}]-> germacra_1_10_4_11_13_trien_12_al  // germacrene A hydroxylase
    -[node1101: 1.14.14.95 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52446, ev=cof+eq}]-> germacra_1_10_4_11_13_trien_12_oate  // germacrene A hydroxylase
    -[node12402: 1.14.14.150 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52441, ev=cof+eq}]-> 6alpha_hydroxygermacra_1_10_4_11_13_trien_12_oate  // costunolide synthase
    -L[node12407: 1.14.14.150 | +H2O ^R {br=BR52442, ev=cof+eq}]-> plus_costunolide;  // costunolide synthase

  germacra_1_10_4_11_13_trien_12_oate
    -[node12417: 1.14.14.170 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52568, ev=cof+eq}]-> 8alpha_hydroxygermacra_1_10_4_11_13_trien_12_oate  // 8-epi-inunolide synthase
    -R[node12425: 1.14.14.170 | +H2O ^L {br=BR52569, ev=cof+eq}]-> 8_epi_inunolide;  // 8-epi-inunolide synthase

  germacra_1_10_4_11_13_trien_12_oate
    -R[node12411: 1.14.14.168 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52563, ev=cof+eq}]-> 8beta_hydroxygermacra_1_10_4_11_13_trien_12_oate  // germacrene A acid 8beta-hydroxylase
    -[node12429: 1.14.14.169 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52565, ev=cof+eq}]-> 6alpha_8beta_dihydroxygermacra_1_10_4_11_13_trien_12_oate  // eupatolide synthase
    -L[node12422: 1.14.14.169 | +H2O ^L {br=BR52566, ev=cof+eq}]-> eupatolide;  // eupatolide synthase
