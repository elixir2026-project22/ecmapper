  compound 6alpha_8beta_dihydroxygermacra_1_10_4_11_13_trien_12_oate '6alpha,8beta-dihydroxygermacra-1(10),4,11(13)-trien-12-oate' brenda:228392 kegg:C22050;
  compound 6alpha_hydroxygermacra_1_10_4_11_13_trien_12_oate '6alpha-hydroxygermacra-1(10),4,11(13)-trien-12-oate' brenda:224867 kegg:C21922;
