pwl 2.0;
subsystem methylglyoxal-degradation 'methylglyoxal degradation' {
  // BRENDA subsystem: 4 reactions (4 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound D_lactate 'D-lactate' brenda:600 kegg:C00256;
  compound GSH brenda:44 kegg:C00051;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound R_S_lactoyl_GSH '(R)-S-lactoyl-GSH' brenda:4458 kegg:C03451;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound methylglyoxal brenda:322 kegg:C00546;
  compound pyruvate brenda:31 kegg:C00022;
  port methylglyoxal side L to chorismate-metabolism;

  methylglyoxal
    -R[node2318: 4.2.1.130 | -H2O ^L {br=BR49777, ev=cof-eq, match=kegg}]-> D_lactate  // D-lactate dehydratase
    -[node3883: 1.1.2.4 | -2*ferricytochrome_c, +2*H, +2*ferrocytochrome_c {br=BR36726, ev=cof+eq}]-> pyruvate;  // D-lactate dehydrogenase (cytochrome)

  methylglyoxal
    -R[node3888: 4.4.1.5 | -GSH ^R {br=BR6441, ev=cof-eq, match=kegg}]-> R_S_lactoyl_GSH  // lactoylglutathione lyase
    -L[node3885: 3.1.2.6 | -H2O, +GSH ^L {br=BS364477, ev=cof+eq}]-> D_lactate;  // hydroxyacylglutathione hydrolase
}
