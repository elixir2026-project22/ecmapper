pwl 2.0;
subsystem anapleurotic-synthesis-of-oxalacetate 'anapleurotic synthesis of oxalacetate' {
  // BRENDA subsystem: 1 reactions (1 with direction), 2 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound HCO3 brenda:195 kegg:C00288;
  compound Pi brenda:16 kegg:C00009;
  compound oxaloacetate brenda:57 kegg:C00036;
  compound pyruvate brenda:31 kegg:C00022;
  port oxaloacetate side D to citric-acid-cycle;
  port pyruvate side R to glycolysis;

  pyruvate
    -[node9160: 6.4.1.1 | ATP>ADP, -H, -HCO3, +Pi {br=BR153, ev=cof+eq}]-> oxaloacetate;  // pyruvate carboxylase
}
