    -[node5600: 4.1.1.50 | +CO2 ^R {br=BR310, ev=cof+eq, match=kegg}]-> S_adenosylmethioninamine;  // adenosylmethionine decarboxylase

  S_adenosyl_L_methionine
    -R[node11132: -> 2.5.1.B21 | -H2O, +H, +adenosine {br=BR49470, ev=cof+eq} || node5193: <- 2.5.1.6 | -ATP, -H2O, +Pi, +PPi {br=BR47590, ev=cof+eq}]- Met  // S-adenosyl-L-methionine hydroxide adenosyltransferase; methionine adenosyltransferase
    -[node5185: 4.4.1.11 | -H2O, +2OBUT, +NH3 ^R {br=BR3437, ev=cof+eq}]-> Methanethiol;  // methionine gamma-lyase

  Met
    -R[node5568: 2.6.1.57 | -phenylpyruvate, +Phe_L104 {br=BS353571, ev=cof-eq, match=single} || node5572: 1.4.3.2 | -O2, -H2O, +H2O2, +NH3 {br=BS259010, ev=cof+eq, match=kegg} || node5784: 2.6.1.88 | -a_2_oxo_carboxylate_L9381, +an_L_amino_acid {br=BR49829, ev=cof+eq, match=kegg}]-> 4_Methylthio_2_oxobutanoate  // aromatic-amino-acid transaminase; L-amino-acid oxidase; methionine transaminase
    -L[node5777: 4.1.1.80/4.1.1.72/4.1.1.74/4.1.1.43/4.1.1.1 | +CO2 ^R]- 3_methylthiopropanal  // 4-hydroxyphenylpyruvate decarboxylase;branched-chain-2-oxoacid decarboxylase;indolepyruvate decarboxylase;phenylpyruvate decarboxylase;pyruvate decarboxylase
    -[node5780: 1.1.1.1 | NADH>NAD ^R]- 3_methylthio_propanol;  // alcohol dehydrogenase

  S_methyl_5_thio_alpha_D_Rib_1_P
    <-L[node5605: 2.4.2.28 | -Pi, +adenine {br=BR47472, ev=cof+eq}]- S_methyl_5_thioadenosine  // S-methyl-5'-thioadenosine phosphorylase
    -L[node5596: 3.2.2.16 | -H2O, +adenine {br=BR19228, ev=cof+eq}]-> S_methyl_5_thio_Rib  // methylthioadenosine nucleosidase
    -L[node5592: 2.7.1.100 | ATP>ADP ^R {br=BR47714, ev=cof+eq}]-> S_methyl_5_thio_alpha_D_Rib_1_P  // S-methyl-5-thioribose kinase
    -[node5590: 5.3.1.23 {br=BR230, ev=eq}]-> S_methyl_5_thio_Rul_1_P  // S-methyl-5-thioribose-1-phosphate isomerase
    -L[node5587: 4.2.1.109 | +H2O ^R {br=BR48756, ev=cof+eq, match=kegg}]-> 5_methylthio_2_3_dioxopentyl_phosphate  // methylthioribulose 1-phosphate dehydratase
    -[node5584: 3.1.3.77 {br=BR48754, ev=eq, match=kegg}]-> 1Z_2_hydroxy_5_methylsulfanyl_3_oxopent_1_en_1_yl_phosphate  // acireductone synthase
    -B[node5581: 3.1.3.77 | -H2O, +Pi ^R {br=BR48755, ev=cof+eq, match=kegg}]-> 1_2_dihydroxy_5_methylthio_pent_1_en_3_one  // acireductone synthase
    -[node5577: 1.13.11.54 | -O2, +formate ^L {br=BR48660, ev=cof+eq, match=kegg}]-> 4_Methylthio_2_oxobutanoate;  // acireductone dioxygenase [iron(II)-requiring]

  L_methionine_R_sulfoxide
    -B[node10869: 1.8.4.12 | -thioredoxin, +thioredoxin_disulfide ^L {br=BR48616, ev=cof+eq}]-> Met;  // peptide-methionine (R)-S-oxide reductase

  (succinyl_CoA + homoserine) -[node5217: 2.3.1.46 | +CoA {br=BR44047, ev=cof+eq}]-> O_succinyl_L_homoserine;  // homoserine O-succinyltransferase
  (O_phospho_homoSer + Cys) -[node5003: 2.5.1.48 | +Pi {br=BS354338, ev=cof+eq}]-> L_cystathionine;  // cystathionine gamma-synthase
  (Met + tRNAMet) -[node2601: 6.1.1.10 | ATP>AMP, +PPi {br=BR40, ev=cof+eq}]-> L_methionyl_tRNAMet;  // Methionine-tRNA ligase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { L_homocysteine Met S_adenosyl_L_methionine S_adenosyl_L_homocysteine S_ribosyl_L_homocysteine };
