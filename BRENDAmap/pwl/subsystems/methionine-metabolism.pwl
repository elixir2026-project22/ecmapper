  port S_methyl_5_thioadenosine side D to polyamine-pathway;
  port glycine_betaine side R to glycine-betaine-biosynthesis;
  port homoserine side L to threonine-metabolism;
  port succinyl_CoA side L to citric-acid-cycle;

