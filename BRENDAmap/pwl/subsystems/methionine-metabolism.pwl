    chord (S_adenosyl_L_methionine + L_homocysteine) -[node5196: 2.1.1.10/2.1.1.13 {br=BS289526, ev=eq}]-> (S_adenosyl_L_homocysteine + Met);  // homocysteine S-methyltransferase;methionine synthase
