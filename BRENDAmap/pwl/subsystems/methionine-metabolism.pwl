      -R[node5201: -> 2.1.1.13 | -5_methyltetrahydrofolate, +6S_THFA {br=BR40552, ev=cof+eq} || node5204: 2.1.1.14 | -5_6_7_8_tetrahydropteroyl_tri_L_glutamate, -5_Me_tetrahydropteroyl_L_Glu_3 {br=BR40568, ev=conflict}]- Met;  // methionine synthase; 5-methyltetrahydropteroyltriglutamate-homocysteine S-methyltransferase
