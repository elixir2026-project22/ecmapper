    <-L[node5000: 3.13.2.1 | -H2O, +adenosine {br=BR16046, ev=cof+eq}]- S_adenosyl_L_homocysteine  // adenosylhomocysteinase
    -R[node6919: 3.2.2.9 | -H2O, +adenine ^L {br=BR19231, ev=cof+eq, match=kegg}]-> S_ribosyl_L_homocysteine  // adenosylhomocysteine nucleosidase
    -B[node6923: 4.4.1.21 | +DHPTD ^R {br=BS371157, ev=eq, match=kegg}]-> L_homocysteine;  // S-ribosylhomocysteine lyase

  S_adenosyl_L_homocysteine
    -L[node6918: 2.1.1.- | -demethylated_methyl_acceptor, +methylated_methyl_acceptor || node5188: <- 2.1.1.37 | -DNA, +DNA_containing_5_methylcytosine {br=BS319681, ev=cof+eq}]- S_adenosyl_L_methionine  // unknown; DNA (cytosine-5-)-methyltransferase
    -L[node11117: 2.5.1.43 | +3*S_methyl_5_thioadenosine ^L {br=BR47667, ev=cof+eq}]-> nicotianamine;  // nicotianamine synthase

