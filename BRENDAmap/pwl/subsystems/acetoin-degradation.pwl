pwl 2.0;
subsystem acetoin-degradation 'acetoin degradation' {
  // BRENDA subsystem: 8 reactions (8 with direction), 8 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound R_acetoin '(R)-acetoin' brenda:4876;
  compound S_2_acetolactate '(S)-2-acetolactate' brenda:10817;
  compound S_S_butane_2_3_diol '(S,S)-butane-2,3-diol' brenda:44987;
  compound S_acetoin '(S)-acetoin' brenda:8210;
  compound acetaldehyde brenda:90 kegg:C00084;
  compound diacetyl brenda:746 kegg:C00741;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  port pyruvate side R to glycolysis;

  pyruvate
    -R[node9279: 2.2.1.6 | -H, +CO2 ^R {br=BR37100, ev=cof+eq}]-> S_2_acetolactate  // acetolactate synthase
    -L[node9906: 4.1.1.5 | +CO2 ^L {br=BR309, ev=cof+eq, match=kegg}]-> R_acetoin  // Acetolactate decarboxylase
    <-L[node2721: 1.1.1.4 | NAD>NADH ^L {br=BR26052, ev=cof+eq}]- S_S_butane_2_3_diol;  // (R,R)-butanediol dehydrogenase

  S_2_acetolactate
    -[node9294: ~? | oxidized_electron_acceptor>reduced_electron_acceptor, +CO2 {br=BR52877, ev=cof+eq}]-> diacetyl  // spontaneous reaction
    -[node9913: 1.1.1.303 | NADH>NAD ^R {br=BR49222, ev=cof-eq}]-> R_acetoin;  // diacetyl reductase [(R)-acetoin forming]

  diacetyl
    -[node2986: 1.1.1.304 | NADH>NAD ^R {br=BR49223, ev=cof-eq}]-> S_acetoin  // diacetyl reductase [(S)-acetoin forming]
    <-R[node11946: 1.1.1.76 | NAD>NADH ^R {br=BR36721, ev=cof+eq}]- S_S_butane_2_3_diol#2;  // (S,S)-butanediol dehydrogenase

  (S_acetoin + R_acetoin) -[node8785: 2.3.1.190 | CoA>Ac_CoA, NAD>NADH {br=BR49227, ev=cof+eq}]-> acetaldehyde;  // acetoin dehydrogenase system
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node11946 node2721 node8785 } backward { node2986 node9913 };
}
