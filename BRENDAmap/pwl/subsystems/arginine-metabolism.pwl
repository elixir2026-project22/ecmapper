pwl 2.0;
subsystem arginine-metabolism 'arginine metabolism' {
  // BRENDA subsystem: 31 reactions (28 with direction), 28 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 2_oxo_5_guanidinopentanoate '2-oxo-5-guanidinopentanoate' brenda:7997 kegg:C03771;
  compound 3S_3_hydroxy_L_arginine '(3S)-3-hydroxy-L-arginine' brenda:89250 kegg:C18473;
  compound 4_Guanidinobutyraldehyde '4-Guanidinobutyraldehyde' brenda:4209;
  compound 4_Guanidinobutyramide '4-Guanidinobutyramide' brenda:91696;
  compound 4_Guanidinobutyrate '4-Guanidinobutyrate' brenda:3442 kegg:C01035;
  compound 4_aminobutanoate '4-aminobutanoate' brenda:597 kegg:C00334;
  compound 5_amino_2_oxopentanoate '5-amino-2-oxopentanoate' brenda:8022 kegg:C01110;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound Ala brenda:103 kegg:C00041;
