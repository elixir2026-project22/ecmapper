pwl 2.0;
subsystem creatinine-degradation 'creatinine degradation' {
  // BRENDA subsystem: 8 reactions (8 with direction), 9 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 5_10_methylenetetrahydrofolate '5,10-methylenetetrahydrofolate' brenda:401 kegg:C00143;
  compound 5_6_7_8_tetrahydrofolate '5,6,7,8-tetrahydrofolate' brenda:5495 kegg:C00101;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CH2O brenda:130 kegg:C00067;
  compound CO2 brenda:28 kegg:C00011;
  compound Creatine brenda:433 kegg:C00300;
  compound Gly brenda:72 kegg:C00037;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound NH3 brenda:27;
  compound N_N_dimethylglycine 'N,N-dimethylglycine' brenda:1240 kegg:C01026;
  compound N_carbamoylsarcosine 'N-carbamoylsarcosine' brenda:8149 kegg:C01043;
  compound N_methylhydantoin 'N-methylhydantoin' brenda:12616 kegg:C02565;
  compound O2 brenda:9 brenda:1180;
  compound Pi brenda:16 kegg:C00009;
  compound creatinine brenda:2015 kegg:C00791;
  compound electron_transfer_flavoprotein 'electron-transfer flavoprotein' brenda:1601 kegg:C04253;
  compound reduced_electron_transfer_flavoprotein 'reduced electron-transfer flavoprotein' brenda:2112 kegg:C04570;
  compound sarcosine brenda:594 kegg:C00213;
  compound urea brenda:116 kegg:C00086;
  port Gly#2 side L to threonine-metabolism;
  port N_N_dimethylglycine side R to methionine-metabolism;
  port urea side D to urea-cycle;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    Creatine
      <-B[node7407: 3.5.2.10 {br=BR19257, ev=eq}]- creatinine  // creatininase
      -B[node7420: 3.5.4.21 | -H2O, +NH3 ^L {br=BR29524, ev=cof+eq}]-> N_methylhydantoin  // creatinine deaminase
      -[node7429: 3.5.2.14 | ATP>ADP, -2*H2O, +H, +Pi {br=BR26104, ev=cof+eq}]-> N_carbamoylsarcosine  // N-methylhydantoinase (ATP-hydrolysing)
      -[node7431: 3.5.1.59 | -H, -H2O, +NH3, +CO2 {br=BR22703, ev=cof+eq}]-> sarcosine;  // N-carbamoylsarcosine amidase
    Creatine -[node7418: 3.5.3.3 | -H2O {br=BR29522, ev=cof+eq}]-> (urea + sarcosine);  // creatinase
  }

  sarcosine
    -R[node7416: 1.5.8.3 | -electron_transfer_flavoprotein, -H2O, +reduced_electron_transfer_flavoprotein, +CH2O {br=BR36913, ev=cof+eq}]-> Gly#2;  // sarcosine dehydrogenase

  N_N_dimethylglycine
    -R[node7574: 1.5.8.4 | -electron_transfer_flavoprotein, -5_6_7_8_tetrahydrofolate, +reduced_electron_transfer_flavoprotein, +5_10_methylenetetrahydrofolate {br=BR36914, ev=cof+eq}]-> sarcosine;  // dimethylglycine dehydrogenase

  sarcosine -[node7414: 1.5.3.1 | -O2, -H2O, +CH2O, +H2O2 {br=BR36905, ev=cof+eq}]-> (Gly + Gly#2);  // sarcosine oxidase (formaldehyde-forming)
}
