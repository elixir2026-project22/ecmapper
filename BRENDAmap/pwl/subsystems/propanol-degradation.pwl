pwl 2.0;
subsystem propanol-degradation 'propanol degradation' {
  // BRENDA subsystem: 9 reactions (6 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound AcAc brenda:419 kegg:C00164;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPAP brenda:10758 kegg:C02876;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound acetate brenda:47 kegg:C00033;
  compound acetoacetyl_CoA 'acetoacetyl-CoA' brenda:187 kegg:C00332;
  compound acetone brenda:333 kegg:C00207;
  compound isopropanol brenda:958 kegg:C01845;
  compound propanal brenda:328;
  compound propanoate brenda:949 kegg:C00163;
  compound propanol brenda:976 kegg:C05979;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  port propanoyl_CoA side R to valine-metabolism;

  propanal
    -L[node3754: 1.2.1.3 | NAD>NADH, -H2O {br=BS189122, ev=cof+eq, match=kegg}]-> propanoate  // aldehyde dehydrogenase (NAD+)
    -R[node3744: 6.2.1.1 | ATP>AMP, -CoA, +PPi {br=BR68, ev=cof+eq} || node7540: 2.8.3.1 | -Ac_CoA, +acetate {br=BR48124, ev=cof+eq}]-> propanoyl_CoA;  // acetate-CoA ligase; propionate CoA-transferase

  propanal
    -[node1969: 1.2.1.87 | +NAD, +H, +CoA, +NADH {br=BR50602, ev=conflict}]- propanoyl_CoA#2  // propanal dehydrogenase (CoA-propanoylating)
    -[node1967: 2.3.1.222 | -CoA, -Pi ^R {br=BR50416, ev=conflict}]- PPAP;  // phosphate propanoyltransferase

  propanal
    -[node3746: 1.1.1.1 | NAD>NADH ^L]- propanol;  // alcohol dehydrogenase

  isopropanol
    -R[node7383: 1.1.1.80 | NADP>NADPH ^L {br=BR29340, ev=cof+eq, match=kegg}]-> acetone  // isopropanol dehydrogenase (NADP+)
    -[node3738: 6.4.1.6 | ATP>AMP, -CO2, -2*H2O, +2*Pi {br=BR33815, ev=cof+eq}]-> AcAc  // acetone carboxylase
    -[node3731: 2.8.3.8 | -Ac_CoA, +acetate ^L {br=BS358821, ev=cof-eq}]-> acetoacetyl_CoA;  // acetate CoA-transferase
}
