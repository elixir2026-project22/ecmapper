  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound baccatin_III 'baccatin III' brenda:11190 kegg:C11900;
  compound benzoyl_CoA 'benzoyl-CoA' brenda:394 kegg:C00512;
  compound geranylgeranyl_diphosphate 'geranylgeranyl diphosphate' brenda:231 kegg:C00353;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  compound taxa_4_11_diene 'taxa-4,11-diene' brenda:9605 kegg:C11894;
  compound taxa_4_20_11_dien_5alpha_13alpha_diol 'taxa-4(20),11-dien-5alpha,13alpha-diol' brenda:50297;
  compound taxa_4_20_11_dien_5alpha_ol 'taxa-4(20),11-dien-5alpha-ol' brenda:6160 kegg:C11895;
  compound taxa_4_20_11_dien_5alpha_yl_acetate 'taxa-4(20),11-dien-5alpha-yl acetate' brenda:21896 kegg:C11896;
