    -[node1326: 1.14.14.105 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR40410, ev=cof+eq}]-> 10beta_hydroxytaxa_4_20_11_dien_5alpha_yl_acetate  // taxane 10beta-hydroxylase
    -L[node12131: 1.14.13.146 | NADPH>NADP, -O2, -H, +H2O {br=BR49981, ev=cof+eq}]-> 10beta_14beta_dihydroxytaxa_4_20_11_dien_5alpha_yl_acetate;  // taxoid 14beta-hydroxylase

  taxa_4_20_11_dien_5alpha_ol
    -L[node12135: 1.14.14.106 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR40518, ev=cof+eq}]-> taxa_4_20_11_dien_5alpha_13alpha_diol;  // taxane 13alpha-hydroxylase

  10beta_hydroxytaxa_4_20_11_dien_5alpha_yl_acetate
    -[node1310: ?]- 10_deacetyl_2_debenzoylbaccatin_III  // hypothetical multistep reaction
    -[node1307: 2.3.1.166 | -benzoyl_CoA, +CoA ^L {br=BR40586, ev=cof+eq}]-> 10_deacetylbaccatin_III  // 2alpha-hydroxytaxane 2-O-benzoyltransferase
    -[node12101: 2.3.1.167 | -Ac_CoA, +CoA ^L {br=BR44014, ev=cof+eq}]-> baccatin_III;  // 10-deacetylbaccatin III 10-O-acetyltransferase

  3_N_debenzoyl_2_deoxytaxol
    -[node12118: 1.14.14.- | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O]- 3_N_debenzoyltaxol  // beta-phenylalanoyl baccatin III-2'-hydroxylase
    -[node12121: 2.3.1.- | -benzoyl_CoA, +CoA ^L]- taxol;  // 3'-N-debenzoyl-2'-deoxytaxol N-benzoyltransferase

