  port 3_amino_3_phenylpropanoyl_CoA side R to phenylalanine-metabolism;

  geranylgeranyl_diphosphate
    -[node1341: 4.2.3.17 | +PPi ^L {br=BR44341, ev=cof+eq}]-> taxa_4_11_diene  // taxadiene synthase
    -[node1337: 1.14.14.176 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR40524, ev=cof+eq}]-> taxa_4_20_11_dien_5alpha_ol  // taxadiene 5alpha-hydroxylase
