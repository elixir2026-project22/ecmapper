pwl 2.0;
subsystem ethanol-fermentation 'ethanol fermentation' {
  // BRENDA subsystem: 4 reactions (4 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound ETOH brenda:69 kegg:C00469;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound acetaldehyde brenda:90 kegg:C00084;
  compound formate brenda:120 kegg:C00058;
  compound pyruvate brenda:31 kegg:C00022;
  port acetaldehyde side L to acetate-fermentation;
  port acetaldehyde side L to phenol-degradation;
  port pyruvate side R to glycolysis;

  pyruvate
    -[node9436: 4.1.1.1 | -H, +CO2 ^L {br=BS1601, ev=cof+eq}]-> acetaldehyde  // Pyruvate decarboxylase
    -[node9782: 1.1.1.1 | NADH>NAD ^L {br=BS139564, ev=cof-eq, match=similar}]-> ETOH;  // alcohol dehydrogenase

  pyruvate
    -[node9777: 2.3.1.54 | -CoA, +formate ^R {br=BR44056, ev=cof-eq}]-> Ac_CoA  // formate C-acetyltransferase
    -L[node9769: 1.2.1.10 | NADH>NAD, +CoA {br=BR36771, ev=cof-eq}]-> acetaldehyde;  // acetaldehyde dehydrogenase (acetylating)
}
