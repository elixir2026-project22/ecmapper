pwl 2.0;
subsystem phosphatidylethanolamine-bioynthesis 'phosphatidylethanolamine bioynthesis' {
  // BRENDA subsystem: 14 reactions (13 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 1_2_diacyl_sn_glycerol '1,2-diacyl-sn-glycerol' brenda:2063;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CDP_choline 'CDP-choline' brenda:1216 kegg:C00307;
  compound CDP_diacylglycerol 'CDP-diacylglycerol' brenda:1248 kegg:C00269;
  compound CDP_ethanolamine 'CDP-ethanolamine' brenda:1604 kegg:C00570;
  compound CMP brenda:100 kegg:C00055;
  compound CO2 brenda:28 kegg:C00011;
  compound CTP brenda:60 kegg:C00063;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound PE brenda:513 kegg:C00350;
  compound PPi brenda:17 kegg:C00013;
  compound Ptd_L_Ser 'Ptd-L-Ser' brenda:30588 kegg:C02737;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound Ser brenda:95 kegg:C00065;
  compound acetaldehyde brenda:90 kegg:C00084;
  compound choline brenda:149 kegg:C00114;
  compound ethanolamine brenda:456 kegg:C00189;
  compound phosphatidyl_N_N_dimethylethanolamine 'phosphatidyl-N,N-dimethylethanolamine' brenda:20464;
  compound phosphatidyl_N_methylethanolamine 'phosphatidyl-N-methylethanolamine' brenda:15918 kegg:C01241;
  compound phosphatidylcholine brenda:215 kegg:C00157;
  compound phosphocholine brenda:748 kegg:C00588;
  compound phosphoethanolamine brenda:1797 kegg:C00346;
  compound trimethylamine brenda:734 kegg:C00565;
  port CDP_diacylglycerol side L to CDP-diacylglycerol-biosynthesis;
  port PE side L to cardiolipin-biosynthesis;
  port phosphatidylcholine side D to lipid-metabolism;

  CDP_diacylglycerol
    -[node9850: 2.7.8.8 | -Ser, +CMP ^L {br=BR47912, ev=cof+eq, match=single}]-> Ptd_L_Ser  // CDP-diacylglycerol-serine O-phosphatidyltransferase
    -[node9921: 4.1.1.65 | +CO2 ^L {br=BR326, ev=cof+eq, match=kegg}]-> PE  // phosphatidylserine decarboxylase
    -L[node2162: 2.1.1.17 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine {br=BR43883, ev=cof+eq}]-> phosphatidyl_N_methylethanolamine  // phosphatidylethanolamine N-methyltransferase
    -R[node2160: 2.1.1.71 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR43914, ev=cof+eq, match=single}]-> phosphatidyl_N_N_dimethylethanolamine  // phosphatidyl-N-methylethanolamine N-methyltransferase
    -[node2158: 2.1.1.71 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BS319863, ev=cof+eq}]-> phosphatidylcholine  // phosphatidyl-N-methylethanolamine N-methyltransferase
    <-[node2156: 2.7.8.2 | -1_2_diacyl_sn_glycerol, +CMP ^R {br=BR47989, ev=cof+eq, match=single}]- CDP_choline  // diacylglycerol cholinephosphotransferase
    <-[node2154: 2.7.7.15 | -CTP, +PPi ^R {br=BR47864, ev=cof+eq}]- phosphocholine  // choline-phosphate cytidylyltransferase
    <-[node2152: 2.7.1.32 | ATP>ADP ^R {br=BR47772, ev=cof+eq}]- choline  // choline kinase
    -[node2020: 4.3.99.4 | +acetaldehyde ^L {br=BR50480, ev=cof+eq}]-> trimethylamine;  // choline trimethylamine-lyase

  choline
    -B[node2150: 2.7.8.24 | CDP_diacylglycerol>CMP ^L {br=BR37018, ev=cof+eq}]-> phosphatidylcholine;  // phosphatidylcholine synthase

  Ser
    -B[node2129: 4.1.1.- | -H, +CO2 ^L]- ethanolamine  // serine decarboxylase
    -[node2164: 2.7.1.82 | ATP>ADP ^L {br=BR47808, ev=cof+eq, match=kegg}]-> phosphoethanolamine  // ethanolamine kinase
    -[node2166: 2.7.7.14 | -CTP, +PPi ^L {br=BR47863, ev=cof+eq, match=kegg}]-> CDP_ethanolamine  // ethanolamine-phosphate cytidylyltransferase
    -[node2168: 2.7.8.1 | -1_2_diacyl_sn_glycerol, +CMP ^L {br=BR47990, ev=cof+eq, match=single}]-> PE;  // ethanolaminephosphotransferase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { choline phosphatidylcholine } bypasses { choline phosphocholine CDP_choline phosphatidylcholine };
