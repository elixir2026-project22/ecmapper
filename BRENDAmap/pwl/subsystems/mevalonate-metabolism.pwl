pwl 2.0;
subsystem mevalonate-metabolism 'mevalonate metabolism' {
  // BRENDA subsystem: 17 reactions (15 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 3_5_diphosphomevalonate '3,5-diphosphomevalonate' brenda:195022;
  compound 3_phosphomevalonate '3-phosphomevalonate' brenda:194835 kegg:C20847;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound N6_dimethylallyl_adenosine_5_diphosphate 'N6-(dimethylallyl)adenosine 5\'-diphosphate' brenda:63309 kegg:C16426;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound R_5_diphosphomevalonate '(R)-5-diphosphomevalonate' brenda:3769 kegg:C01143;
  compound R_5_phosphomevalonate '(R)-5-phosphomevalonate' brenda:3371 kegg:C01107;
  compound R_mevalonate '(R)-mevalonate' brenda:1361 kegg:C00418;
  compound S_3_hydroxy_3_methylglutaryl_CoA '(S)-3-hydroxy-3-methylglutaryl-CoA' brenda:1835 kegg:C00356;
  compound acetoacetyl_CoA 'acetoacetyl-CoA' brenda:187 kegg:C00332;
  compound dimethylallyl_PP 'dimethylallyl-PP' brenda:157;
  compound isopentenyl_PP 'isopentenyl-PP' brenda:113 kegg:C00129;
  compound isopentenyl_phosphate 'isopentenyl phosphate' brenda:4149 kegg:C20345;
  compound isoprene brenda:59615 kegg:C16521;
  port Ac_CoA side R to oxidative-decarboxylation-of-pyruvate;
  port dimethylallyl_PP side L to isoprenoid-biosynthesis;
  port isopentenyl_PP side L to isoprenoid-biosynthesis;

  // ring: cycle of the drawing (7 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    isopentenyl_PP
      <-B[node8789: 4.1.1.33 | ATP>ADP, +CO2, +Pi {br=BR292, ev=cof+eq}]- R_5_diphosphomevalonate  // Diphosphomevalonate decarboxylase
      <-[node8788: 2.7.4.2 | ATP>ADP ^L {br=BR48074, ev=cof+eq}]- R_5_phosphomevalonate  // phosphomevalonate kinase
      <-[node6683: 2.7.1.36 | ATP>ADP ^L {br=BR47775, ev=cof+eq}]- R_mevalonate  // mevalonate kinase
      -B[node2430: 2.7.1.185 | ATP>ADP ^L {br=BR51126, ev=cof+eq}]-> 3_phosphomevalonate  // mevalonate 3-kinase
      -[node2428: 2.7.1.186 | ATP>ADP ^L {br=BR51127, ev=cof+eq}]-> 3_5_diphosphomevalonate  // mevalonate-3-phosphate 5-kinase
      -[node11184: 4.1.1.110 {br=BR52424, ev=eq}]-> isopentenyl_phosphate  // bisphosphomevalonate decarboxylase
      -[node6694: 2.7.4.26 | ATP>ADP, +H {br=BR50003, ev=cof+eq}]-> isopentenyl_PP;  // isopentenyl phosphate kinase
    chord R_5_phosphomevalonate -[node6695: 4.1.1.99 | ATP>ADP, +CO2, +Pi {br=BR51139, ev=cof+eq}]-> isopentenyl_phosphate;  // phosphomevalonate decarboxylase
  }

  Ac_CoA
    -[node6674: 2.3.1.9 | +CoA ^R {br=BR44092, ev=cof+eq}]-> acetoacetyl_CoA  // acetyl-CoA C-acetyltransferase
    -[node6687: 2.3.3.10 | Ac_CoA>CoA, -H2O, +H {br=BR44119, ev=cof+eq}]-> S_3_hydroxy_3_methylglutaryl_CoA  // hydroxymethylglutaryl-CoA synthase
    -[node3312: <- 1.1.1.88 | 2*NAD>2*NADH, -CoA {br=BS188686, ev=cof+eq} || node6678: <-> 1.1.1.34 | 2*NADPH>2*NADP, +CoA {br=BR29297, ev=cof-eq, rev=eq} || node11058: 1.1.1.B38 | NADPH>NADP, +CoA || node79: 1.1.1.B38 | NADH>NAD, +CoA]- R_mevalonate;  // hydroxymethylglutaryl-CoA reductase; hydroxymethylglutaryl-CoA reductase (NADPH); hydroxymethylglutaryl-CoA reductase [NAD(P)H]; hydroxymethylglutaryl-CoA reductase [NAD(P)H]

  isopentenyl_PP
    -R[node6693: 5.3.3.2 {br=BR247, ev=eq}]-> dimethylallyl_PP  // isopentenyl-diphosphate DELTA-isomerase
    -L[node11689: 2.5.1.112 | -ADP, +PPi ^L {br=BR50802, ev=cof+eq}]-> N6_dimethylallyl_adenosine_5_diphosphate;  // adenylate dimethylallyltransferase (ADP/ATP-dependent)

  dimethylallyl_PP -[node12371: 4.2.3.27 {br=BR48809, ev=eq}]-> (PPi + isoprene);  // isoprene synthase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node3312 } backward { node79 };
}
