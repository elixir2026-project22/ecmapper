pwl 2.0;
subsystem fumitremorgin-biosynthesis 'fumitremorgin biosynthesis' {
  // BRENDA subsystem: 9 reactions (8 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 12alpha_13alpha_dihydroxyfumitremorgin_C '12alpha,13alpha-dihydroxyfumitremorgin C' brenda:15352 kegg:C20605;
  compound 2OG brenda:34 kegg:C00026;
  compound 6_hydroxytryprostatin_B '6-hydroxytryprostatin B' brenda:10404 kegg:C20513;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound Pro brenda:243 kegg:C00148;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound Trp brenda:119 kegg:C00078;
  compound acceptor brenda:66 brenda:3161;
  compound brevianamide_F 'brevianamide F' brenda:6395 kegg:C20563;
  compound dimethylallyl_PP 'dimethylallyl-PP' brenda:157;
  compound fumitremorgin_A 'fumitremorgin A' brenda:88402 kegg:C20564;
  compound fumitremorgin_B 'fumitremorgin B' brenda:10414 kegg:C20630;
  compound fumitremorgin_C 'fumitremorgin C' brenda:17703 kegg:C20604;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound succinate brenda:58 kegg:C00042;
  compound tryprostatin_A 'tryprostatin A' brenda:28978 kegg:C20607;
  compound tryprostatin_B 'tryprostatin B' brenda:19694 kegg:C20512;
  compound verruculogen brenda:19695 kegg:C20045;
  port Pro side U to proline-metabolism;
  port Trp side R to tryptophan-metabolism;

  brevianamide_F
    -[node11741: 2.5.1.106 | -dimethylallyl_PP, +PPi {br=BR50540, ev=cof+eq}]-> tryprostatin_B  // tryprostatin B synthase
    -[node11746: 1.14.14.118 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50525, ev=cof+eq}]-> 6_hydroxytryprostatin_B  // tryprostatin B 6-hydroxylase
    -[node11757: 2.1.1.293 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR50795, ev=cof+eq}]-> tryprostatin_A  // 6-hydroxytryprostatin B O-methyltransferase
    -[node11745: 1.14.19.71 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +2*H2O {br=BR50590, ev=cof+eq}]-> fumitremorgin_C  // fumitremorgin C synthase
    -B[node11758: 1.14.14.119 | 2*reduced_NADPH_hemoprotein_reductase>2*oxidized_NADPH_hemoprotein_reductase, -2*O2, +2*H2O {br=BR50576, ev=cof+eq}]-> 12alpha_13alpha_dihydroxyfumitremorgin_C  // fumitremorgin C monooxygenase
    -[node11764: 2.5.1.110 | -dimethylallyl_PP, +PPi {br=BR50670, ev=cof+eq}]-> fumitremorgin_B  // 12alpha,13alpha-dihydroxyfumitremorgin C prenyltransferase
    -[node11768: 1.14.11.38 | reduced_acceptor>acceptor, -2OG, -2*O2, +succinate, +CO2, +H2O {br=BR50568, ev=cof+eq}]-> verruculogen  // verruculogen synthase
    <-[node11775: 2.5.1.107 | -PPi, +dimethylallyl_PP {br=BR50541, ev=cof-eq}]- fumitremorgin_A;  // verruculogen prenyltransferase

  react [node11735: 6.3.3.- | ATP>ADP, +Pi, +H] {Trp, brevianamide_F, Pro};  // brevianamide F synthase
}
