pwl 2.0;
subsystem myo-inositol-biosynthesis 'myo-inositol biosynthesis' {
  // BRENDA subsystem: 11 reactions (10 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1D_myo_Ins_hexakisphosphate '1D-myo-Ins hexakisphosphate' brenda:220 kegg:C01204;
  compound 1L_myo_inositol_1_phosphate '1L-myo-inositol 1-phosphate' brenda:5892 kegg:C04006;
  compound 1_L_myo_inositol_1_2_4_5_6_pentakisphosphate '1-L-myo-inositol 1,2,4,5,6-pentakisphosphate' brenda:103932;
  compound 2_Keto_myo_inositol '2-Keto-myo-inositol' brenda:29396;
  compound 3_5_4_trihydroxycyclohexa_1_2_dione '3,5/4-trihydroxycyclohexa-1,2-dione' brenda:97590 kegg:C04287;
  compound 5_dehydro_2_deoxy_D_gluconate '5-dehydro-2-deoxy-D-gluconate' brenda:30614 kegg:C06892;
  compound 5_deoxy_D_glucuronate '5-deoxy-D-glucuronate' brenda:29168 kegg:C16737;
  compound 6_phospho_5_dehydro_2_deoxy_D_gluconate '6-phospho-5-dehydro-2-deoxy-D-gluconate' brenda:20071 kegg:C06893;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CDP_1L_myo_inositol 'CDP-1L-myo-inositol' brenda:27626 kegg:C19794;
  compound CMP brenda:100 kegg:C00055;
  compound CTP brenda:60 kegg:C00063;
  compound D_Glc_6_P 'D-Glc 6-P' brenda:105 kegg:C00092;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound bis_1L_myo_inositol_3_1_phosphate_1_phosphate 'bis(1L-myo-inositol) 3,1\'-phosphate 1-phosphate' brenda:81606 kegg:C19799;
  compound glycerone_phosphate 'glycerone phosphate' brenda:482 kegg:C00111;
  compound malonate_semialdehyde 'malonate semialdehyde' brenda:2969 kegg:C00222;
  compound myo_Ins 'myo-Ins' brenda:454 kegg:C00137;
  compound myo_inositol_phosphate 'myo-inositol phosphate' brenda:57633 kegg:C15585;
  port D_Glc_6_P side D to glycolysis;

  1D_myo_Ins_hexakisphosphate
    -R[node10303: 3.1.3.8 | -H2O, +Pi ^L {br=BR12745, ev=cof+eq, match=single}]-> 1_L_myo_inositol_1_2_4_5_6_pentakisphosphate;  // 3-phytase

  bis_1L_myo_inositol_3_1_phosphate_1_phosphate
    <-[node2457: 2.7.8.34 | -1L_myo_inositol_1_phosphate, +CMP ^R {br=BR49479, ev=cof+eq}]- CDP_1L_myo_inositol  // CDP-L-myo-inositol myo-inositolphosphotransferase
    <-[node2460: 2.7.7.74 | -CTP, +PPi ^R {br=BR49477, ev=cof+eq, match=single}]- myo_inositol_phosphate  // 1L-myo-inositol 1-phosphate cytidylyltransferase
    -B[node9300: 3.1.3.25 | -H2O, +Pi ^L {br=BR26031, ev=cof+eq}]-> myo_Ins  // inositol-phosphate phosphatase
    -[node10195: 1.1.1.18 | NAD>NADH ^L {br=BS187060, ev=cof+eq, match=single}]-> 2_Keto_myo_inositol  // inositol 2-dehydrogenase
    -[node11656: 4.2.1.44 | +H2O ^L {br=BS1987, ev=cof+eq, match=single}]-> 3_5_4_trihydroxycyclohexa_1_2_dione  // Myo-inosose-2 dehydratase
    <-[node11658: 3.7.1.22 | +H, +H2O ^L {br=BR50997, ev=cof-eq, match=single}]- 5_deoxy_D_glucuronate  // 3D-(3,5/4)-trihydroxycyclohexane-1,2-dione acylhydrolase (ring-opening)
    -L[node11660: 5.3.1.30 {br=BR51006, ev=eq}]-> 5_dehydro_2_deoxy_D_gluconate  // 5-deoxy-glucuronate isomerase
    -L[node1637: 2.7.1.92 | +ADP, +ATP ^L {br=BR47816, ev=conflict}]- 6_phospho_5_dehydro_2_deoxy_D_gluconate;  // 5-dehydro-2-deoxygluconokinase

  D_Glc_6_P
    -L[node9298: 5.5.1.4 {br=BR262, ev=eq, match=single}]-> myo_inositol_phosphate;  // inositol-3-phosphate synthase

  6_phospho_5_dehydro_2_deoxy_D_gluconate -[node1633: 4.1.2.29 {br=BR361, ev=eq, match=single}]-> (malonate_semialdehyde + glycerone_phosphate);  // 5-dehydro-2-deoxyphosphogluconate aldolase
}
