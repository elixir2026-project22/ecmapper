pwl 2.0;
subsystem kanosamine-biosynthesis-II 'kanosamine biosynthesis II' {
  // BRENDA subsystem: 3 reactions (2 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 3_dehydro_D_glucose_6_phosphate '3-dehydro-D-glucose 6-phosphate' brenda:28985 kegg:C20668;
  compound D_Glc_6_P 'D-Glc 6-P' brenda:105 kegg:C00092;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound Pi_L174005 'Pi' brenda:174005;
  compound kanosamine brenda:28801 kegg:C12212;
  compound kanosamine_6_phosphate 'kanosamine 6-phosphate' brenda:10405 kegg:C12213;
  port D_Glc_6_P side R to glycolysis;

  kanosamine_6_phosphate
    -[node11862: 3.1.3.92 | -H2O, +Pi_L174005 ^R {br=BR50762, ev=cof+eq}]-> kanosamine;  // kanosamine-6-phosphate phosphatase

  kanosamine_6_phosphate
    -[node11858: 2.6.1.104 | -2OG, -Glu {br=BR50964, ev=conflict}]- 3_dehydro_D_glucose_6_phosphate  // 3-dehydro-glucose-6-phosphate-glutamate transaminase
    -[node11853: 1.1.1.361 | NADH>NAD, -H {br=BR50739, ev=cof-eq}]-> D_Glc_6_P;  // glucose-6-phosphate 3-dehydrogenase
}
