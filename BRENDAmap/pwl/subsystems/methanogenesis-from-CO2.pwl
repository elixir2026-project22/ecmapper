pwl 2.0;
subsystem methanogenesis-from-CO2 'methanogenesis from CO2' {
  // BRENDA subsystem: 16 reactions (15 with direction), 19 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 5_10_Methylenetetrahydromethanopterin '5,10-Methylenetetrahydromethanopterin' brenda:4488 kegg:C04377;
  compound 5_10_methenyl_5_6_7_8_tetrahydromethanopterin '5,10-methenyl-5,6,7,8-tetrahydromethanopterin' brenda:5114 kegg:C04330;
  compound 5_6_7_8_tetrahydromethanopterin '5,6,7,8-tetrahydromethanopterin' brenda:3445 kegg:C01217;
  compound 5_6_7_8_tetrahydrosarcinapterin '5,6,7,8-tetrahydrosarcinapterin' brenda:26840 kegg:C18802;
  compound 5_formyl_5_6_7_8_tetrahydromethanopterin '5-formyl-5,6,7,8-tetrahydromethanopterin' brenda:23500 kegg:C01274;
  compound 5_methyl_5_6_7_8_tetrahydromethanopterin '5-methyl-5,6,7,8-tetrahydromethanopterin' brenda:20046 kegg:C04488;
  compound 7_8_dihydromethanopterin '7,8-dihydromethanopterin' brenda:47544 kegg:C05927;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CH2O brenda:130 kegg:C00067;
  compound CO2 brenda:28 kegg:C00011;
  compound CoM brenda:1614;
  compound F420_ox 'F420 (ox)' brenda:1665 kegg:C00876;
  compound F420_red 'F420 (red)' brenda:1244 kegg:C01080;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2 brenda:361 kegg:C00282;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound Pi brenda:16 kegg:C00009;
  compound a_quinol 'a quinol' brenda:2695;
  compound a_quinone 'a quinone' brenda:1992;
  compound formate brenda:120 kegg:C00058;
  compound formylmethanofuran brenda:2405;
  compound methanofuran brenda:8139;
  compound methyl_CoM 'methyl-CoM' brenda:3879 kegg:C03920;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound tetrahydromethanopterin brenda:9357 kegg:C01217;
  port CoM side L to coenzyme-M-biosynthesis;

  // ring: cycle of the drawing (11 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    5_formyl_5_6_7_8_tetrahydromethanopterin
      -B[node3582: 3.5.4.27 | -H, +H2O ^L {br=BR26119, ev=cof-eq}]-> 5_10_methenyl_5_6_7_8_tetrahydromethanopterin;  // methenyltetrahydromethanopterin cyclohydrolase
    a_quinone
      <-B[node11065: 1.1.99.B7 | oxidized_electron_acceptor>reduced_electron_acceptor ^L {br=BR50600, ev=cof+eq}]- a_quinol;  // menaquinol-acceptor oxidoreductase
    5_10_Methylenetetrahydromethanopterin
      -L[node3561: 1.5.98.2 | -F420_red, +F420_ox ^L {br=BR29453, ev=cof-eq, match=kegg}]-> 5_methyl_5_6_7_8_tetrahydromethanopterin;  // 5,10-methylenetetrahydromethanopterin reductase
    (CoM + 5_methyl_5_6_7_8_tetrahydromethanopterin) -[node3558: 7.2.1.4 {br=BR47637, ev=eq, match=kegg}]-> (methyl_CoM + tetrahydromethanopterin);  // tetrahydromethanopterin S-methyltransferase
    (tetrahydromethanopterin + formylmethanofuran) -[node3566: 2.3.1.101 | +methanofuran {br=BR43965, ev=cof+eq, match=kegg}]-> 5_formyl_5_6_7_8_tetrahydromethanopterin;  // formylmethanofuran-tetrahydromethanopterin N-formyltransferase
    (5_10_Methylenetetrahydromethanopterin + F420_ox) -[node11308: 1.5.98.1 {br=BR1328, ev=eq, match=kegg}]-> (F420_red + 5_10_methenyl_5_6_7_8_tetrahydromethanopterin);  // methylenetetrahydromethanopterin dehydrogenase
    (a_quinol + F420_ox) -[node11062: 1.1.98.4 {br=BR50599, ev=eq}]-> (a_quinone + F420_red);  // F420H2:quinone oxidoreductase
    chord F420_ox -[node8066: 1.12.98.1 | -H2 ^R {br=BR37035, ev=cof+eq}]-> F420_red;  // coenzyme F420 hydrogenase
    chord (5_10_Methylenetetrahydromethanopterin + F420_ox) -[node3571: 1.5.98.1 {br=BR1328, ev=eq, match=kegg}]-> (F420_red + 5_10_methenyl_5_6_7_8_tetrahydromethanopterin);  // methylenetetrahydromethanopterin dehydrogenase
    chord (H2 + 5_10_methenyl_5_6_7_8_tetrahydromethanopterin) -[node3580: 1.12.98.2 | +H {br=BR37005, ev=cof+eq, match=kegg}]-> 5_10_Methylenetetrahydromethanopterin;  // 5,10-methenyltetrahydromethanopterin hydrogenase
  }

  tetrahydromethanopterin
    -[node10938: 6.3.2.33 | ATP>ADP, -Glu, +Pi {br=BR49212, ev=cof+eq}]-> 5_6_7_8_tetrahydrosarcinapterin;  // tetrahydrosarcinapterin synthase

  tetrahydromethanopterin
    -B[node2219: <- 1.5.1.47 | NADPH>NADP, -H {br=BR50394, ev=cof-eq, match=kegg} || node2218: 1.5.99.15 | reduced_electron_acceptor>oxidized_electron_acceptor]- 7_8_dihydromethanopterin;  // dihydromethanopterin reductase [NAD(P)+]; dihydromethanopterin reductase (acceptor)

  5_6_7_8_tetrahydromethanopterin
    -[node11483: 4.2.1.147 | -CH2O, +H2O ^R {br=BR51000, ev=cof+eq}]-> 5_10_Methylenetetrahydromethanopterin;  // 5,6,7,8-tetrahydromethanopterin hydro-lyase

  formate
    -B[node11305: 1.17.98.3 | -F420_ox, +CO2 ^R {br=BR51102, ev=cof+eq}]-> F420_red;  // formate dehydrogenase (coenzyme F420)

  (methanofuran + CO2) -[node3574: 1.2.7.12 | Fd_red>Fd_ox, +H2O {br=BS413330, ev=cof+eq}]-> formylmethanofuran;  // Formylmethanofuran dehydrogenase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { 5_10_Methylenetetrahydromethanopterin 5_methyl_5_6_7_8_tetrahydromethanopterin tetrahydromethanopterin 5_formyl_5_6_7_8_tetrahydromethanopterin 5_10_methenyl_5_6_7_8_tetrahydromethanopterin };
  motif shunt { CoM methyl_CoM } bypasses { CoM tetrahydromethanopterin 5_formyl_5_6_7_8_tetrahydromethanopterin 5_10_methenyl_5_6_7_8_tetrahydromethanopterin 5_10_Methylenetetrahydromethanopterin 5_methyl_5_6_7_8_tetrahydromethanopterin methyl_CoM };
  motif carrier { oxidized_electron_acceptor reduced_electron_acceptor } forward { node11065 } backward { node2218 };
}
