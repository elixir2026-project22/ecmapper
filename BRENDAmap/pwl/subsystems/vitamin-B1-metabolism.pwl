    <-[node7597: 2.7.6.2 | ATP>AMP, +H {br=BR47855, ev=cof+eq}]- thiamine  // thiamine diphosphokinase
    -B[node6604: -> 2.7.1.89 | ATP>ADP {br=BR47814, ev=cof+eq} || node11238: <- 3.1.3.2 | -H2O, +Pi {br=BR51620, ev=cof+eq}]- TP;  // thiamine kinase; acid phosphatase

  (NAD + Gly) -[node11245: 2.4.2.60 | -ADP_thiazole_synthase_L_cysteine, +nicotinamide, +3*H2O, +ADP_thiazole_synthase_dehydroalanine {br=BR52385, ev=cof+eq}]-> ADP_5_ethyl_4_methylthiazole_2_carboxylate;  // cysteine-dependent adenosine diphosphate thiazole synthase
  (4_methyl_5_2_phosphoethyl_thiazole + 4_amino_2_methyl_5_diphosphomethylpyrimidine) -[node11281: 2.5.1.3 | -H, +PPi {br=BR51526, ev=cof+eq, match=similar}]-> TP;  // thiamine phosphate synthase
  (2_2R_5Z_2_carboxy_4_methylthiazol_5_2H_ylidene_ethyl_phosphate + 4_amino_2_methyl_5_diphosphomethylpyrimidine) -[node6601: 2.5.1.3 | -H, +PPi {br=BR47665, ev=cof+eq}]-> TP;  // thiamine phosphate synthase
  thiamine -[node3309: 3.5.99.2 | -H2O, +H {br=BR49840, ev=cof+eq}]-> (2_M_4_A_5_Hmp + 5_2_hydroxyethyl_4_methylthiazole#2);  // aminopyrimidine aminohydrolase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { 4_methyl_5_2_phosphoethyl_thiazole TP thiamine 5_2_hydroxyethyl_4_methylthiazole };
  motif substrate_cycle { TP thiamine } forward { node11238 } backward { node6604 };
