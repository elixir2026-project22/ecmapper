    -L[node11270: 4.1.99.19 | reduced_electron_acceptor>oxidized_electron_acceptor, -S_adenosyl_L_methionine, +4_methylphenol, +5_deoxyadenosine, +Met {br=BR49775, ev=cof+eq}]-> 2_iminoacetate;  // 2-iminoacetate synthase

