    -B[node6587: 4.1.99.17 | -S_adenosyl_L_methionine, +formate, +CO, +5_deoxyadenosine, +Met {br=BR49773, ev=cof+eq, match=single}]-> 4AMPM  // phosphomethylpyrimidine synthase
    -[node6586: 2.7.4.7 | ATP>ADP ^R]- 4_amino_2_methyl_5_diphosphomethylpyrimidine;  // phosphooxymethylpyrimidine kinase

