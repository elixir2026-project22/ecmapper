pwl 2.0;
subsystem glycine-betaine-biosynthesis 'glycine betaine biosynthesis' {
  // BRENDA subsystem: 7 reactions (7 with direction), 7 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound Gly brenda:72 kegg:C00037;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound N_N_dimethylglycine 'N,N-dimethylglycine' brenda:1240 kegg:C01026;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound a_phosphatidate 'a phosphatidate' brenda:97724;
  compound acceptor brenda:66 brenda:3161;
  compound betaine brenda:713 kegg:C00719;
  compound betaine_aldehyde 'betaine aldehyde' brenda:831 kegg:C00576;
  compound choline brenda:149 kegg:C00114;
  compound phosphatidylcholine brenda:215 kegg:C00157;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound sarcosine brenda:594 kegg:C00213;
  port betaine side L to methionine-metabolism;
  port betaine side R to carnitine-metabolism;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    betaine
      <-B[node2642: 2.1.1.162 | 3*S_adenosyl_L_methionine>3*S_adenosyl_L_homocysteine {br=BR50618, ev=cof+eq}]- Gly  // glycine/sarcosine/dimethylglycine N-methyltransferase
      -B[node2653: 2.1.1.20/2.1.1.156/2.1.1.162 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR43887, ev=cof+eq}]-> sarcosine  // glycine N-methyltransferase;glycine/sarcosine N-methyltransferase;glycine/sarcosine/dimethylglycine N-methyltransferase
      -[node2651: 2.1.1.156/2.1.1.157/2.1.1.162 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR48619, ev=cof+eq}]-> N_N_dimethylglycine  // glycine/sarcosine N-methyltransferase;sarcosine/dimethylglycine N-methyltransferase;glycine/sarcosine/dimethylglycine N-methyltransferase
      -[node2649: 2.1.1.157/2.1.1.161/2.1.1.162 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR48621, ev=cof+eq}]-> betaine;  // sarcosine/dimethylglycine N-methyltransferase;dimethylglycine N-methyltransferase;glycine/sarcosine/dimethylglycine N-methyltransferase
  }

  phosphatidylcholine
    -[node3534: 3.1.4.4 | -H2O, +a_phosphatidate ^L {br=BR15961, ev=cof+eq, match=single}]-> choline  // phospholipase D
    -[node3873: 1.1.99.1 | acceptor>reduced_acceptor {br=BR36747, ev=cof+eq}]-> betaine_aldehyde  // choline dehydrogenase
    -[node3870: 1.2.1.8 | NAD>NADH, -H2O, +2*H {br=BR36784, ev=cof+eq}]-> betaine;  // betaine-aldehyde dehydrogenase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { Gly betaine } bypasses { Gly sarcosine N_N_dimethylglycine betaine };
}
