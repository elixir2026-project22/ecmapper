pwl 2.0;
subsystem ubiquinone-biosynthesis 'ubiquinone biosynthesis' {
  // BRENDA subsystem: 11 reactions (9 with direction), 13 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2E_6E_farnesyl_PP '(2E,6E)-farnesyl-PP' brenda:1392;
  compound 2_methoxy_6_all_trans_octaprenyl_phenol '2-methoxy-6-(all-trans-octaprenyl)phenol' brenda:156591;
  compound 2_octaprenylphenol '2-octaprenylphenol' brenda:183485 kegg:C05810;
  compound 3_all_trans_octaprenyl_benzene_1_2_diol '3-(all-trans-octaprenyl)benzene-1,2-diol' brenda:186637;
  compound 3_demethylubiquinol_8 '3-demethylubiquinol-8' brenda:157085;
  compound 3_octaprenyl_4_hydroxybenzoate '3-octaprenyl-4-hydroxybenzoate' brenda:183498 kegg:C05809;
  compound 4_hydroxybenzoate '4-hydroxybenzoate' brenda:365 kegg:C00156;
  compound 6_all_trans_octaprenyl_2_methoxy_1_4_benzoquinol '6-all-trans-octaprenyl-2-methoxy-1,4-benzoquinol' brenda:195270;
  compound 6_methoxy_3_methyl_2_all_trans_octaprenyl_1_4_benzoquinol '6-methoxy-3-methyl-2-all-trans-octaprenyl-1,4-benzoquinol' brenda:195029;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound a_reduced_electron_acceptor 'a reduced electron acceptor' brenda:195040;
  compound all_trans_octaprenyl_PP 'all-trans-octaprenyl-PP' brenda:12767 kegg:C04146;
  compound an_oxidized_electron_acceptor 'an oxidized electron acceptor' brenda:195049;
  compound chorismate brenda:204 kegg:C00251;
  compound isopentenyl_PP 'isopentenyl-PP' brenda:113 kegg:C00129;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound ubiquinol_8 'ubiquinol-8' brenda:7718;
  compound ubiquinone brenda:410 kegg:C00399;
  port 4_hydroxybenzoate side U to 4-hydroxymandelate-degradation;
  port chorismate side U to chorismate-metabolism;

  3_octaprenyl_4_hydroxybenzoate
    -B[node6379: 4.1.1.98 | -H, +CO2 ^R {br=BS429727, ev=cof+eq}]-> 2_octaprenylphenol  // 4-hydroxy-3-polyprenylbenzoate decarboxylase
    -B[node6363: 1.14.13.240 | NADPH>NADP, -O2, +H2O]- 3_all_trans_octaprenyl_benzene_1_2_diol  // 2-polyprenylphenol 6-hydroxylase
    -[node6372: 2.1.1.222 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BS407324, ev=cof+eq}]-> 2_methoxy_6_all_trans_octaprenyl_phenol  // 2-polyprenyl-6-hydroxyphenol methylase
    -[node6370: 1.14.99.B5 | -O2, -a_reduced_electron_acceptor, +H2O, +an_oxidized_electron_acceptor {br=BR51542, ev=cof+eq}]-> 6_all_trans_octaprenyl_2_methoxy_1_4_benzoquinol  // 2-octaprenyl-6-methoxyphenol hydroxylase
    -B[node6365: 2.1.1.201 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine, +H]- 6_methoxy_3_methyl_2_all_trans_octaprenyl_1_4_benzoquinol  // 2-methoxy-6-polyprenyl-1,4-benzoquinol methylase
    -[node6374: 1.14.99.60 | reduced_electron_acceptor>oxidized_electron_acceptor, -O2, +H2O {br=BS427325, ev=cof+eq}]-> 3_demethylubiquinol_8  // 3-demethoxyubiquinol 3-hydroxylase
    -B[node6368: 2.1.1.64 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BS407327, ev=cof+eq}]-> ubiquinol_8  // 3-demethylubiquinol 3-O-methyltransferase
    -[node6382: ~? | +H ^L {br=BR52881, ev=cof+eq}]-> ubiquinone;  // spontaneous reaction

  2E_6E_farnesyl_PP
    -B[node2321: 2.5.1.90 | -5*isopentenyl_PP, +5*PPi ^L {br=BR49324, ev=cof+eq}]-> all_trans_octaprenyl_PP;  // all-trans-octaprenyl-diphosphate synthase

  chorismate
    -B[node6366: 4.1.3.40 | +pyruvate ^R {br=BR48792, ev=cof+eq}]-> 4_hydroxybenzoate;  // chorismate lyase

  (all_trans_octaprenyl_PP + 4_hydroxybenzoate) -[node6377: 2.5.1.39 | +PPi {br=BS409991, ev=cof+eq, match=kegg}]-> 3_octaprenyl_4_hydroxybenzoate;  // 4-hydroxybenzoate polyprenyltransferase
}
