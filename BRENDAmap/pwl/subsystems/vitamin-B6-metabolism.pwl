pwl 2.0;
subsystem vitamin-B6-metabolism 'vitamin B6 metabolism' {
  // BRENDA subsystem: 12 reactions (12 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1_deoxy_Xyl_5_P '1-deoxy-Xyl 5-P' brenda:1263 kegg:C11437;
  compound 2OG brenda:34 kegg:C00026;
  compound 2S_2_amino_3_oxo_4_phosphonooxybutanoate '(2S)-2-amino-3-oxo-4-phosphonooxybutanoate' brenda:127213 kegg:C07335;
  compound 3R_3_hydroxy_2_oxo_4_phosphonooxybutanoate '(3R)-3-hydroxy-2-oxo-4-phosphonooxybutanoate' brenda:57981 kegg:C06054;
  compound 3_amino_1_hydroxyacetone_1_phosphate '3-amino-1-hydroxyacetone 1-phosphate' brenda:56523;
  compound 4_phosphonooxy_Thr '4-phosphonooxy-Thr' brenda:32083;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound D_Rib_5_P 'D-Rib 5-P' brenda:183 kegg:C00117;
  compound E4P brenda:500 kegg:C00279;
  compound GAP brenda:147 kegg:C00118;
  compound Gln brenda:102 kegg:C00064;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PLP brenda:32 kegg:C00018;
  compound PYDAM brenda:1284 kegg:C00534;
  compound Pi brenda:16 kegg:C00009;
  compound erythronate_4_phosphate 'erythronate-4-phosphate' brenda:57994;
  compound pyridoxal brenda:608 kegg:C00250;
  compound pyridoxamine_phosphate 'pyridoxamine phosphate' brenda:179870 kegg:C00647;
  compound pyridoxine brenda:1051 kegg:C00314;
  compound pyridoxine_5_P 'pyridoxine 5\'-P' brenda:179869 kegg:C00627;
  port E4P side R to chorismate-metabolism;

  E4P
    -[node6614: 1.2.1.72 | NAD>NADH, -H2O, +2*H {br=BR48654, ev=cof+eq, match=single}]-> erythronate_4_phosphate  // erythrose-4-phosphate dehydrogenase
    -[node6615: 1.1.1.290 | NAD>NADH ^R {br=BR48652, ev=cof+eq, match=single}]-> 3R_3_hydroxy_2_oxo_4_phosphonooxybutanoate  // 4-phosphoerythronate dehydrogenase
    -B[node6625: 2.6.1.52 | Glu>2OG ^R {br=BR52120, ev=cof-eq, match=single}]-> 4_phosphonooxy_Thr  // phosphoserine transaminase
    -[node6627: 1.1.1.262 | NAD>NADH, +H {br=BS139544, ev=cof+eq, match=single}]-> 2S_2_amino_3_oxo_4_phosphonooxybutanoate  // 4-hydroxythreonine-4-phosphate dehydrogenase
    -L[node6629: ~? | -H, +CO2 ^L {br=BR52880, ev=cof+eq}]-> 3_amino_1_hydroxyacetone_1_phosphate  // spontaneous reaction
    -[node6640: 2.6.99.2 | -1_deoxy_Xyl_5_P, +2*H2O, +Pi, +H {br=BR48673, ev=cof+eq, match=single}]-> pyridoxine_5_P  // pyridoxine 5'-phosphate synthase
    -L[node6635: 1.4.3.5 | -O2, +H2O2 ^R {br=BR48819, ev=cof+eq}]-> PLP  // pyridoxal 5'-phosphate synthase
    <-L[node6658: 2.7.1.35 | ATP>ADP, +H {br=BR47774, ev=cof+eq}]- pyridoxal;  // pyridoxal kinase

  pyridoxine
    -R[node6643: 2.7.1.35 | ATP>ADP ^L {br=BS357525, ev=cof+eq}]-> pyridoxine_5_P;  // pyridoxal kinase

  PYDAM
    -R[node6649: 2.7.1.35 | ATP>ADP, +H {br=BS357527, ev=cof+eq}]-> pyridoxamine_phosphate  // pyridoxal kinase
    -[node6653: 1.4.3.5 | -H2O, -O2, +H2O2, +H, +NH3 {br=BR36881, ev=cof+eq}]-> PLP;  // pyridoxal 5'-phosphate synthase

  (D_Rib_5_P + GAP) -[node2584: 4.3.3.6 | -Gln, +Glu, +3*H2O, +Pi {br=BR50350, ev=cof+eq}]-> PLP;  // pyridoxal 5'-phosphate synthase (glutamine hydrolysing)
