pwl 2.0;
subsystem lactate-fermentation 'lactate fermentation' {
  // BRENDA subsystem: 3 reactions (3 with direction), 3 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound D_lactate 'D-lactate' brenda:600 kegg:C00256;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound L_lactate 'L-lactate' brenda:403 kegg:C00186;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound pyruvate brenda:31 kegg:C00022;
  port pyruvate side L to glycolysis;

  pyruvate
    -[node8829: <- 1.1.2.3 | -2*ferricytochrome_c, +2*ferrocytochrome_c, +2*H {br=BR33683, ev=cof+eq} || node9734: -> 1.1.1.27 | NADH>NAD {br=BR29287, ev=cof-eq}]- L_lactate  // L-lactate dehydrogenase (cytochrome); L-lactate dehydrogenase
    <-[node2593: 5.1.2.1 {br=BR178, ev=eq, rev=eq, match=kegg}]-> D_lactate;  // Lactate racemase
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { L_lactate pyruvate } forward { node8829 } backward { node9734 };
}
