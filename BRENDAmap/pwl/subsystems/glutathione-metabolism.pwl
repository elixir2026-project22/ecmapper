pwl 2.0;
subsystem glutathione-metabolism 'glutathione metabolism' {
  // BRENDA subsystem: 13 reactions (13 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 5_L_glutamyl_L_amino_acid '5-L-glutamyl-L-amino acid' brenda:43554 kegg:C03740;
  compound 5_oxo_Pro '5-oxo-Pro' brenda:1024 kegg:C01879;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Cys brenda:74 kegg:C00097;
  compound Cys_Gly 'Cys-Gly' brenda:4306 kegg:C01419;
  compound GSH brenda:44 kegg:C00051;
  compound GSSG brenda:973 kegg:C00127;
  compound Glu brenda:41 kegg:C00025;
  compound Gly brenda:72 kegg:C00037;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound HX brenda:20904 kegg:C00462;
  compound L_Amino_acid 'L-Amino acid' brenda:5166 kegg:C00151;
  compound N1_g_Glu_Cys_Gly_spermidine 'N1-(g-Glu-Cys-Gly)-spermidine' brenda:3375 kegg:C05730;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound Pi brenda:16 kegg:C00009;
  compound RX brenda:31084 kegg:C01322;
  compound R_S_glutathione 'R-S-glutathione' brenda:47549 kegg:C02320;
  compound Trypanothione_disulfide 'Trypanothione disulfide' brenda:1390 kegg:C03170;
  compound bis_gamma_glutamylcystine 'bis-gamma-glutamylcystine' brenda:15665 kegg:C03646;
  compound gamma_Glu_Cys 'gamma-Glu-Cys' brenda:4246 kegg:C00669;
  compound spermidine brenda:148 kegg:C00315;
  compound trypanothione brenda:1726 kegg:C02090;
  port GSH side D to cysteine-metabolism;
  port GSSG side D to cysteine-metabolism;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    gamma_Glu_Cys
      -L[node3937: 6.3.2.3 | ATP>ADP, -Gly, +H, +Pi {br=BR119, ev=cof+eq}]-> GSH;  // Glutathione synthase
    5_L_glutamyl_L_amino_acid
      -R[node3472: 4.3.2.9 | +H, +L_Amino_acid {br=BS321692, ev=cof+eq, match=kegg}]-> 5_oxo_Pro  // gamma-glutamylcyclotransferase
      -L[node3468: 3.5.2.9 | ATP>ADP, -2*H2O, +Pi {br=BR22721, ev=cof+eq}]-> Glu;  // 5-oxoprolinase (ATP-hydrolysing)
    (Glu + Cys) -[node3940: 6.3.2.2 | ATP>ADP, +H, +Pi {br=BR112, ev=cof+eq}]-> gamma_Glu_Cys;  // Glutamate-cysteine ligase
    GSH -[node3475: 2.3.2.2 | -L_Amino_acid {br=BS370347, ev=eq}]-> (Cys_Gly + 5_L_glutamyl_L_amino_acid);  // gamma-glutamyltransferase
  }

  GSH
    -[node7569: 2.5.1.18 | -RX, +HX ^L {br=BR47501, ev=cof+eq}]-> R_S_glutathione;  // glutathione transferase

  gamma_Glu_Cys
    -B[node10860: 1.8.1.13 | NADP>NADPH, +H {br=BR36930, ev=cof+eq}]-> bis_gamma_glutamylcystine;  // bis-gamma-glutamylcystine reductase

  GSH
    -L[node7565: 1.8.1.7 | NADP>NADPH, +H {br=BR37011, ev=cof+eq}]-> GSSG;  // glutathione-disulfide reductase

  GSH
    -R[node7571: 3.4.19.13 | -H2O, +Glu ^R {br=BR49838, ev=cof+eq}]-> Cys_Gly  // glutathione gamma-glutamate hydrolase
    -L[node3463: 3.4.11.2 | -H2O, +Gly ^R {br=BS364761, ev=cof+eq}]-> Cys;  // membrane alanyl aminopeptidase

  trypanothione
    -R[node8054: 1.8.1.12 | NADP>NADPH, +H {br=BR37012, ev=cof+eq}]-> Trypanothione_disulfide;  // trypanothione-disulfide reductase

  (N1_g_Glu_Cys_Gly_spermidine + GSH) -[node8052: 6.3.1.9 | ATP>ADP, +Pi {br=BR48737, ev=cof+eq, match=kegg}]-> trypanothione;  // Trypanothione synthase
  (spermidine + GSH) -[node8050: 6.3.1.8 | ATP>ADP, +Pi {br=BR99, ev=cof+eq}]-> N1_g_Glu_Cys_Gly_spermidine;  // Glutathionylspermidine synthase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { Cys gamma_Glu_Cys GSH Cys_Gly };
}
