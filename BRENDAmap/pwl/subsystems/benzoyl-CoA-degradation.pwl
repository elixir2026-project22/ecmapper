pwl 2.0;
subsystem benzoyl-CoA-degradation 'benzoyl-CoA degradation' {
  // BRENDA subsystem: 9 reactions (8 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_4_6_trihydroxybenzophenone '2,4,6-trihydroxybenzophenone' brenda:10824 kegg:C06356;
  compound 3_hydroxypimeloyl_CoA '3-hydroxypimeloyl-CoA' brenda:16319 kegg:C06714;
  compound 3_oxopimeloyl_CoA '3-oxopimeloyl-CoA' brenda:46970 kegg:C06715;
  compound 6_hydroxycyclohex_1_enecarbonyl_CoA '6-hydroxycyclohex-1-enecarbonyl-CoA' brenda:46996 kegg:C06749;
  compound 6_oxocyclohex_1_ene_1_carboxyl_CoA '6-oxocyclohex-1-ene-1-carboxyl-CoA' brenda:182184;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound Pi brenda:16 kegg:C00009;
  compound benzoyl_CoA 'benzoyl-CoA' brenda:394 kegg:C00512;
  compound cyclohex_1_ene_1_carbonyl_CoA 'cyclohex-1-ene-1-carbonyl-CoA' brenda:8395 kegg:C09811;
  compound cyclohexa_1_5_diene_1_carbonyl_CoA 'cyclohexa-1,5-diene-1-carbonyl-CoA' brenda:4800 kegg:C06322;
  compound cyclohexane_1_carbonyl_CoA 'cyclohexane-1-carbonyl-CoA' brenda:42525 kegg:C09823;
  compound electron_transferring_flavoprotein 'electron-transferring flavoprotein' brenda:2297 kegg:C04253;
  compound glutaryl_CoA 'glutaryl-CoA' brenda:656 kegg:C00527;
  compound reduced_electron_transferring_flavoprotein 'reduced electron-transferring flavoprotein' brenda:1892 brenda:3252 kegg:C04570;
  port benzoyl_CoA side R to phenol-degradation;
  port benzoyl_CoA side R to toluene-degradation;

  cyclohexane_1_carbonyl_CoA
    -L[node11440: 1.3.8.11 | -electron_transferring_flavoprotein, +reduced_electron_transferring_flavoprotein ^L {br=BR50782, ev=cof+eq}]-> cyclohex_1_ene_1_carbonyl_CoA  // cyclohexane-1-carbonyl-CoA dehydrogenase (electron-transfer flavoprotein)
    -R[node11436: 1.3.8.10 | -electron_transferring_flavoprotein, +reduced_electron_transferring_flavoprotein ^R {br=BR50781, ev=cof+eq, match=kegg}]-> cyclohexa_1_5_diene_1_carbonyl_CoA  // cyclohex-1-ene-1-carbonyl-CoA dehydrogenase
    -[node2502: 4.2.1.100 | -H2O ^L {br=BR29123, ev=cof-eq, match=kegg}]-> 6_hydroxycyclohex_1_enecarbonyl_CoA  // cyclohexa-1,5-dienecarbonyl-CoA hydratase
    -R[node2500: 1.1.1.368 | NAD>NADH ^L {br=BR50929, ev=cof+eq, match=single}]-> 6_oxocyclohex_1_ene_1_carboxyl_CoA  // 6-hydroxycyclohex-1-ene-1-carbonyl-CoA dehydrogenase
    -R[node2498: 3.7.1.21 | -2*H2O ^R {br=BR50994, ev=cof+eq, match=single}]-> 3_hydroxypimeloyl_CoA  // 6-oxocyclohex-1-ene-1-carbonyl-CoA hydratase
    -B[node2496: 1.1.1.259 | NAD>NADH ^L {br=BR22610, ev=cof+eq}]-> 3_oxopimeloyl_CoA  // 3-hydroxypimeloyl-CoA dehydrogenase
    -[node2494: 2.3.1.- | CoA>Ac_CoA ^L]- glutaryl_CoA;  // hypothetical

  cyclohexa_1_5_diene_1_carbonyl_CoA
    <-B[node2504: 1.3.7.8 | Fd_red>Fd_ox, 2*ATP>2*ADP, -2*H2O, +2*Pi {br=BR1225, ev=cof-eq}]- benzoyl_CoA  // benzoyl-CoA reductase
    -[node1971: 2.3.1.220 {br=BR50414, ev=eq}]-> 2_4_6_trihydroxybenzophenone;  // 2,4,6-trihydroxybenzophenone synthase
}
