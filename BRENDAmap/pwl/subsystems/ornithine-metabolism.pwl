pwl 2.0;
subsystem ornithine-metabolism 'ornithine metabolism' {
  // BRENDA subsystem: 8 reactions (8 with direction), 9 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2_4_diaminopentanoate '2,4-diaminopentanoate' brenda:55675 kegg:C03943;
  compound 2_amino_4_oxopentanoate '2-amino-4-oxopentanoate' brenda:7983 kegg:C03341;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound D_Ala 'D-Ala' brenda:164 kegg:C00133;
  compound D_Orn 'D-Orn' brenda:2550 kegg:C00515;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound N5_hydroxy_L_ornithine 'N5-hydroxy-L-ornithine' brenda:14791 kegg:C20850;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound NH4 'NH4+' brenda:4224;
  compound O2 brenda:9 brenda:1180;
  compound Orn brenda:192 kegg:C00077;
  compound Pi brenda:16 kegg:C00009;
  compound Pro brenda:243 kegg:C00148;
  compound acetate brenda:47 kegg:C00033;
  compound acetyl_phosphate 'acetyl phosphate' brenda:358 kegg:C00227;
  port Pro side L to proline-metabolism;

  Orn
    -R[node12369: 4.3.1.12 | +NH3 ^L {br=BR3424, ev=cof+eq}]-> Pro;  // ornithine cyclodeaminase

  Orn
    -B[node1982: 1.14.13.195 | NADPH>NADP, -O2, -H, +H2O {br=BR49228, ev=cof+eq}]-> N5_hydroxy_L_ornithine;  // L-ornithine N5-monooxygenase (NADPH)

  Orn
    <-[node2407: 5.1.1.12 {br=BR165, ev=eq, rev=eq}]-> D_Orn  // ornithine racemase
    -[node2405: 5.4.3.5 {br=BR29, ev=eq}]-> 2_4_diaminopentanoate  // D-ornithine 4,5-aminomutase
    -R[node2403: 1.4.1.12 | NADP>NADPH, -H2O, +NH4 ^R {br=BS258906, ev=cof+eq}]-> 2_amino_4_oxopentanoate  // 2,4-diaminopentanoate dehydrogenase
    -R[node2401: 2.3.1.263 | -CoA, +D_Ala ^L {br=BS407182, ev=cof-eq}]-> Ac_CoA  // 2-amino-4-oxopentanoate thiolase
    -[node12361: 2.3.1.8 | -Pi, +CoA ^L {br=BR44082, ev=cof+eq}]-> acetyl_phosphate  // phosphate acetyltransferase
    -[node12366: 2.7.2.1/2.7.2.15 | ADP>ATP ^L {br=BR47820, ev=cof-eq}]-> acetate;  // acetate kinase;propionate kinase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NADP NADPH } forward { node2403 } backward { node1982 };
}
