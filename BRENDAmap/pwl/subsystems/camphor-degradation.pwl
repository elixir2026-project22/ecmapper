  compound 2R_3_3_4_trimethyl_6_oxo_3_6_dihydro_1H_pyran_2_yl_acetyl_CoA '[(2R)-3,3,4-trimethyl-6-oxo-3,6-dihydro-1H-pyran-2-yl]acetyl-CoA' brenda:86273 kegg:C20321;
