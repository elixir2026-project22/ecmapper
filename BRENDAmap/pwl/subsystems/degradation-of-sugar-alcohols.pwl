pwl 2.0;
subsystem degradation-of-sugar-alcohols 'degradation of sugar alcohols' {
  // BRENDA subsystem: 18 reactions (15 with direction), 23 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_acylglycerophosphocholine '2-acylglycerophosphocholine' brenda:2427;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound DHAP brenda:278 kegg:C00111;
  compound D_Sorb_6_P 'D-Sorb 6-P' brenda:4804 kegg:C01096;
  compound D_Sorbitol 'D-Sorbitol' brenda:627 kegg:C00794;
  compound D_Tagatose_1_6_bisphosphate 'D-Tagatose 1,6-bisphosphate' brenda:45996 kegg:C03785;
  compound D_Xul 'D-Xul' brenda:715 kegg:C00310;
  compound D_Xul_5_P 'D-Xul 5-P' brenda:644 kegg:C00231;
  compound D_Xylitol 'D-Xylitol' brenda:1921;
  compound D_arabitol 'D-arabitol' brenda:1786 kegg:C01904;
  compound D_ribitol 'D-ribitol' brenda:4001;
  compound D_ribulose 'D-ribulose' brenda:922 kegg:C00309;
  compound D_tagatose_6_P 'D-tagatose 6-P' brenda:3459 kegg:C01097;
  compound Fru brenda:117;
  compound Fru_6_P 'Fru 6-P' brenda:87 kegg:C00085;
  compound GAP brenda:147 kegg:C00118;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_Sorb_1_P 'L-Sorb 1-P' brenda:45620 kegg:C02888;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PEP brenda:51 kegg:C00074;
  compound a_quinol 'a quinol' brenda:2695;
  compound a_quinone 'a quinone' brenda:1992;
  compound choline brenda:149 kegg:C00114;
  compound dihydroxyacetone brenda:620 kegg:C00184;
  compound fatty_acid 'fatty acid' brenda:833 kegg:C00162;
  compound galactitol_1_phosphate 'galactitol-1-phosphate' brenda:45534 kegg:C06311;
  compound glycerol brenda:135 kegg:C00116;
  compound glycerone_phosphate 'glycerone phosphate' brenda:482 kegg:C00111;
  compound glycerylphosphocholine brenda:47262;
  compound mannitol_1_phosphate 'mannitol-1-phosphate' brenda:114624;
  compound pyruvate brenda:31 kegg:C00022;
  compound sn_glycerol_3_phosphate 'sn-glycerol 3-phosphate' brenda:422 kegg:C00093;
  port DHAP side R to glycolysis;
  port D_Xul side L to d-xylose-degradation;
  port D_Xul_5_P side U to degradation-of-pentoses;
  port D_ribulose side R to degradation-of-pentoses;
  port glycerol side D to lipid-metabolism;
  port glycerol side R to cardiolipin-biosynthesis;
  port glycerone_phosphate side R to CDP-diacylglycerol-biosynthesis;
  port glycerone_phosphate side R to degradation-of-pentoses;
  port sn_glycerol_3_phosphate side R to cardiolipin-biosynthesis;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    sn_glycerol_3_phosphate
      -R[node6961: 1.1.5.3 | -a_quinone, +a_quinol {br=BR48992, ev=cof+eq, match=kegg}]-> DHAP  // glycerol-3-phosphate dehydrogenase
      <-R[node1374: 2.7.1.29 | ATP>ADP {br=BR47768, ev=cof+eq, match=kegg} || node1366: 2.7.1.121 | -PEP, +pyruvate {br=BR47735, ev=cof+eq, match=kegg}]- dihydroxyacetone  // glycerone kinase; phosphoenolpyruvate-glycerone phosphotransferase
      <-[node1372: 1.1.1.6 | NAD>NADH ^R {br=BR47364, ev=cof+eq, match=kegg}]- glycerol  // glycerol dehydrogenase
      -B[node6968: 2.7.1.30 | ATP>ADP ^R {br=BR47770, ev=cof+eq}]-> sn_glycerol_3_phosphate;  // glycerol kinase
  }

  sn_glycerol_3_phosphate
    -B[node6966: 3.1.4.46 | -H2O, +choline ^L]- glycerylphosphocholine  // glycerophosphodiester phosphodiesterase
    -[node3326: 3.1.1.5 | -H2O, +fatty_acid]- 2_acylglycerophosphocholine;  // lysophospholipase

  mannitol_1_phosphate
    -[node6844: 1.1.1.17 | NAD>NADH ^R {br=BR36702, ev=cof+eq}]-> Fru_6_P  // mannitol-1-phosphate 5-dehydrogenase
    <-[node7836: 1.1.1.140 | NAD>NADH ^R {br=BR29206, ev=cof+eq}]- D_Sorb_6_P  // sorbitol-6-phosphate 2-dehydrogenase
    -[node7834: 1.1.1.- | NADPH>NADP ^R]- L_Sorb_1_P;  // L-sorbose 1-phosphate reductase

  galactitol_1_phosphate
    -[node6833: 1.1.1.251 | NAD>NADH ^R {br=BR920, ev=cof+eq}]-> D_tagatose_6_P  // galactitol-1-phosphate 5-dehydrogenase
    -[node6834: 2.7.1.144 | ATP>ADP, +H {br=BR47754, ev=cof+eq}]-> D_Tagatose_1_6_bisphosphate;  // tagatose-6-phosphate kinase

  D_arabitol
    -[node6855: 1.1.1.11 | NAD>NADH ^R {br=BR29175, ev=cof+eq, match=kegg}]-> D_Xul  // D-arabinitol 4-dehydrogenase
    -[node6852: 2.7.1.17 | ATP>ADP, +H {br=BR48062, ev=cof+eq}]-> D_Xul_5_P;  // xylulokinase

  D_Xylitol
    -L[node7601: 1.1.1.9 | NAD>NADH ^L {br=BR26053, ev=cof+eq}]-> D_Xul;  // D-xylulose reductase

  D_ribitol
    -[node7588: 1.1.1.56 | NAD>NADH ^R {br=BR29319, ev=cof+eq}]-> D_ribulose;  // ribitol 2-dehydrogenase

  D_Sorbitol
    -L[node3412: 1.1.1.14 | NAD>NADH ^R {br=BS165118, ev=cof+eq}]-> Fru;  // L-iditol 2-dehydrogenase

  D_Tagatose_1_6_bisphosphate -[node6840: 4.1.2.40 {br=BR372, ev=eq}]-> (GAP + glycerone_phosphate);  // Tagatose-bisphosphate aldolase
}
