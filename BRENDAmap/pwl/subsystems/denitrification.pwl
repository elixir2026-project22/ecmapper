pwl 2.0;
subsystem denitrification 'denitrification' {
  // BRENDA subsystem: 3 reactions (1 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound N2 brenda:6051 kegg:C00697;
  compound N2O brenda:3355 kegg:C00887;
  compound NO brenda:662 kegg:C00533;
  compound NO2 brenda:168 kegg:C00088;
  compound acceptor brenda:66 brenda:3161;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  port N2 side R to nitrate-assimilation;
  port NO2 side R to nitrate-assimilation;

  NO2
    -L[node3521: 1.7.2.1 | -ferrocytochrome_c, -2*H, +H2O, +ferricytochrome_c {br=BR48041, ev=cof-eq}]-> NO  // nitrite reductase (NO-forming)
    -R[node3529: 1.7.2.5 | -ferrocytochrome_c, +ferricytochrome_c, +H2O]- N2O  // nitric oxide reductase (cytochrome c)
    -R[node3518: 1.7.2.4 | reduced_acceptor>acceptor, +H2O]- N2;  // nitrous-oxide reductase
}
