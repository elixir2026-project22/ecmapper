pwl 2.0;
subsystem degradation-of-aromatic-nitrogen-containing-compounds 'degradation of aromatic, nitrogen containing compounds' {
  // BRENDA subsystem: 11 reactions (9 with direction), 16 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 3_cyanopyridine '3-cyanopyridine' brenda:1784;
  compound 4_nitrophenol '4-nitrophenol' brenda:80 kegg:C00870;
  compound 4_nitrophenyl_phosphate '4-nitrophenyl phosphate' brenda:136 kegg:C03360;
  compound Cl 'Cl-' brenda:298 kegg:C00698;
  compound E_pyridine_3_aldoxime '(E)-pyridine-3-aldoxime' brenda:55043;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NH3 brenda:27;
  compound N_isopropylammelide 'N-isopropylammelide' brenda:9442 kegg:C06553;
  compound Pi brenda:16 kegg:C00009;
  compound acrylamide brenda:1914 kegg:C01659;
  compound acrylate brenda:1915 kegg:C00511;
  compound acrylonitrile brenda:1749 kegg:C01998;
  compound atrazine brenda:1113 kegg:C06551;
  compound cyanurate brenda:92978 kegg:C06554;
  compound diethyl_phosphate 'diethyl phosphate' brenda:2106;
  compound ethylamine brenda:701 kegg:C00797;
  compound hydroxyatrazine brenda:25570 kegg:C06552;
  compound isopropylamine brenda:10864 kegg:C06748;
  compound nicotinamide brenda:267 kegg:C00153;
  compound nicotinate brenda:1029 kegg:C00253;
  compound paraoxon brenda:228 kegg:C06606;
  port nicotinamide side R to NAD-metabolism;
  port nicotinate side R to NAD-metabolism;

  4_nitrophenyl_phosphate
    -R[node2451: 3.1.3.41 | -H2O, +Pi ^R {br=BR11742, ev=cof+eq}]-> 4_nitrophenol;  // 4-nitrophenylphosphatase

  atrazine
    -R[node8853: 3.8.1.8 | -H2O, +H, +Cl {br=BR26144, ev=cof+eq}]-> hydroxyatrazine  // atrazine chlorohydrolase
    -[node8867: 3.5.4.43 | -H2O, -H, +ethylamine {br=BR19265, ev=cof+eq}]-> N_isopropylammelide;  // hydroxydechloroatrazine ethylaminohydrolase

  E_pyridine_3_aldoxime
    -R[node8849: 4.8.1.2 | +H2O ^L {br=BS368604, ev=cof+eq, match=single}]-> 3_cyanopyridine  // aliphatic aldoxime dehydratase
    -[node8851: 4.2.1.84 | -H2O ^L {br=BS363346, ev=cof+eq, match=single}]-> nicotinamide  // nitrile hydratase
    -[node8850: 3.5.1.4 | -H2O, +H, +NH3 {br=BR26099, ev=cof+eq}]-> nicotinate;  // amidase

  acrylonitrile
    -R[node7629: 4.2.1.84 | -H2O ^R {br=BS363331, ev=cof+eq, match=single}]-> acrylamide  // nitrile hydratase
    -R[node7634: 3.5.1.4 | -H2O, +H, +NH3 {br=BS140520, ev=cof+eq}]-> acrylate  // amidase
    -R[node7625: 3.5.5.7 | -H2O, +H, +NH3]- acrylonitrile;  // Aliphatic nitrilase

  N_isopropylammelide -[node8856: 3.5.4.42 | -H, -H2O {br=BR19266, ev=cof+eq}]-> (isopropylamine + cyanurate);  // N-isopropylammelide isopropylaminohydrolase
  react [node2901: 3.1.8.1 | -H2O, +H] {4_nitrophenol, diethyl_phosphate, paraoxon};  // aryldialkylphosphatase
}
