pwl 2.0;
subsystem vitamin-K-metabolism 'vitamin K metabolism' {
  // BRENDA subsystem: 9 reactions (9 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1R_6R_6_hydroxy_2_succinylcyclohexa_2_4_diene_1_carboxylate '(1R,6R)-6-hydroxy-2-succinylcyclohexa-2,4-diene-1-carboxylate' brenda:24567 kegg:C05817;
  compound 1_4_dihydroxy_2_naphthoate '1,4-dihydroxy-2-naphthoate' brenda:5885 kegg:C03657;
  compound 1_4_dihydroxy_2_naphthoyl_CoA '1,4-dihydroxy-2-naphthoyl-CoA' brenda:14477 kegg:C15547;
  compound 2OG brenda:34 kegg:C00026;
  compound 2_suc_benzoate '2-suc-benzoate' brenda:7261 kegg:C02730;
  compound 2_succinylbenzoyl_CoA '2-succinylbenzoyl-CoA' brenda:5683 kegg:C03160;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H2O brenda:1 kegg:C00001;
  compound PPi brenda:17 kegg:C00013;
  compound SEPHCHC brenda:138471 kegg:C16519;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound a_demethylmenaquinol 'a demethylmenaquinol' brenda:75884;
  compound a_menaquinol 'a menaquinol' brenda:26809;
  compound an_all_trans_polyprenyl_PP 'an all-trans-polyprenyl PP' brenda:152144;
  compound chorismate brenda:204 kegg:C00251;
  compound isochorismate brenda:1280 kegg:C00885;
  compound pyruvate brenda:31 kegg:C00022;
  port chorismate side L to chorismate-metabolism;

  chorismate
    -[node4190: 5.4.4.2 {br=BR44348, ev=eq}]-> isochorismate  // Isochorismate synthase
    -[node4198: 2.2.1.9 | -2OG, +CO2 ^R {br=BR48908, ev=cof+eq}]-> SEPHCHC  // 2-succinyl-5-enolpyruvyl-6-hydroxy-3-cyclohexene-1-carboxylic-acid synthase
    -[node4194: 4.2.99.20 | +pyruvate ^R {br=BR48915, ev=cof+eq}]-> 1R_6R_6_hydroxy_2_succinylcyclohexa_2_4_diene_1_carboxylate  // 2-succinyl-6-hydroxy-2,4-cyclohexadiene-1-carboxylate synthase
    -B[node4197: 4.2.1.113 | +H2O ^R {br=BR48469, ev=cof+eq, match=kegg}]-> 2_suc_benzoate  // o-succinylbenzoate synthase
    -[node4200: 6.2.1.26 | ATP>AMP, -CoA, +PPi {br=BS363640, ev=cof+eq, match=kegg}]-> 2_succinylbenzoyl_CoA  // O-succinylbenzoate-CoA ligase
    -B[node4187: 4.1.3.36 | +H2O ^R {br=BS416184, ev=cof+eq, match=kegg}]-> 1_4_dihydroxy_2_naphthoyl_CoA  // 1,4-dihydroxy-2-naphthoyl-CoA synthase
    -[node4182: 3.1.2.28 | -H2O, +CoA ^R {br=BR49261, ev=cof+eq}]-> 1_4_dihydroxy_2_naphthoate  // 1,4-dihydroxy-2-naphthoyl-CoA hydrolase
    -[node4178: 2.5.1.74 | -an_all_trans_polyprenyl_PP, +CO2, +PPi {br=BR49120, ev=cof+eq}]-> a_demethylmenaquinol  // 1,4-dihydroxy-2-naphthoate polyprenyltransferase
    -B[node4173: 2.1.1.163 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR49116, ev=cof+eq}]-> a_menaquinol;  // demethylmenaquinone methyltransferase
}
