pwl 2.0;
subsystem molybdenum-cofactor-biosynthesis 'molybdenum cofactor biosynthesis' {
  // BRENDA subsystem: 9 reactions (6 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ala brenda:103 kegg:C00041;
  compound CTP brenda:60 kegg:C00063;
  compound Cys brenda:74 kegg:C00097;
  compound GTP brenda:37 kegg:C00044;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound MPT brenda:898 kegg:C05924;
  compound MoCo brenda:1164 kegg:C18237;
  compound PPi brenda:17 kegg:C00013;
  compound adenylyl_molybdopterin 'adenylyl-molybdopterin' brenda:41410 kegg:C19848;
  compound cPMP brenda:165106 kegg:C18239;
  compound cysteine_desulfurase 'cysteine desulfurase' brenda:84971;
  compound cytidylyl_moco 'cytidylyl moco' brenda:164261 kegg:C21485;
  compound enzyme_S_sulfanylcysteine '[enzyme]-S-sulfanylcysteine' brenda:33030 brenda:84978 kegg:C15812;
  compound guanylyl_moco 'guanylyl moco' brenda:159750 kegg:C19871;
  compound molybdate brenda:509 kegg:C06232;
  compound molybdopterin_synthase_sulfur_carrier_protein 'molybdopterin-synthase sulfur-carrier protein' brenda:84974;
  compound molybdopterin_synthase_sulfur_carrier_protein_Gly_Gly '[molybdopterin-synthase sulfur-carrier protein]-Gly-Gly' brenda:84979;
  compound molybdopterin_synthase_sulfur_carrier_protein_Gly_Gly_AMP '[molybdopterin-synthase sulfur-carrier protein]-Gly-Gly-AMP' brenda:28265;
  compound molybdopterin_synthase_sulfur_carrier_protein_Gly_NH_CH2_C_O_SH '[molybdopterin-synthase sulfur-carrier protein] -Gly-NH-CH2-C(O)SH' brenda:28266;
  compound thio_moco 'thio-moco' brenda:159744 kegg:C21486;
  port GTP side R to purine-metabolism;

  GTP
    -L[node10746: 4.1.99.22 | +PPi ^R {br=BR49774, ev=cof+eq, match=kegg}]-> cPMP;  // GTP 3',8-cyclase

  MPT
    -[node10750: 2.7.7.75 | -ATP, +PPi ^L {br=BR49475, ev=cof+eq, match=single}]-> adenylyl_molybdopterin  // molybdopterin adenylyltransferase
    -[node10752: 2.10.1.1 | -molybdate, +AMP ^L {br=BR49440, ev=cof+eq}]-> MoCo  // molybdopterin molybdotransferase
    -[node10756: 2.7.7.77 | -GTP, +PPi ^R]- guanylyl_moco;  // molybdenum cofactor guanylyltransferase

  MoCo
    -R[node10755: 2.7.7.76 | -CTP, +PPi ^R]- cytidylyl_moco;  // molybdenum cofactor cytidylyltransferase

  MoCo
    -R[node10754: 2.8.1.9 | -2*H, -Cys, +Ala, +H2O]- thio_moco;  // molybdenum cofactor sulfurtransferase

  molybdopterin_synthase_sulfur_carrier_protein_Gly_Gly
    -B[node10777: 2.7.7.80 | -ATP, +PPi ^R {br=BR49830, ev=cof+eq}]-> molybdopterin_synthase_sulfur_carrier_protein_Gly_Gly_AMP  // molybdopterin-synthase adenylyltransferase
    -[node10775: 2.8.1.11 | -enzyme_S_sulfanylcysteine, +cysteine_desulfurase, +AMP {br=BS422145, ev=cof+eq}]-> molybdopterin_synthase_sulfur_carrier_protein_Gly_NH_CH2_C_O_SH;  // molybdopterin synthase sulfurtransferase

  (cPMP + 2*molybdopterin_synthase_sulfur_carrier_protein_Gly_NH_CH2_C_O_SH) -[node10748: 2.8.1.12 | +2*molybdopterin_synthase_sulfur_carrier_protein {br=BR49832, ev=cof+eq, match=kegg}]-> MPT;  // molybdopterin synthase
}
