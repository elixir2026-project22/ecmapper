pwl 2.0;
subsystem isoleucine-metabolism 'isoleucine metabolism' {
  // BRENDA subsystem: 17 reactions (9 with direction), 19 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OBUT brenda:390 kegg:C00109;
  compound 2OG brenda:34 kegg:C00026;
  compound 2R_3S_3_methylmalate '(2R,3S)-3-methylmalate' brenda:254202 kegg:C06032;
  compound 2S_3S_3_methylaspartate '(2S, 3S)-3-methylaspartate' brenda:16181 kegg:C03618;
  compound 2_3_dihydroxy_3_methylvalerate '2,3-dihydroxy-3-methylvalerate' brenda:47551 kegg:C04104;
  compound 2_aceto_2_hydroxy_butyrate '2-aceto-2-hydroxy-butyrate' brenda:182168;
  compound 2_keto_3_methyl_valerate '2-keto-3-methyl-valerate' brenda:178674;
  compound 2_methylbutanoate '2-methylbutanoate' brenda:9023 kegg:C18319;
  compound 2_methylbutanoyl_CoA '2-methylbutanoyl-CoA' brenda:5473 kegg:C01033;
  compound 3_methyloxaloacetate '3-methyloxaloacetate' brenda:182126 kegg:C06030;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound Ile brenda:311 kegg:C00407;
  compound L_isoleucyl_tRNAIle 'L-isoleucyl-tRNAIle' brenda:44319 kegg:C03127;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound R_citramalate '(R)-citramalate' brenda:11647;
  compound citraconate brenda:5952 kegg:C02226;
  compound propanoate brenda:949 kegg:C00163;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  compound pyruvate brenda:31 kegg:C00022;
  compound tRNAIle brenda:3671 kegg:C01644;
  port Glu side L to glutamate-and-glutamine-metabolism;

  Glu
    -[node4262: 5.4.99.1]- 2S_3S_3_methylaspartate  // Methylaspartate mutase
    -[node4260: 2.6.1.- | 2OG>Glu ^R]- 3_methyloxaloacetate  // Beta-methylaspartate aminotransferase
    -L[node4258: 4.1.1.112 | +CO2 ^R {br=BS390752, ev=cof+eq}]-> 2OBUT  // oxaloacetate decarboxylase
    -R[node4288: 2.2.1.6 | -pyruvate, +CO2 ^R {br=BS386671, ev=cof+eq, match=kegg}]-> 2_aceto_2_hydroxy_butyrate  // acetolactate synthase
    -[node4290: 1.1.1.86 | NADPH>NADP ^L {br=BS383015, ev=cof+eq}]-> 2_3_dihydroxy_3_methylvalerate  // ketol-acid reductoisomerase (NADP+)
    -R[node4291: 4.2.1.9 | +H2O ^R]- 2_keto_3_methyl_valerate  // dihydroxy-acid dehydratase
    -[node4283: 2.6.1.42 | Glu>2OG {br=BS356522, ev=cof-eq, match=single}]-> Ile;  // branched-chain-amino-acid transaminase

  2_keto_3_methyl_valerate
    -[node4241: 1.2.1.25 | NAD>NADH, -CoA, -CO2]- 2_methylbutanoyl_CoA#2;  // branched-chain alpha-keto acid dehydrogenase system

  2_keto_3_methyl_valerate
    -[node4240: 1.2.7.7 | Fd_red>Fd_ox, -CO2, +CoA]- 2_methylbutanoyl_CoA  // 3-methyl-2-oxobutanoate dehydrogenase (ferredoxin)
    -L[node1146: 6.2.1.13 | ADP>ATP, -Pi, +CoA]- 2_methylbutanoate;  // acetate-CoA ligase (ADP-forming)

  pyruvate
    -R[node4274: 2.3.3.21 | Ac_CoA>CoA, -H2O {br=BR48833, ev=cof+eq, match=kegg}]-> R_citramalate  // (R)-citramalate synthase
    -[node4276: 4.2.1.35 | +H2O ^L {br=BR415, ev=cof+eq, match=kegg}]-> citraconate  // (R)-2-Methylmalate dehydratase
    -L[node4278: ? | -H2O ^R]- 2R_3S_3_methylmalate  // isopropylmalate isomerase
    -[node4267: 1.1.1.- | NAD>NADH, +CO2]- 2OBUT;  // 3-methyllmalate dehydrogenase

  propanoate
    -[node6452: 6.2.1.17 | ATP>AMP, -CoA, +H, +PPi {br=BR68, ev=cof+eq}]-> propanoyl_CoA  // Propionate-CoA ligase
    -[node6450: 1.2.7.11 | Fd_red>Fd_ox, -CO2, +CoA {br=BS189350, ev=cof-eq, match=kegg}]-> 2OBUT;  // 2-oxoacid oxidoreductase (ferredoxin)

  (tRNAIle + Ile) -[node10968: 6.1.1.5 | ATP>AMP, +PPi {br=BR56, ev=cof+eq}]-> L_isoleucyl_tRNAIle;  // Isoleucine-tRNA ligase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { 2OG Glu } forward { node4260 } backward { node4283 };
