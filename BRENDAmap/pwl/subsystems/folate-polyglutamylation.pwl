  flow right;
  compound 10_formyl_5_6_7_8_tetrahydropteroyl_gamma_Glu_n '10-formyl-5,6,7,8-tetrahydropteroyl-[gamma-Glu]n' brenda:191337;
  compound 10_formyl_5_6_7_8_tetrahydropteroyl_gamma_Glu_nplus1 '10-formyl-5,6,7,8-tetrahydropteroyl-[gamma-Glu]n+1' brenda:191335;
  compound 5_10_methylene_5_6_7_8_tetrahydropteroyl_gamma_Glu_n '5,10-methylene-5,6,7,8-tetrahydropteroyl-[gamma-Glu]n' brenda:189155;
  compound 5_10_methylene_5_6_7_8_tetrahydropteroyl_gamma_Glu_nplus1 '5,10-methylene-5,6,7,8-tetrahydropteroyl-[gamma-Glu]n+1' brenda:191336;
  compound 5_6_7_8_tetrahydropteroyl_gamma_Glu_n '5,6,7,8-tetrahydropteroyl-[gamma-Glu]n' brenda:191350;
  compound 5_6_7_8_tetrahydropteroyl_gamma_Glu_nplus1 '5,6,7,8-tetrahydropteroyl-[gamma-Glu]n+1' brenda:191339;
  compound ADP brenda:13 kegg:C00008;
