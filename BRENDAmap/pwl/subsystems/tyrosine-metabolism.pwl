pwl 2.0;
subsystem tyrosine-metabolism 'tyrosine metabolism' {
  // BRENDA subsystem: 25 reactions (21 with direction), 26 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 4_1_hydroxyethyl_phenol '4-(1-hydroxyethyl)phenol' brenda:29256 kegg:C13638;
  compound 4_Fumarylacetoacetate '4-Fumarylacetoacetate' brenda:15554 kegg:C01061;
  compound 4_Maleylacetoacetate '4-Maleylacetoacetate' brenda:4768 kegg:C01036;
  compound 4_coumarate '4-coumarate' brenda:1215 brenda:19540 kegg:C00811;
  compound 4_hydroxyphenyl_acetaldehyde '(4-hydroxyphenyl)acetaldehyde' brenda:2132 brenda:5883 kegg:C03765;
  compound 4_hydroxyphenylacetate '4-hydroxyphenylacetate' brenda:1708;
  compound 4_hydroxyphenylethanol '4-hydroxyphenylethanol' brenda:45201 kegg:C06044;
  compound 4_hydroxyphenylethyl_beta_D_glucoside '4-hydroxyphenylethyl beta-D-glucoside' brenda:91715;
  compound 4_hydroxyphenylpyruvate '4-hydroxyphenylpyruvate' brenda:423 brenda:42809;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound AcAc brenda:419 kegg:C00164;
  compound Ala brenda:103 kegg:C00041;
  compound CO2 brenda:28 kegg:C00011;
  compound E_4_coumaroyl_CoA '(E)-4-coumaroyl-CoA' brenda:237207 kegg:C00223;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2_L22 'H2O2' brenda:22 kegg:C00027;
  compound L_arogenate 'L-arogenate' brenda:883 kegg:C00826;
  compound L_tyrosyl_tRNATyr 'L-tyrosyl-tRNATyr' brenda:20766 kegg:C02839;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound R_3_4_hydroxyphenyl_lactoyl_CoA '(R)-3-(4-hydroxyphenyl)lactoyl-CoA' brenda:235295 kegg:C22205;
  compound Tyr brenda:109 kegg:C00082;
  compound UDP brenda:26 kegg:C00015;
  compound UDP_Glc 'UDP-Glc' brenda:64 kegg:C00029;
  compound cyclo_L_tyrosyl_L_tyrosyl 'cyclo(L-tyrosyl-L-tyrosyl)' brenda:28799 kegg:C20516;
  compound electron_transfer_flavoprotein 'electron-transfer flavoprotein' brenda:1601 kegg:C04253;
  compound fumarate brenda:170 kegg:C00122;
  compound homogentisate brenda:1826 kegg:C00544;
  compound mycocyclosin brenda:88404 kegg:C20517;
  compound oxidized_ferredoxin_Fe_S_cluster 'oxidized ferredoxin [Fe-S] cluster' brenda:202698 kegg:C00139;
  compound phenol brenda:249;
  compound phloretate brenda:44694 kegg:C01744;
  compound prephenate brenda:353 kegg:C00254;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_transfer_flavoprotein 'reduced electron-transfer flavoprotein' brenda:2112 kegg:C04570;
  compound reduced_ferredoxin_Fe_S_cluster 'reduced ferredoxin [Fe-S] cluster' brenda:202701 kegg:C00138;
  compound tRNATyr brenda:1307 kegg:C00787;
  compound tyramine brenda:280 kegg:C00483;
  port 4_hydroxyphenylacetate side U to 4-hydroxyphenylacetate-degradation;
  port L_arogenate side L to phenylalanine-metabolism;
  port Tyr side L to phenylalanine-metabolism;
  port Tyr side R to catecholamine-biosynthesis;
  port prephenate side L to phenylalanine-metabolism;
  port tyramine side R to methanofuran-biosynthesis;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    prephenate
      -R[node5926: 2.6.1.79 | Glu>2OG ^L {br=BR48630, ev=cof-eq}]-> L_arogenate  // glutamate-prephenate aminotransferase
      -L[node5929: 1.3.1.43 | NADP>NADPH, +CO2 {br=BR48485, ev=cof+eq}]-> Tyr  // arogenate dehydrogenase
      -[node5923: <-> 2.6.1.5 | Glu>2OG {br=BR47696, ev=cof-eq, rev=map} || node4775: -> 2.6.1.58 | pyruvate>Ala {br=BS353950, ev=cof+eq, match=single} || node5933: <-> 2.6.1.5 | 2OG>Glu {br=BR47696, ev=cof+eq, rev=map}]- 4_hydroxyphenylpyruvate  // tyrosine transaminase; phenylalanine(histidine) transaminase; tyrosine transaminase
      <-B[node5918: 1.3.1.12 | NAD>NADH, +CO2 ^L {br=BR36797, ev=cof+eq}]- prephenate;  // prephenate dehydrogenase
  }

  Tyr
    -R[node3300: 4.1.1.25 | +CO2 ^L {br=BR286, ev=cof+eq}]-> tyramine  // Tyrosine decarboxylase
    -[node12476: 1.4.3.4 | -H2O, -O2, +H2O2_L22, +NH3]- 4_hydroxyphenyl_acetaldehyde#2  // monoamine oxidase
    -L[node12483: 1.1.1.1 | NADPH>NADP ^L]- 4_hydroxyphenylethanol  // alcohol dehydrogenase
    -[node12487: 2.4.1.35 | UDP_Glc>UDP ^L {br=BS322677, ev=cof+eq}]-> 4_hydroxyphenylethyl_beta_D_glucoside;  // phenol beta-glucosyltransferase

  Tyr
    -R[node4765: 4.1.99.2 | -H2O, +NH3, +phenol {br=BR3380, ev=cof+eq}]-> pyruvate;  // tyrosine phenol-lyase

  4_hydroxyphenylpyruvate
    -[node5949: 1.2.3.13 | -O2, +2*CO2, +H2O ^R {br=BR29429, ev=cof+eq}]-> 4_hydroxyphenylacetate;  // 4-hydroxyphenylpyruvate oxidase

  4_hydroxyphenylpyruvate
    -R[node5936: 1.13.11.27 | -O2, +CO2 ^L {br=BR37066, ev=cof+eq}]-> homogentisate  // 4-hydroxyphenylpyruvate dioxygenase
    -[node5940: 1.13.11.5 | -O2 ^L {br=BR40469, ev=cof+eq}]-> 4_Maleylacetoacetate  // homogentisate 1,2-dioxygenase
    -L[node5943: 5.2.1.2 {br=BR211, ev=eq}]-> 4_Fumarylacetoacetate;  // Maleylacetoacetate isomerase

  4_hydroxyphenylpyruvate
    -R[node4772: 4.1.1.80 | +CO2 ^L {br=BR40592, ev=cof+eq}]-> 4_hydroxyphenyl_acetaldehyde  // 4-hydroxyphenylpyruvate decarboxylase
    -[node4769: 1.1.1.21 | NADH>NAD ^L]- 4_1_hydroxyethyl_phenol;  // aldose reductase

  4_hydroxyphenylpyruvate
    -[node1383: 1.1.1.110 | NADH>NAD ^R]- 4_hydroxyphenylpyruvate#2;  // aromatic 2-oxoacid reductase

  L_tyrosyl_tRNATyr
    -R[node1949: 2.3.2.21 {br=BR50538, ev=eq}]-> cyclo_L_tyrosyl_L_tyrosyl  // cyclo(L-tyrosyl-L-tyrosyl) synthase
    -[node1947: 1.14.19.70 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +2*H2O {br=BR50527, ev=cof+eq}]-> mycocyclosin;  // mycocyclosin synthase

  R_3_4_hydroxyphenyl_lactoyl_CoA
    -[node1160: 4.2.1.175 | +H2O ^L {br=BR52948, ev=cof+eq}]-> E_4_coumaroyl_CoA;  // (R)-3-(aryl)lactoyl-CoA dehydratase

  phloretate
    -B[node1163: 1.3.8.15 | -electron_transfer_flavoprotein, +reduced_electron_transfer_flavoprotein {br=BR52970, ev=cof+eq}]-> 4_coumarate;  // 3-(aryl)acrylate reductase

  (4_hydroxyphenylpyruvate#2 + E_4_coumaroyl_CoA) -[node1157: 2.8.3.17 {br=BR52901, ev=eq}]-> (4_coumarate + R_3_4_hydroxyphenyl_lactoyl_CoA);  // 3-(aryl)acryloyl-CoA:(R)-3-(aryl)lactate CoA-transferase
  (tRNATyr + Tyr) -[node2598: 6.1.1.1 | ATP>AMP, +PPi {br=BR39, ev=cof+eq}]-> L_tyrosyl_tRNATyr;  // Tyrosine-tRNA ligase
  4_Fumarylacetoacetate -[node5945: 3.7.1.2 | -H2O {br=BR29548, ev=cof+eq}]-> (AcAc + fumarate);  // fumarylacetoacetase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { 4_hydroxyphenylpyruvate 4_coumarate } bypasses { 4_hydroxyphenylpyruvate R_3_4_hydroxyphenyl_lactoyl_CoA E_4_coumaroyl_CoA 4_coumarate };
  motif shunt { prephenate 4_hydroxyphenylpyruvate } bypasses { prephenate L_arogenate Tyr 4_hydroxyphenylpyruvate };
  motif carrier { 2OG Glu } forward { node5933 } backward { node5923 node5926 };
  motif carrier { NAD NADH } forward { node5918 } backward { node1383 node4769 };
  motif carrier { NADP NADPH } forward { node5929 } backward { node12483 };
}
