pwl 2.0;
subsystem C30-carotenoid-biosynthesis 'C30 carotenoid biosynthesis' {
  // BRENDA subsystem: 13 reactions (11 with direction), 16 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 12_methyltetradecanoic_acid '12-methyltetradecanoic acid' brenda:172677 kegg:C16665;
  compound 12_methyltetradecanoyl_CoA '12-methyltetradecanoyl-CoA' brenda:245118;
  compound 15_cis_4_4_diapophytoene '15-cis-4,4\'-diapophytoene' brenda:10337 kegg:C16144;
  compound 2E_6E_farnesyl_PP '(2E,6E)-farnesyl-PP' brenda:1392;
  compound 4_4_diapolycopene_4_4_dioate '4,4\'-diapolycopene-4,4\'-dioate' brenda:221222 kegg:C21770;
  compound 4_4_diapolycopenedial '4,4\'-diapolycopenedial' brenda:82537 kegg:C19798;
  compound 4_4_diaponeurosporen_4_al '4,4\'-diaponeurosporen-4-al' brenda:41751 kegg:C19839;
  compound 4_4_diaponeurosporenoic_acid '4,4\'-diaponeurosporenoic acid' brenda:89260;
  compound AH2 brenda:327 kegg:C00030;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound FAD brenda:20 kegg:C00016;
  compound FADH2 brenda:256 kegg:C01352;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound UDP brenda:26 kegg:C00015;
  compound UDP_Glc_L364 'UDP-Glc' brenda:364 kegg:C00029;
  compound acceptor brenda:66 brenda:3161;
  compound all_trans_4_4_diapo_zeta_carotene 'all-trans-4,4\'-diapo-zeta-carotene' brenda:15136;
  compound all_trans_4_4_diapolycopene 'all-trans-4,4\'-diapolycopene' brenda:15137;
  compound all_trans_4_4_diaponeurosporene 'all-trans-4,4\'-diaponeurosporene' brenda:15138;
  compound all_trans_4_4_diapophytofluene 'all-trans-4,4\'-diapophytofluene' brenda:19413;
  compound benzoate brenda:316;
  compound beta_D_glucosyl_4_4_diaponeurosporenoic_acid 'beta-D-glucosyl 4,4\'-diaponeurosporenoic acid' brenda:89335;
  compound presqualene_diphosphate 'presqualene diphosphate' brenda:5208 kegg:C03428;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound staphyloxanthin brenda:89293 kegg:C16148;
  port 2E_6E_farnesyl_PP side U to isoprenoid-biosynthesis;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    react [node1050: 2.3.1.- | +CoA] {12_methyltetradecanoyl_CoA, beta_D_glucosyl_4_4_diaponeurosporenoic_acid, staphyloxanthin};  // glycosyl-4,4'-diaponeurosporenoate acyltransferase
    react [node1061: 2.3.1.B26 | +H2O] {beta_D_glucosyl_4_4_diaponeurosporenoic_acid, 12_methyltetradecanoic_acid, staphyloxanthin};  // glycosyl-4,4'-diaponeurosporenoate acyltransferase
  }

  2E_6E_farnesyl_PP
    -[node1090: 2.5.1.96 | +PPi ^R {br=BR49808, ev=cof+eq}]-> presqualene_diphosphate  // 4,4'-diapophytoene synthase
    -[node1088: 2.5.1.96 | +PPi ^R {br=BR49809, ev=cof+eq}]-> 15_cis_4_4_diapophytoene  // 4,4'-diapophytoene synthase
    -B[node1085: 1.3.8.2 | FAD>FADH2 ^R {br=BR49746, ev=cof+eq}]-> all_trans_4_4_diapophytofluene  // 4,4'-diapophytoene desaturase (4,4'-diapolycopene-forming)
    -[node1081: 1.3.8.2 | FAD>FADH2 ^R {br=BR49747, ev=cof+eq}]-> all_trans_4_4_diapo_zeta_carotene  // 4,4'-diapophytoene desaturase (4,4'-diapolycopene-forming)
    -B[node1077: 1.3.8.2 | FAD>FADH2 ^L {br=BR49748, ev=cof+eq}]-> all_trans_4_4_diaponeurosporene  // 4,4'-diapophytoene desaturase (4,4'-diapolycopene-forming)
    -[node1054: 1.3.8.2 | FAD>FADH2 ^L {br=BR49749, ev=cof+eq}]-> all_trans_4_4_diapolycopene  // 4,4'-diapophytoene desaturase (4,4'-diapolycopene-forming)
    -R[node12435: 1.14.99.44 | 4*reduced_acceptor>4*acceptor, -4*O2, +6*H2O {br=BR49608, ev=cof+eq}]-> 4_4_diapolycopenedial  // diapolycopene oxygenase
    -[node12442: 1.2.99.10 | 2*acceptor>2*reduced_acceptor, -2*H2O {br=BR52235, ev=cof+eq, match=kegg}]-> 4_4_diapolycopene_4_4_dioate;  // 4,4'-diapolycopenoate synthase

  all_trans_4_4_diaponeurosporene
    -B[node1071: 1.14.99.44 | -O2, -AH2, +benzoate, +H2O {br=BS416269, ev=cof+eq}]-> 4_4_diaponeurosporen_4_al  // diapolycopene oxygenase
    -[node1067: 1.2.1.B23 | NADP>NADPH, +H ^R {br=BR50603, ev=cof+eq}]-> 4_4_diaponeurosporenoic_acid;  // 4,4'-diaponeurosporen-aldehyde dehydrogenase

  (UDP_Glc_L364 + 4_4_diaponeurosporenoic_acid) -[node1058: 2.4.1.B54 | +UDP {br=BR50664, ev=cof+eq}]-> beta_D_glucosyl_4_4_diaponeurosporenoic_acid;  // 4,4'-diaponeurosporenoate glucosyltransferase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { acceptor reduced_acceptor } forward { node12442 } backward { node12435 };
}
