pwl 2.0;
subsystem aminopropanol-phosphate-biosynthesis 'aminopropanol phosphate biosynthesis' {
  // BRENDA subsystem: 4 reactions (3 with direction), 5 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound O_phospho_Thr 'O-phospho-Thr' brenda:4927 kegg:C12147;
  compound R_1_aminopropan_2_ol '(R)-1-aminopropan-2-ol' brenda:9299;
  compound R_1_aminopropan_2_yl_phosphate '(R)-1-aminopropan-2-yl phosphate' brenda:22041 kegg:C04122;
  compound Thr brenda:250 kegg:C00188;
  compound aminoacetone brenda:8045 kegg:C01888;
  port R_1_aminopropan_2_yl_phosphate side U to vitamin-B12-metabolism;
  port aminoacetone side D to threonine-metabolism;

  Thr
    -[node6944: 2.7.1.177 | ATP>ADP ^R {br=BR50002, ev=cof+eq}]-> O_phospho_Thr  // L-threonine kinase
    -B[node6946: 4.1.1.81 | +CO2 ^L {br=BR48003, ev=cof+eq, match=kegg}]-> R_1_aminopropan_2_yl_phosphate  // threonine-phosphate decarboxylase
    -[node6939: ? | ATP>ADP, +H]- R_1_aminopropan_2_ol  // hypothetical reaction
    -L[node6937: 1.1.1.75 | NAD>NADH ^L {br=BR29336, ev=cof+eq}]-> aminoacetone;  // (R)-aminopropanol dehydrogenase
}
