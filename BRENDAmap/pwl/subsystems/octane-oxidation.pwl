pwl 2.0;
subsystem octane-oxidation 'octane oxidation' {
  // BRENDA subsystem: 5 reactions (4 with direction), 7 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 1_octanal '1-octanal' brenda:6410 kegg:C01545;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound O2 brenda:9 brenda:1180;
  compound Octanol brenda:1241;
  compound PPi brenda:17 kegg:C00013;
  compound n_octane 'n-octane' brenda:32341 kegg:C01387;
  compound octanoate brenda:865 kegg:C06423;
  compound octanoyl_CoA 'octanoyl-CoA' brenda:385 kegg:C01944;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound oxidized_rubredoxin 'oxidized rubredoxin' brenda:1837 kegg:C00435;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound reduced_rubredoxin 'reduced rubredoxin' brenda:1337 kegg:C00340;
  port octanoate side U to lipoate-biosynthesis;
  port octanoyl_CoA side R to tryptophan-metabolism;

  reduced_rubredoxin
    -B[node3458: 1.18.1.1 | NADH>NAD ^L {br=BR40365-a, ev=eq}]-> oxidized_rubredoxin;  // rubredoxin-NAD+ reductase

  Octanol
    -[node3446: 1.1.99.- | oxidized_electron_acceptor>reduced_electron_acceptor ^R]- 1_octanal  // octanol dehydrogenase
    -[node3454: 1.2.1.3 | NAD>NADH, -H2O {br=BS189254, ev=cof+eq, match=kegg}]-> octanoate  // aldehyde dehydrogenase (NAD+)
    -[node7703: 6.2.1.3 | ATP>AMP, -CoA, +H, +PPi {br=BS158, ev=cof+eq, match=similar}]-> octanoyl_CoA;  // long-chain-fatty-acid-CoA ligase

  (n_octane + reduced_rubredoxin) -[node3450: 1.14.15.3 | -O2, +H2O {br=BR29151, ev=cof+eq, match=single}]-> (oxidized_rubredoxin + Octanol);  // alkane 1-monooxygenase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node3454 } backward { node3458 };
}
