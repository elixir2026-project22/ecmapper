pwl 2.0;
subsystem coenzyme-A-metabolism 'coenzyme A metabolism' {
  // BRENDA subsystem: 5 reactions (5 with direction), 6 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 4_P_N_pantothenoylcysteine '4\'-P-N-pantothenoylcysteine' brenda:29211 kegg:C04352;
  compound 4_P_pantothenate '4\'-P-pantothenate' brenda:4183 brenda:145796 kegg:C03492;
  compound 4_phosphopantetheine '4\'-phosphopantetheine' brenda:1273 kegg:C01134;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CMP brenda:100 kegg:C00055;
  compound CO2 brenda:28 kegg:C00011;
  compound CTP brenda:60 kegg:C00063;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Cys brenda:74 kegg:C00097;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound PPi brenda:17 kegg:C00013;
  compound R_pantothenate '(R)-pantothenate' brenda:2630 kegg:C00864;
  compound dephospho_CoA 'dephospho-CoA' brenda:2018 kegg:C00882;
  port CoA side L to purine-metabolism;
  port R_pantothenate side R to pantothenate-biosynthesis;

  R_pantothenate
    -[node6406: 2.7.1.33 | ATP>ADP, +H {br=BR47773, ev=cof+eq}]-> 4_P_pantothenate  // pantothenate kinase
    -[node6408: 6.3.2.5 | CTP>CMP, -Cys, +H, +PPi {br=BR48388, ev=cof+eq, match=kegg}]-> 4_P_N_pantothenoylcysteine  // phosphopantothenate-cysteine ligase (CTP)
    -[node6409: 4.1.1.36 | -H, +CO2 ^R {br=BR295, ev=cof+eq, match=single}]-> 4_phosphopantetheine  // phosphopantothenoylcysteine decarboxylase
    -[node6405: 2.7.7.3 | -ATP, +PPi ^R {br=BR47876, ev=cof+eq, match=kegg}]-> dephospho_CoA  // pantetheine-phosphate adenylyltransferase
    -[node6411: 2.7.1.24 | ATP>ADP, +H {br=BR48063, ev=cof+eq, match=kegg}]-> CoA;  // dephospho-CoA kinase
}
