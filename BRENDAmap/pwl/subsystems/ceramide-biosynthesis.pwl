pwl 2.0;
subsystem ceramide-biosynthesis 'ceramide biosynthesis' {
  // BRENDA subsystem: 5 reactions (4 with direction), 6 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 3_dehydrosphinganine '3-dehydrosphinganine' brenda:12337 kegg:C02934;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Ser brenda:95 kegg:C00065;
  compound a_4E_sphing_4_enine_ceramide 'a (4E)-sphing-4-enine ceramide' brenda:202596;
  compound acyl_CoA_L6656 'acyl-CoA' brenda:6656 kegg:C00040;
  compound dihydroceramide brenda:16848 kegg:C12126;
  compound ferricytochrome_b5 'ferricytochrome b5' brenda:1034 kegg:C00996;
  compound ferrocytochrome_b5 'ferrocytochrome b5' brenda:1129 kegg:C00999;
  compound palmitate brenda:517 kegg:C00249;
  compound palmitoyl_CoA 'palmitoyl-CoA' brenda:128 kegg:C00154;
  compound sphinganine brenda:2221 kegg:C00836;
  port palmitate side L to arachidonate-biosynthesis;

  palmitate
    -[node8244: 6.2.1.3 | ATP>AMP, -CoA, +PPi]- palmitoyl_CoA  // long-chain-fatty-acid-CoA ligase
    -[node8235: 2.3.1.50 | -H, -Ser, +CO2, +CoA {br=BR44052, ev=cof+eq}]-> 3_dehydrosphinganine  // serine C-palmitoyltransferase
    -[node8239: 1.1.1.102 | NADPH>NADP ^R {br=BR29168, ev=cof-eq}]-> sphinganine  // 3-dehydrosphinganine reductase
    -[node8225: 2.3.1.24 | -acyl_CoA_L6656, +CoA ^L {br=BS320738, ev=cof+eq, match=kegg}]-> dihydroceramide  // sphingosine N-acyltransferase
    -[node8237: 1.14.19.17 | -O2, -2*ferrocytochrome_b5, +2*ferricytochrome_b5, +2*H2O {br=BR51368, ev=cof+eq, match=single}]-> a_4E_sphing_4_enine_ceramide;  // sphingolipid 4-desaturase
}
