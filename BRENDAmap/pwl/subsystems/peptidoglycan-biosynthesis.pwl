  react [node6762: 2.7.8.13 | +UMP] {ditrans_octacis_undecaprenyl_P, UDP_N_acetylmuramoyl_L_alanyl_D_gamma_glutamyl_meso_2_6_diaminoheptanedioate, N_acetylmuramoyl_L_alanyl_D_glutamyl_meso_2_6_diaminopimelyl_D_alanyl_D_alanine_diphosphoundecaprenol};  // phospho-N-acetylmuramoyl-pentapeptide-transferase
  (D_Glu + UDP_MurNAc_Ala) -[node6723: 6.3.2.9 | ATP>ADP, +Pi {br=BS416658, ev=cof+eq}]-> UDP_MurNAc_Ala_D_Glu;  // UDP-N-acetylmuramoyl-L-alanine-D-glutamate ligase
