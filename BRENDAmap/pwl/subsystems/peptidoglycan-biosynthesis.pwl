    -R[node6768: 2.4.1.227 | UDP_GlcNAc>UDP, +H]- N_acetylmuramoyl_L_alanyl_D_glutamyl_meso_2_6_diaminopimelyl_D_alanyl_D_alanine_diphosphoundecaprenyl_N_acetylglucosamine;  // undecaprenyldiphospho-muramoylpentapeptide beta-N-acetylglucosaminyltransferase

