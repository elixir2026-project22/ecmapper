pwl 2.0;
subsystem violacein-biosynthesis 'violacein biosynthesis' {
  // BRENDA subsystem: 13 reactions (9 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2_imino_3_indol_3_yl_propanoate '2-imino-3-(indol-3-yl)propanoate' brenda:221590 kegg:C21124;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2_L22 'H2O2' brenda:22 kegg:C00027;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound N_2_carboxylatoamino_1_2_bis_1H_indol_3_yl_ethyl_carbamate 'N-[2-(carboxylatoamino)-1,2-bis(1H-indol-3-yl)ethyl]carbamate' brenda:250313;
  compound O2 brenda:9 brenda:1180;
  compound Trp brenda:119 kegg:C00078;
  compound deoxyviolacein brenda:214931 kegg:C21133;
  compound deoxyviolaceinate brenda:212311 kegg:C21132;
  compound prodeoxyviolacein brenda:215297;
  compound protodeoxyviolaceinate brenda:208941 kegg:C21131;
  compound protoviolaceinate brenda:208942 kegg:C21134;
  compound proviolacein brenda:215304;
  compound violacein brenda:215459 kegg:C21136;
  compound violaceinate brenda:212310 kegg:C21135;
  port Trp side R to tryptophan-metabolism;

  Trp
    -[node12542: 1.4.3.23 | -O2, +H2O2_L22 ^L {br=BS440306, ev=cof+eq}]-> 2_imino_3_indol_3_yl_propanoate  // 7-chloro-L-tryptophan oxidase
    -[node12549: 1.21.98.2 | -H2O2_L22, +H2O ^L]- N_2_carboxylatoamino_1_2_bis_1H_indol_3_yl_ethyl_carbamate  // dichlorochromopyrrolate synthase
    -[node12554: ? | -H, +CO2, +NH3]- protodeoxyviolaceinate  // unknown enzyme
    -R[node812: ~? | -H, -O2, +CO2, +H2O {br=BR53161, ev=cof+eq}]-> prodeoxyviolacein;  // spontaneous reaction

  protodeoxyviolaceinate
    -L[node798: 1.14.13.217 | NADPH>NADP, -O2, +H2O {br=BR51577, ev=cof+eq} || node70: 1.14.13.217 | NADH>NAD, -O2, +H2O {br=BR51577-a, ev=cof+eq}]-> protoviolaceinate  // protodeoxyviolaceinate monooxygenase; protodeoxyviolaceinate monooxygenase
    -L[node790: ~? | -H, -O2, +CO2, +H2O {br=BR53163, ev=cof+eq}]-> proviolacein;  // spontaneous reaction

  protodeoxyviolaceinate
    -[node78: 1.14.13.224 | NADH>NAD, -O2, +H2O || node802: 1.14.13.224 | NADPH>NADP, -O2, +H2O]- deoxyviolaceinate  // violacein synthase; violacein synthase
    -[node12556: ~? | -H, -O2, +H2O, +CO2 {br=BR53162, ev=cof+eq}]-> deoxyviolacein;  // spontaneous reaction

  protoviolaceinate
    -[node75: 1.14.13.224 | NADH>NAD, -O2, +H2O {br=BR51738-a, ev=cof+eq} || node784: 1.14.13.224 | NADPH>NADP, -O2, +H2O {br=BR51738, ev=cof+eq}]-> violaceinate  // violacein synthase; violacein synthase
    -[node778: ~? | -H, -O2, +CO2, +H2O {br=BR53164, ev=cof+eq}]-> violacein;  // spontaneous reaction
}
