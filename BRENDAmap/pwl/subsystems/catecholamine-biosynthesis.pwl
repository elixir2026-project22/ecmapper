pwl 2.0;
subsystem catecholamine-biosynthesis 'catecholamine biosynthesis' {
  // BRENDA subsystem: 4 reactions (3 with direction), 5 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 4a_hydroxy_tetrahydrobiopterin '4a-hydroxy-tetrahydrobiopterin' brenda:3853 brenda:35294 kegg:C15522;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_DOPA 'L-DOPA' brenda:320 kegg:C00355;
  compound L_ascorbate 'L-ascorbate' brenda:548 kegg:C00072;
  compound L_dehydroascorbate 'L-dehydroascorbate' brenda:8124 kegg:C05422;
  compound O2 brenda:9 brenda:1180;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound Tyr brenda:109 kegg:C00082;
  compound adrenaline brenda:3189;
  compound dopamine brenda:242 kegg:C03758;
  compound noradrenaline brenda:2574 kegg:C00547;
  compound tetrahydrobiopterin brenda:252 kegg:C00272;
  port Tyr side L to tyrosine-metabolism;

  Tyr
    -[node10512: 1.14.16.2 | -tetrahydrobiopterin, -O2, +4a_hydroxy_tetrahydrobiopterin]- L_DOPA  // tyrosine 3-monooxygenase
    -[node10517: 4.1.1.28 | -H, +CO2 ^R {br=BR287, ev=cof+eq}]-> dopamine  // aromatic-L-amino-acid decarboxylase
    -[node10521: 1.14.17.1 | -H, -O2, -2*L_ascorbate, +H2O, +L_dehydroascorbate {br=BR40401, ev=cof+eq}]-> noradrenaline  // dopamine beta-monooxygenase
    -[node10523: 2.1.1.28 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine, +H {br=BS356026, ev=cof+eq, match=single}]-> adrenaline;  // phenylethanolamine N-methyltransferase
}
