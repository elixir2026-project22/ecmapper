pwl 2.0;
subsystem sulfate-reduction 'sulfate reduction' {
  // BRENDA subsystem: 17 reactions (15 with direction), 8 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 3_phosphoadenylyl_sulfate '3\'-phosphoadenylyl sulfate' brenda:112 brenda:205 brenda:137922 kegg:C00053;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound GSH brenda:44 kegg:C00051;
  compound GSSG brenda:973 kegg:C00127;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2 brenda:361 kegg:C00282;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound H2S brenda:911 kegg:C00283;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound SO4 brenda:160 kegg:C00059;
  compound acetyl_phosphate 'acetyl phosphate' brenda:358 kegg:C00227;
  compound adenosine_3_5_bisphosphate 'adenosine 3\',5\'-bisphosphate' brenda:68 kegg:C00054;
  compound adenosine_5_phosphosulfate 'adenosine 5\'-phosphosulfate' brenda:425 kegg:C00224;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound ox_thioredoxin 'ox. thioredoxin' brenda:1795 kegg:C00343;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound red_thioredoxin 'red. thioredoxin' brenda:1120 kegg:C00342;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound sulfite brenda:92 kegg:C00094;
  compound sulfoacetaldehyde brenda:7288 kegg:C00593;
  compound sulfur brenda:871 kegg:C00087;
  port sulfoacetaldehyde side R to taurine-degradation;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    adenosine_5_phosphosulfate
      -B[node4077: 2.7.1.25 | ATP>ADP, +H {br=BR47764, ev=cof+eq}]-> 3_phosphoadenylyl_sulfate  // adenylyl-sulfate kinase
      -B[node4083: 1.8.4.8 | -red_thioredoxin, +ox_thioredoxin, +adenosine_3_5_bisphosphate {br=BR15888, ev=cof-eq}]-> sulfite  // phosphoadenylyl-sulfate reductase (thioredoxin)
      <-[node7033: 1.8.99.2 | reduced_electron_acceptor>oxidized_electron_acceptor, +AMP {br=BR36969, ev=cof-eq}]- adenosine_5_phosphosulfate#2  // adenylyl-sulfate reductase
      <-B[node7031: 2.7.7.4 | -ATP, +PPi ^R {br=BR47884, ev=cof+eq}]- SO4  // sulfate adenylyltransferase
      -[node4086: 2.7.7.4 | -ATP, +PPi {br=BR47884, ev=cof+eq} || node11153: 2.7.7.5 | -ADP, +Pi {br=BR47891, ev=cof+eq}]-> adenosine_5_phosphosulfate;  // sulfate adenylyltransferase; sulfate adenylyltransferase (ADP)
    chord sulfite -[node7611: 1.8.3.1 | -H2O, -O2, +H2O2 {br=BR36932, ev=cof+eq} || node7604: 1.8.2.1 | -H2O, -2*ferricytochrome_c, +2*ferrocytochrome_c {br=BR36974, ev=cof+eq}]-> SO4;  // sulfite oxidase; sulfite dehydrogenase (cytochrome)
    chord sulfite -L[node10873: 1.8.4.9 | -GSSG, -AMP, +2*GSH {br=BR29461, ev=cof+eq}]-> adenosine_5_phosphosulfate;  // adenylyl-sulfate reductase (glutathione)
  }

  sulfite
    -[node10881: 1.8.7.1 | 3*Fd_red>3*Fd_ox, -6*H, +3*H2O {br=BR40346, ev=cof-eq} || node4082: 1.8.1.2 | 3*NADPH>3*NADP, -3*H, +3*H2O {br=BR36931, ev=cof-eq}]-> H2S  // assimilatory sulfite reductase (ferredoxin); assimilatory sulfite reductase (NADPH)
    -L[node11068: <- 1.12.98.B1 | -H2 {br=BR50566, ev=cof+eq} || node10865: 1.8.1.18 | NADP>NADPH, +H || node69: 1.8.1.18 | NAD>NADH, +H]- sulfur  // hydrogen:sulfur oxidoreductase; NAD(P)H sulfur oxidoreductase (CoA-dependent); NAD(P)H sulfur oxidoreductase (CoA-dependent)
    -L[node10844: 1.13.11.18 | -H2O, -O2 ^L {br=BS288973, ev=cof+eq}]-> sulfite  // persulfide dioxygenase
    <-B[node7613: 2.3.3.15 | -Pi, +acetyl_phosphate, +H ^L {br=BR47451, ev=cof-eq, match=kegg}]- sulfoacetaldehyde;  // sulfoacetaldehyde acetyltransferase

  4*sulfur -[node10847: 1.13.11.55 | -4*H2O, -O2 {br=BR48661, ev=cof+eq}]-> (2*sulfite + 2*H2S);  // sulfur oxygenase/reductase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { 3_phosphoadenylyl_sulfate sulfite SO4 adenosine_5_phosphosulfate };
  motif substrate_cycle { adenosine_5_phosphosulfate sulfite } forward { node7033 } backward { node10873 };
  motif carrier { NADP NADPH } forward { node10865 } backward { node4082 };
}
