pwl 2.0;
subsystem biotin-biosynthesis 'biotin biosynthesis' {
  // BRENDA subsystem: 8 reactions (7 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 5_deoxyadenosine '5\'-deoxyadenosine' brenda:943 kegg:C05198;
  compound 7_8_diaminononanoate '7,8-diaminononanoate' brenda:3792 kegg:C01037;
  compound 8_NH2_7_oxononanoate '8-NH2-7-oxononanoate' brenda:1494 kegg:C01092;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound Ala brenda:103 kegg:C00041;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound HCO3 brenda:195 kegg:C00288;
  compound Holo_ACP 'Holo-ACP' brenda:2745 kegg:C00229;
  compound Met brenda:88 kegg:C00073;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound Pimelyl_ACP 'Pimelyl-ACP' brenda:82552 kegg:C19845;
  compound S_adenosyl_4_methylthio_2_oxobutanoate 'S-adenosyl-4-methylthio-2-oxobutanoate' brenda:10769 kegg:C04425;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound biotin brenda:143 kegg:C00120;
  compound biotin_carboxyl_carrier_protein_L_lysine '[biotin carboxyl-carrier protein]-L-lysine' brenda:221295 kegg:C06249;
  compound biotin_carboxyl_carrier_protein_N6_biotinyl_L_lysine '[biotin carboxyl-carrier protein]-N6-biotinyl-L-lysine' brenda:221296 kegg:C06250;
  compound biotin_carboxyl_carrier_protein_biotin_N6_L_lysine '[biotin carboxyl-carrier protein]-biotin-N6-L-lysine' brenda:221293 kegg:C06250;
  compound biotin_carboxyl_carrier_protein_carboxybiotin_N6_L_lysine '[biotin carboxyl-carrier protein]-carboxybiotin-N6-L-lysine' brenda:221294 kegg:C04419;
  compound dethiobiotin brenda:2553 kegg:C01909;
  compound malonyl_CoA 'malonyl-CoA' brenda:76 kegg:C00083;
  compound sulfur brenda:871 kegg:C00087;
  port Ala side L to alanine-metabolism;

  biotin_carboxyl_carrier_protein_carboxybiotin_N6_L_lysine
    -[node3550: <- 6.3.4.14 | ATP>ADP, -HCO3, +Pi {br=BR135, ev=cof+eq} || node3537: -> 2.1.3.15 | -Ac_CoA, +malonyl_CoA {br=BR52249, ev=cof+eq, match=kegg}]- biotin_carboxyl_carrier_protein_biotin_N6_L_lysine  // Biotin carboxylase; acetyl-CoA carboxytransferase
    -[node3544: ~?]- biotin_carboxyl_carrier_protein_N6_biotinyl_L_lysine;  // spontaneous reaction

  8_NH2_7_oxononanoate
    -[node6431: 2.6.1.62 | -S_adenosyl_L_methionine, +S_adenosyl_4_methylthio_2_oxobutanoate ^R {br=BR47441, ev=cof+eq}]-> 7_8_diaminononanoate  // adenosylmethionine-8-amino-7-oxononanoate transaminase
    -[node6433: 6.3.3.3 | ATP>ADP, -CO2, +H, +Pi {br=BR128, ev=cof+eq}]-> dethiobiotin  // Dethiobiotin synthase
    -[node6430: 2.8.1.6 | -sulfur, -H, -2*S_adenosyl_L_methionine, +2*5_deoxyadenosine, +2*Met {br=BS398860, ev=cof+eq}]-> biotin;  // biotin synthase

  (Ala + Pimelyl_ACP) -[node6428: 2.3.1.47 | +Holo_ACP, +CO2 {br=BR44048, ev=cof+eq, match=kegg}]-> 8_NH2_7_oxononanoate;  // 8-amino-7-oxononanoate synthase
  (biotin + biotin_carboxyl_carrier_protein_L_lysine) -[node3546: 6.3.4.15 | ATP>AMP, +PPi {br=BR136, ev=cof+eq}]-> biotin_carboxyl_carrier_protein_N6_biotinyl_L_lysine;  // biotin-[biotin carboxyl-carrier protein] ligase
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { biotin_carboxyl_carrier_protein_biotin_N6_L_lysine biotin_carboxyl_carrier_protein_carboxybiotin_N6_L_lysine } forward { node3550 } backward { node3537 };
}
