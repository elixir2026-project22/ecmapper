pwl 2.0;
subsystem degradation-of-sugar-acids 'degradation of sugar acids' {
  // BRENDA subsystem: 30 reactions (29 with direction), 29 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_5_dioxopentanoate '2,5-dioxopentanoate' brenda:3305 kegg:C00433;
  compound 2_dehydro_3_deoxy_D_galactonate '2-dehydro-3-deoxy-D-galactonate' brenda:3965 kegg:C01216;
  compound 2_dehydro_3_deoxy_D_galactonate_6_P '2-dehydro-3-deoxy-D-galactonate 6-P' brenda:7986 kegg:C01286;
  compound 2_dehydro_3_deoxy_D_gluconate '2-dehydro-3-deoxy-D-gluconate' brenda:1172 kegg:C00204;
  compound 2_dehydro_3_deoxy_L_galactonate '2-dehydro-3-deoxy-L-galactonate' brenda:14248 kegg:C20680;
  compound 2_hydroxy_3_oxopropanoate '2-hydroxy-3-oxopropanoate' brenda:7099 kegg:C01146;
  compound 2_phospho_D_glycerate '2-phospho-D-glycerate' brenda:10090 kegg:C00631;
  compound 5_dehydro_4_deoxy_D_glucarate '5-dehydro-4-deoxy-D-glucarate' brenda:5499 kegg:C00679;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound D_altronate 'D-altronate' brenda:7175 kegg:C00817;
  compound D_fructuronate 'D-fructuronate' brenda:8081 kegg:C00905;
  compound D_galactaro_1_4_lactone 'D-galactaro-1,4-lactone' brenda:202669 kegg:C20896;
  compound D_galactaro_1_5_lactone 'D-galactaro-1,5-lactone' brenda:200980 kegg:C20889;
  compound D_galactonate 'D-galactonate' brenda:3335 kegg:C00880;
  compound D_galacturonate 'D-galacturonate' brenda:1752 kegg:C00333;
  compound D_glucaro_1_4_lactone 'D-glucaro-1,4-lactone' brenda:96342 kegg:C21095;
  compound D_glucaro_1_5_lactone 'D-glucaro-1,5-lactone' brenda:196621 kegg:C20890;
  compound D_glycerate 'D-glycerate' brenda:2454 kegg:C00258;
  compound D_tagaturonate 'D-tagaturonate' brenda:10629 kegg:C00558;
  compound GAP brenda:147 kegg:C00118;
  compound GlcA brenda:339;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound KDPG brenda:8212 kegg:C04442;
  compound L_galactonate 'L-galactonate' brenda:4596 kegg:C15930;
  compound L_glyceraldehyde 'L-glyceraldehyde' brenda:2203 kegg:C02426;
  compound ManA brenda:3998 kegg:C00514;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound an_alcohol 'an alcohol' brenda:4599;
  compound beta_D_Glucuronoside 'beta-D-Glucuronoside' brenda:179806 kegg:C03033;
  compound galactarate brenda:3374 kegg:C00879;
  compound glucarate brenda:2195 kegg:C00818;
  compound glycerol brenda:135 kegg:C00116;
  compound pyruvate brenda:31 kegg:C00022;
  port 2_hydroxy_3_oxopropanoate side R to glycolate-and-glyoxylate-degradation;
  port 2_phospho_D_glycerate side R to glycolysis;
  port D_glycerate side R to glycolate-and-glyoxylate-degradation;

  // ring: cycle of the drawing (12 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    D_glucaro_1_4_lactone
      <-[node11450: ~? {br=BR52871, ev=eq}]- D_glucaro_1_5_lactone  // spontaneous reaction
      <-[node11445: 1.1.1.203 | NAD>NADH, +H ^L {br=BR51163, ev=cof+eq}]- GlcA  // uronate dehydrogenase
      -[node10023: 5.3.1.12 {br=BR221, ev=eq}]-> D_fructuronate  // Glucuronate isomerase
      -[node9977: 1.1.1.57 | NADH>NAD ^R {br=BR29320, ev=cof-eq}]-> ManA  // fructuronate reductase
      -[node10008: 4.2.1.8 | +H2O ^R {br=BR457, ev=cof+eq}]-> 2_dehydro_3_deoxy_D_gluconate  // Mannonate dehydratase
      <-B[node9994: 4.2.1.7 | +H2O ^L {br=BR3405, ev=cof+eq}]- D_altronate  // altronate dehydratase
      <-[node9990: 1.1.1.58 | NADH>NAD ^L {br=BR29321, ev=cof-eq}]- D_tagaturonate  // tagaturonate reductase
      <-[node9985: 5.3.1.12 {br=BS1018, ev=eq}]- D_galacturonate  // Glucuronate isomerase
      -B[node11458: 1.1.1.203 | NAD>NADH, +H ^R {br=BR29251, ev=cof+eq}]-> D_galactaro_1_5_lactone  // uronate dehydrogenase
      -B[node11456: 5.4.1.4 {br=BR51428, ev=eq}]-> D_galactaro_1_4_lactone  // D-galactarolactone isomerase
      -[node11454: 5.5.1.27 | +H ^R {br=BR51429, ev=eq}]-> 5_dehydro_4_deoxy_D_glucarate  // D-galactarolactone cycloisomerase
      <-B[node11447: 5.5.1.27 | +H ^L {br=BR51430, ev=eq, match=single}]- D_glucaro_1_4_lactone;  // D-galactarolactone cycloisomerase
  }

  D_galacturonate
    -L[node11467: 1.1.1.365 | NADPH>NADP {br=BS424745, ev=cof+eq}]-> L_galactonate  // D-galacturonate reductase
    -R[node11469: 4.2.1.146 | +H2O ^L {br=BR48938, ev=cof+eq}]-> 2_dehydro_3_deoxy_L_galactonate;  // L-galactonate dehydratase

  2_dehydro_3_deoxy_D_gluconate
    -B[node10015: 2.7.1.45 | ATP>ADP, +H {br=BR47415, ev=cof+eq}]-> KDPG;  // 2-dehydro-3-deoxygluconokinase

  beta_D_Glucuronoside
    -[node10009: 3.2.1.31 | -H2O, +an_alcohol ^R {br=BR2733, ev=cof+eq, match=single}]-> GlcA;  // beta-glucuronidase

  5_dehydro_4_deoxy_D_glucarate
    -L[node6771: 4.1.2.20 | +pyruvate ^L {br=BR352, ev=cof+eq, match=single}]-> 2_hydroxy_3_oxopropanoate  // 2-dehydro-3-deoxyglucarate aldolase
    -[node9997: 1.1.1.60 | NADPH>NADP ^L {br=BR29324, ev=cof-eq}]-> D_glycerate  // 2-hydroxy-3-oxopropionate reductase
    -[node9995: 2.7.1.165 | ATP>ADP, +H {br=BR48991, ev=cof+eq}]-> 2_phospho_D_glycerate;  // glycerate 2-kinase

  5_dehydro_4_deoxy_D_glucarate
    -L[node11463: 4.2.1.41 | -H, +H2O, +CO2 ^L {br=BR420, ev=cof+eq}]-> 2_5_dioxopentanoate;  // 5-dehydro-4-deoxyglucarate dehydratase

  glucarate
    -L[node9653: 4.2.1.40 | +H2O ^L {br=BR3394, ev=cof+eq}]-> 5_dehydro_4_deoxy_D_glucarate;  // glucarate dehydratase

  galactarate
    -L[node6772: 4.2.1.42 | +H2O ^R {br=BR421, ev=cof+eq, match=kegg}]-> 5_dehydro_4_deoxy_D_glucarate;  // Galactarate dehydratase

  D_galactonate
    -[node10630: 4.2.1.140 | +H2O {br=BR3401, ev=cof+eq} || node9780: 4.2.1.6 | +H2O {br=BR3401, ev=cof+eq}]-> 2_dehydro_3_deoxy_D_galactonate  // gluconate/galactonate dehydratase; galactonate dehydratase
    -[node2869: 2.7.1.178 | ATP>ADP {br=BR47788, ev=cof+eq, match=kegg} || node9754: 2.7.1.58 | ATP>ADP {br=BR47788, ev=cof+eq, match=kegg}]-> 2_dehydro_3_deoxy_D_galactonate_6_P;  // 2-dehydro-3-deoxyglucono/galactono-kinase; 2-dehydro-3-deoxygalactonokinase

  L_glyceraldehyde
    -[node11473: 1.1.1.265 | NADPH>NADP ^L]- glycerol;  // 3-methylbutanal reductase

  2_dehydro_3_deoxy_D_galactonate_6_P -[node9946: 4.1.2.21 {br=BR353, ev=eq, match=kegg}]-> (GAP + pyruvate);  // 2-dehydro-3-deoxy-6-phosphogalactonate aldolase
  2_dehydro_3_deoxy_D_galactonate_6_P -[node10628: 4.1.2.55 {br=BR353, ev=eq, match=kegg}]-> (GAP + pyruvate);  // 2-dehydro-3-deoxy-phosphogluconate/2-dehydro-3-deoxy-6-phosphogalactonate aldolase
  2_dehydro_3_deoxy_L_galactonate -[node11471: 4.1.2.54 {br=BR50713, ev=eq}]-> (pyruvate + L_glyceraldehyde);  // L-threo-3-deoxy-hexylosonate aldolase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node11445 node11458 } backward { node9977 node9990 };
}
