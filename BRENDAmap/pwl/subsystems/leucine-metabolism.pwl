pwl 2.0;
subsystem leucine-metabolism 'leucine metabolism' {
  // BRENDA subsystem: 24 reactions (17 with direction), 26 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 2R_3S_Isopropylmalate '(2R,3S)-Isopropylmalate' brenda:1131 kegg:C04411;
  compound 2S_2_isopropyl_3_oxosuccinate '(2S)-2-isopropyl-3-oxosuccinate' brenda:57980 kegg:C04236;
  compound 2S_2_isopropylmalate '(2S)-2-isopropylmalate' brenda:13432 kegg:C02504;
  compound 2_Isopropylmaleate '2-Isopropylmaleate' brenda:15500 kegg:C02631;
  compound 3R_beta_leucine '(3R)-beta-leucine' brenda:95427 kegg:C02486;
  compound 3_Methyl_butanoyl_CoA '3-Methyl-butanoyl-CoA' brenda:91507 kegg:C02939;
  compound 3_Methylbutanal '3-Methylbutanal' brenda:2711 kegg:C07329;
  compound 3_Methylbutanol '3-Methylbutanol' brenda:8008 kegg:C07328;
