  compound 3_methylbutanoate '3-methylbutanoate' brenda:57503 kegg:C08262;
  compound 4_methyl_2_oxopentanoate '4-methyl-2-oxopentanoate' brenda:722 kegg:C00233;
  compound 4_methyl_3_oxopentanoate '4-methyl-3-oxopentanoate' brenda:126328 kegg:C03467;
  compound 4_methylpent_2_enoate '4-methylpent-2-enoate' brenda:202581;
  compound 4_methylpent_2_enoyl_CoA '4-methylpent-2-enoyl-CoA' brenda:196711 kegg:C21090;
  compound 4_methylpentanoate '4-methylpentanoate' brenda:8383 kegg:C21399;
  compound 4_methylpentanoyl_CoA '4-methylpentanoyl-CoA' brenda:45204 kegg:C21400;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound AcAc brenda:419 kegg:C00164;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound FAD brenda:20 kegg:C00016;
  compound FADH2 brenda:256 kegg:C01352;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound HCO3 brenda:195 kegg:C00288;
  compound Isobutyrate brenda:2340 kegg:C02632;
  compound L_leucyl_tRNALeu 'L-leucyl-tRNALeu' brenda:4262 kegg:C02047;
  compound Leu brenda:127 kegg:C00123;
  compound Methylglutaconyl_CoA 'Methylglutaconyl-CoA' brenda:8010 kegg:C03231;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NH4 'NH4+' brenda:4224;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound R_2_hydroxy_4_methylpentanoate '(R)-2-hydroxy-4-methylpentanoate' brenda:202156 kegg:C03264;
  compound R_2_hydroxy_4_methylpentanoyl_CoA '(R)-2-hydroxy-4-methylpentanoyl-CoA' brenda:202467 kegg:C21089;
  compound S_3_hydroxy_3_methylglutaryl_CoA '(S)-3-hydroxy-3-methylglutaryl-CoA' brenda:1835 kegg:C00356;
  compound acetate brenda:47 kegg:C00033;
  compound tRNALeu brenda:459 kegg:C01645;
  port 3_methyl_2_oxobutanoate side R to valine-metabolism;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    4_methylpent_2_enoyl_CoA
      -L[node12341: 1.3.1.44 | NADH>NAD, -H]- 4_methylpentanoyl_CoA;  // trans-2-enoyl-CoA reductase (NAD+)
    (4_methylpentanoyl_CoA + R_2_hydroxy_4_methylpentanoate) -[node12332: 2.8.3.24 {br=BR51714, ev=eq}]-> (4_methylpentanoate + R_2_hydroxy_4_methylpentanoyl_CoA);  // (R)-2-hydroxy-4-methylpentanoate CoA-transferase
    (R_2_hydroxy_4_methylpentanoate + 4_methylpent_2_enoyl_CoA) -[node12339: 2.8.3.B1 {br=BR51452, ev=eq}]-> (R_2_hydroxy_4_methylpentanoyl_CoA + 4_methylpent_2_enoate);  // (R)-2-hydroxyisocaproate CoA transferase
  }

  star 4_methyl_2_oxopentanoate arc 240 order cw {
    -B[node1182: 1.1.1.345 | NADH>NAD, -H ^R]- R_2_hydroxy_4_methylpentanoate;  // D-2-hydroxyacid dehydrogenase (NAD+)
    -[node4320: 4.1.1.7 | +CO2 ^R]- 3_Methylbutanal  // benzoylformate decarboxylase
      <-[node4317: 1.1.1.1 | NADH>NAD ^R {br=BR26045-a, ev=eq}]- 3_Methylbutanol;  // alcohol dehydrogenase
    <-[node4585: 1.4.1.9 | NAD>NADH, -H2O, +NH4, +H {br=BR33798, ev=cof+eq} || node6186: 2.6.1.6/2.6.1.42 | 2OG>Glu {br=BR47691, ev=cof+eq}]- Leu;  // leucine dehydrogenase; branched-chain-amino-acid transaminase
    -R[node6176: 1.2.7.7 | Fd_ox>Fd_red, -CoA, +CO2 {br=BS359415, ev=cof+eq, match=similar}]-> 3_Methyl_butanoyl_CoA;  // 3-methyl-2-oxobutanoate dehydrogenase (ferredoxin)
    <-B[node4587: ~? | -H, +CO2 ^L {br=BR52894, ev=cof+eq}]- 2S_2_isopropyl_3_oxosuccinate  // spontaneous reaction
      <-L[node4589: 1.1.1.85 | NAD>NADH ^R {br=BR47597, ev=cof+eq}]- 2R_3S_Isopropylmalate  // 3-isopropylmalate dehydrogenase
      <-[node4591: 4.2.1.33 | -H2O ^R {br=BR413, ev=cof-eq}]- 2_Isopropylmaleate  // 3-isopropylmalate dehydratase
      <-R[node4593: 4.2.1.33 | +H2O ^R {br=BR49521, ev=cof+eq, match=single}]- 2S_2_isopropylmalate  // 3-isopropylmalate dehydratase
      <-[node4595: 2.3.3.13 | Ac_CoA>CoA, -H2O ^R {br=BR47381, ev=cof+eq}]- 3_methyl_2_oxobutanoate;  // 2-isopropylmalate synthase
  }

  3_Methyl_butanoyl_CoA
    -R[node6177: 1.3.8.4 | FAD>FADH2, -H {br=BS424839, ev=cof+eq, match=kegg}]-> 3_Methylcrotonyl_CoA  // isovaleryl-CoA dehydrogenase
    -[node6179: 6.4.1.4 | ATP>ADP, -HCO3, +H, +Pi {br=BR156, ev=conflict, match=kegg}]- Methylglutaconyl_CoA  // methylcrotonoyl-CoA carboxylase
    -L[node6181: 4.2.1.18 | -H2O ^L {br=BR3388, ev=cof-eq}]-> S_3_hydroxy_3_methylglutaryl_CoA  // methylglutaconyl-CoA hydratase
    -[node6183: 4.1.3.4 | +Ac_CoA ^L {br=BR395, ev=cof+eq}]-> AcAc;  // Hydroxymethylglutaryl-CoA lyase

  3_Methyl_butanoyl_CoA
    -[node1155: 6.2.1.13 | ADP>ATP, -Pi, +CoA]- 3_methylbutanoate;  // acetate-CoA ligase (ADP-forming)

  Leu
    -[node4332: 5.4.3.7 {br=BR31, ev=eq, match=kegg}]-> 3R_beta_leucine  // leucine 2,3-aminomutase
    -R[node4330: ? | 2OG>Glu ^L]- 4_methyl_3_oxopentanoate;  // unknown enzyme

  Leu
    -R[node10972: 6.1.1.4 | ATP>AMP, -tRNALeu, +PPi {br=BR55, ev=cof+eq}]-> L_leucyl_tRNALeu;  // Leucine-tRNA ligase

  R_2_hydroxy_4_methylpentanoyl_CoA
    -R[node12336: 4.2.1.157 | +H2O ^R {br=BR51460, ev=cof+eq}]-> 4_methylpent_2_enoyl_CoA;  // (R)-2-hydroxyisocaproyl-CoA dehydratase

  react [node4326: ? | -H2O, +H] {4_methyl_3_oxopentanoate, Isobutyrate, acetate};  // unknown enzyme
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { R_2_hydroxy_4_methylpentanoate 4_methylpent_2_enoate } bypasses { R_2_hydroxy_4_methylpentanoate R_2_hydroxy_4_methylpentanoyl_CoA 4_methylpent_2_enoyl_CoA 4_methylpent_2_enoate };
  motif carrier { ADP ATP } forward { node1155 } backward { node6179 };
  motif carrier { NAD NADH } forward { node4585 node4589 } backward { node1182 node12341 node4317 };
}
