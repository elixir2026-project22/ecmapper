  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound acceptor brenda:66 brenda:3161;
  compound alpha_D_Glc_1_P 'alpha-D-Glc 1-P' brenda:107 kegg:C00103;
  compound dTDP brenda:542 kegg:C00363;
  compound dTDP_3_amino_4_6_dideoxy_alpha_D_glucopyranose 'dTDP-3-amino-4,6-dideoxy-alpha-D-glucopyranose' brenda:86884;
  compound dTDP_3_dehydro_4_6_deoxy_alpha_D_glucose 'dTDP-3-dehydro-4,6-deoxy-alpha-D-glucose' brenda:176133;
  compound dTDP_3_dimethylamino_3_4_6_trideoxy_alpha_D_glucopyranose 'dTDP-3-dimethylamino-3,4,6-trideoxy-alpha-D-glucopyranose' brenda:85577 kegg:C11911;
  compound dTDP_4_dehydro_6_deoxy_alpha_D_glucose 'dTDP-4-dehydro-6-deoxy-alpha-D-glucose' brenda:6388 kegg:C11907;
  compound dTDP_alpha_D_glucose 'dTDP-alpha-D-glucose' brenda:9374 kegg:C00842;
  compound dTDP_viosamine 'dTDP-viosamine' brenda:19647 kegg:C04268;
  compound dTTP brenda:145 kegg:C00459;
  compound erythromycin_A 'erythromycin A' brenda:41741 kegg:C01912;
  compound erythromycin_B 'erythromycin B' brenda:41758 kegg:C06653;
  compound erythromycin_C 'erythromycin C' brenda:28489 kegg:C06616;
  compound erythromycin_D 'erythromycin D' brenda:7926 kegg:C06633;
  compound erythronolide_B 'erythronolide B' brenda:29172 kegg:C06635;
  compound malonyl_CoA 'malonyl-CoA' brenda:76 kegg:C00083;
  compound methymycin brenda:36643 kegg:C11996;
  compound narbomycin brenda:10011 kegg:C11998;
  compound narbonolide brenda:167195 kegg:C11997;
  compound neomethymycin brenda:36644 kegg:C11995;
  compound neopikromycin brenda:81746 kegg:C20739;
  compound novamethymycin brenda:36645 kegg:C20741;
  compound novapikromycin brenda:195771 kegg:C20740;
  compound oxidized_ferredoxin_Fe_S_cluster 'oxidized ferredoxin [Fe-S] cluster' brenda:202698 kegg:C00139;
  compound pikromycin brenda:36646 kegg:C11999;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound reduced_ferredoxin_Fe_S_cluster 'reduced ferredoxin [Fe-S] cluster' brenda:202701 kegg:C00138;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    erythromycin_D
      -L[node12607: 1.14.13.154 | NADPH>NADP, -H, -O2, +H2O {br=BR49864, ev=cof+eq}]-> erythromycin_C  // erythromycin 12-hydroxylase
      -B[node12613: 2.1.1.254 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine {br=BR49887, ev=cof+eq}]-> erythromycin_A  // erythromycin 3''-O-methyltransferase
      <-[node12626: 1.14.13.154 | NADPH>NADP, -H, -O2, +H2O {br=BS416979, ev=cof+eq}]- erythromycin_B  // erythromycin 12-hydroxylase
      <-B[node12623: 2.1.1.254 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine {br=BR50050, ev=cof+eq}]- erythromycin_D;  // erythromycin 3''-O-methyltransferase
  }

  alpha_D_Glc_1_P
    -[node12575: 2.7.7.24 | -dTTP, +PPi ^L {br=BR47871, ev=cof+eq}]-> dTDP_alpha_D_glucose  // glucose-1-phosphate thymidylyltransferase
    -[node12580: 4.2.1.46 | +H2O ^L {br=BR425, ev=cof+eq}]-> dTDP_4_dehydro_6_deoxy_alpha_D_glucose  // dTDP-glucose 4,6-dehydratase
    -[node12583: 2.6.1.33 | -Glu, +2OG ^L {br=BR47685, ev=cof-eq}]-> dTDP_viosamine  // dTDP-4-amino-4,6-dideoxy-D-glucose transaminase
    -[node12587: 4.3.1.30 | reduced_acceptor>acceptor, -S_adenosyl_L_methionine, +Met, +5_deoxyadenosine, +NH3 {br=BR49954, ev=cof+eq, match=single}]-> dTDP_3_dehydro_4_6_deoxy_alpha_D_glucose  // dTDP-4-amino-4,6-dideoxy-D-glucose ammonia-lyase
    -[node12595: 2.6.1.106 | -Glu, +2OG ^L {br=BR49904, ev=cof-eq, match=single}]-> dTDP_3_amino_4_6_dideoxy_alpha_D_glucopyranose  // dTDP-3-amino-3,4,6-trideoxy-alpha-D-glucose transaminase
    -[node12599: 2.1.1.234 | 2*S_adenosyl_L_methionine>2*S_adenosyl_L_homocysteine ^L {br=BR49870, ev=cof+eq, match=single}]-> dTDP_3_dimethylamino_3_4_6_trideoxy_alpha_D_glucopyranose;  // dTDP-3-amino-3,4,6-trideoxy-alpha-D-glucopyranose N,N-dimethyltransferase

  novapikromycin
    -[node724: 1.14.15.33 | reduced_ferredoxin_Fe_S_cluster>oxidized_ferredoxin_Fe_S_cluster, -O2, -H, +H2O]- pikromycin  // pikromycin synthase
    <-L[node731: 1.14.15.33 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -O2, -2*H, +H2O {br=BR50917, ev=cof+eq}]- narbomycin  // pikromycin synthase
    -L[node738: 1.14.15.33 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -O2, -2*H, +H2O {br=BR50918, ev=cof+eq}]-> neopikromycin;  // pikromycin synthase

  10_deoxymethymycin
    -L[node12679: 1.14.15.33 | 4*reduced_ferredoxin_Fe_S_cluster>4*oxidized_ferredoxin_Fe_S_cluster, -4*H, -2*O2, +2*H2O {br=BR50922, ev=cof+eq}]-> novamethymycin;  // pikromycin synthase

  10_deoxymethymycin
    -L[node12672: 1.14.15.33 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +H2O {br=BR50920, ev=cof+eq}]-> methymycin;  // pikromycin synthase

  10_deoxymethymycin
    -L[node12667: 1.14.15.33 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +H2O {br=BR50921, ev=cof+eq}]-> neomethymycin;  // pikromycin synthase

  6_deoxyerythronolide_B
    -B[node12637: 1.14.15.35 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -O2, +H2O {br=BR50927, ev=cof+eq}]-> erythronolide_B;  // 6-deoxyerythronolide B hydroxylase

  (malonyl_CoA + 5*2S_methylmalonyl_CoA) -[node12648: 2.3.1.239 | 5*NADPH>5*NADP, -5*H, +2*H2O, +6*CoA, +6*CO2 {br=BR51189, ev=cof+eq}]-> 10_deoxymethynolide;  // 10-deoxymethynolide synthase
  (6*2S_methylmalonyl_CoA#2 + malonyl_CoA#2) -[node743: 2.3.1.240 | 5*NADPH>5*NADP, -5*H, +7*CO2, +7*CoA, +2*H2O {br=BR51190, ev=cof+eq}]-> narbonolide;  // narbonolide synthase
  (narbonolide + dTDP_3_dimethylamino_3_4_6_trideoxy_alpha_D_glucopyranose) -[node753: 2.4.1.277 | +dTDP {br=BS415775, ev=cof+eq, match=single}]-> narbomycin;  // 10-deoxymethynolide desosaminyltransferase
  (10_deoxymethynolide + dTDP_3_dimethylamino_3_4_6_trideoxy_alpha_D_glucopyranose) -[node12658: 2.4.1.277 | +dTDP {br=BR49892, ev=cof+eq}]-> 10_deoxymethymycin;  // 10-deoxymethynolide desosaminyltransferase
  (DTDP_beta_L_mycarose + erythronolide_B) -[node12629: 2.4.1.328 | +dTDP {br=BR50870, ev=cof+eq, match=single}]-> 3_alpha_mycarosylerythronolide_B;  // erythronolide mycarosyltransferase
  (dTDP_3_dimethylamino_3_4_6_trideoxy_alpha_D_glucopyranose + 3_alpha_mycarosylerythronolide_B) -[node12604: 2.4.1.278 | +dTDP {br=BR49893, ev=cof+eq, match=single}]-> erythromycin_D;  // 3-alpha-mycarosylerythronolide B desosaminyl transferase
  (6*2S_methylmalonyl_CoA#3 + propanoyl_CoA) -[node12647: 2.3.1.94 | 6*NADPH>6*NADP, -6*H, +H2O, +6*CO2, +7*CoA {br=BR44097, ev=cof+eq}]-> 6_deoxyerythronolide_B;  // 6-deoxyerythronolide-B synthase
}
