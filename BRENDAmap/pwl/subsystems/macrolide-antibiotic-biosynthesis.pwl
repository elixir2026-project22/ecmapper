pwl 2.0;
subsystem macrolide-antibiotic-biosynthesis 'macrolide antibiotic biosynthesis' {
  // BRENDA subsystem: 24 reactions (23 with direction), 31 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 10_deoxymethymycin '10-deoxymethymycin' brenda:10342 kegg:C11994;
  compound 10_deoxymethynolide '10-deoxymethynolide' brenda:15194 kegg:C11993;
  compound 2OG brenda:34 kegg:C00026;
  compound 2S_methylmalonyl_CoA '(2S)-methylmalonyl-CoA' brenda:19199 kegg:C00683;
  compound 3_alpha_mycarosylerythronolide_B '3-alpha-mycarosylerythronolide B' brenda:19514;
