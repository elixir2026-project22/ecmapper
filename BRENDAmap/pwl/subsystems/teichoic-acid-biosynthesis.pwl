pwl 2.0;
subsystem teichoic-acid-biosynthesis 'teichoic acid biosynthesis' {
  // BRENDA subsystem: 8 reactions (4 with direction), 10 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound CDP_glycerol 'CDP-glycerol' brenda:3020 kegg:C00513;
  compound CMP brenda:100 kegg:C00055;
  compound CTP brenda:60 kegg:C00063;
  compound Glc_n_Gro_P_m_Gro_P_HexNAc_2_PP_C55prenol '(Glc)n-(Gro-P)m-Gro-P-(HexNAc)2-PP-C55prenol' brenda:191587;
  compound Glc_n_Gro_P_m_Gro_P_HexNAc_2_P_peptidoglycan '(Glc)n-(Gro-P)m-Gro-P-(HexNAc)2-P-peptidoglycan' brenda:191590;
  compound Gro_6_P_ManNAc_alpha_1_4_GlcNAc_alpha_P_P_ditrans_octacis_undecaprenol '(Gro)-6-P-ManNAc-alpha-(1->4)-GlcNAc-alpha-P-P-ditrans,octacis-undecaprenol' brenda:212568 kegg:C21464;
  compound Gro_P_n_Gro_P_HexNAc_2_PP_C55prenol '(Gro-P)n-Gro-P-(HexNAc)2-PP-C55prenol' brenda:187622;
  compound Gro_P_nplus1_Gro_P_HexNAc_2_PP_C55prenol '(Gro-P)n+1-Gro-P-(HexNAc)2-PP-C55prenol' brenda:187624;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound N_acetyl_alpha_D_glucosaminyl_diphospho_ditrans_octacis_undecaprenol 'N-acetyl-alpha-D-glucosaminyl-diphospho-ditrans,octacis-undecaprenol' brenda:6385 kegg:C01289;
  compound N_acetyl_alpha_D_mannosaminyl_1_4_N_acetyl_D_glucosaminyldiphosphoundecaprenol 'N-acetyl-alpha-D-mannosaminyl-(1->4)-N-acetyl-D-glucosaminyldiphosphoundecaprenol' brenda:214250 kegg:C04881;
  compound PPi brenda:17 kegg:C00013;
  compound UDP brenda:26 kegg:C00015;
  compound UDP_Glc 'UDP-Glc' brenda:64 kegg:C00029;
  compound UDP_GlcNAc 'UDP-GlcNAc' brenda:17973;
  compound UMP brenda:133 kegg:C00105;
  compound ditrans_octacis_undecaprenyl_P 'ditrans,octacis-undecaprenyl-P' brenda:154482 kegg:C17556;
  compound peptidoglycan brenda:20455 kegg:C00889;
  compound sn_glycerol_3_phosphate 'sn-glycerol 3-phosphate' brenda:422 kegg:C00093;
  port N_acetyl_alpha_D_glucosaminyl_diphospho_ditrans_octacis_undecaprenol side L to O-antigen-biosynthesis;
  port UDP_GlcNAc side R to UDP-GlcNAc-biosynthesis;
  port sn_glycerol_3_phosphate side D to CDP-diacylglycerol-biosynthesis;

  Glc_n_Gro_P_m_Gro_P_HexNAc_2_P_peptidoglycan
    -[node6957: 2.7.8.- | -peptidoglycan, +ditrans_octacis_undecaprenyl_P ^L]- Glc_n_Gro_P_m_Gro_P_HexNAc_2_PP_C55prenol  // unknown
    -[node6955: 2.4.1.52 | UDP_Glc>UDP ^L]- Gro_P_nplus1_Gro_P_HexNAc_2_PP_C55prenol  // poly(glycerol-phosphate) alpha-glucosyltransferase
    -[node3920: 2.7.8.12 | CDP_glycerol>CMP ^L]- Gro_P_n_Gro_P_HexNAc_2_PP_C55prenol  // teichoic acid poly(glycerol phosphate) polymerase
    -[node1188: 2.7.8.12 | CDP_glycerol>CMP ^L]- Gro_6_P_ManNAc_alpha_1_4_GlcNAc_alpha_P_P_ditrans_octacis_undecaprenol;  // teichoic acid poly(glycerol phosphate) polymerase

  sn_glycerol_3_phosphate
    -B[node3922: 2.7.7.39 | -CTP, +PPi, +H ^R {br=BR48081, ev=cof+eq}]-> CDP_glycerol;  // glycerol-3-phosphate cytidylyltransferase

  UDP_GlcNAc
    -B[node3923: 2.7.8.33 | -ditrans_octacis_undecaprenyl_P, +UMP ^R {br=BR49478, ev=cof+eq}]-> N_acetyl_alpha_D_glucosaminyl_diphospho_ditrans_octacis_undecaprenol  // UDP-N-acetylglucosamine-undecaprenyl-phosphate N-acetylglucosaminephosphotransferase
    -[node3918: 2.4.1.187 | +UDP ^L {br=BR44182, ev=cof+eq}]-> N_acetyl_alpha_D_mannosaminyl_1_4_N_acetyl_D_glucosaminyldiphosphoundecaprenol;  // N-acetylglucosaminyldiphosphoundecaprenol N-acetyl-beta-D-mannosaminyltransferase

  (N_acetyl_alpha_D_mannosaminyl_1_4_N_acetyl_D_glucosaminyldiphosphoundecaprenol + CDP_glycerol) -[node3919: 2.7.8.44 | +CMP {br=BR51895, ev=eq}]-> Gro_6_P_ManNAc_alpha_1_4_GlcNAc_alpha_P_P_ditrans_octacis_undecaprenol;  // teichoic acid glycerol-phosphate primase
}
