pwl 2.0;
subsystem lipid-A-biosynthesis 'lipid A biosynthesis' {
  // BRENDA subsystem: 22 reactions (10 with direction), 23 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 3R_3_hydroxymyristoyl_ACP '(3R)-3-hydroxymyristoyl-ACP' brenda:2623;
  compound ACP brenda:551 brenda:1134 kegg:C00229;
  compound ADP brenda:13 kegg:C00008;
  compound ADP_L_glycero_D_manno_heptose 'ADP-L-glycero-D-manno-heptose' brenda:45283;
  compound ATP brenda:4 kegg:C00002;
  compound CMP brenda:100 kegg:C00055;
  compound CMP_alpha_Kdo 'CMP-alpha-Kdo' brenda:8231 kegg:C04121;
  compound Dodecanoyl_ACP 'Dodecanoyl-ACP' brenda:3855 kegg:C05223;
  compound Glc_1_3_heptosyl_1_3_phosphoheptosyl_1_5_KDO2_lipid_A 'Glc-(1->3)-heptosyl-(1->3)-phosphoheptosyl-(1->5)-KDO2-lipid A' brenda:186630;
  compound Glc_1_3_heptosyl_1_3_phosphoheptosyl_1_5_KDO2_lipid_A_L186633 'Glc-(1->3)-heptosyl-(1->3)-phosphoheptosyl-(1->5)-KDO2-lipid A' brenda:186633;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound Holo_ACP 'Holo-ACP' brenda:2745 kegg:C00229;
  compound KDO2_lauroyl_lipid_IVA 'KDO2-(lauroyl)-lipid IVA' brenda:186628 kegg:C06251;
  compound KDO_2_lipid_A '(KDO)2-lipid A' brenda:34756 kegg:C06026;
  compound Kdo2_lipid_IVA 'Kdo2-lipid IVA' brenda:183519 kegg:C06025;
  compound Kdo_lipid_IVA 'Kdo-lipid IVA' brenda:183517 kegg:C06024;
  compound UDP brenda:26 kegg:C00015;
  compound UDP_2_3_bis_3_hydroxytetradecanoyl_GlcN 'UDP-2,3-bis(3-hydroxytetradecanoyl)GlcN' brenda:45962 kegg:C04652;
  compound UDP_3_Myr_GlcN 'UDP-3-Myr-GlcN' brenda:186625;
  compound UDP_3_O_R_3_hydroxymyristoyl_GlcNAc 'UDP-3-O-((R)-3-hydroxymyristoyl)-GlcNAc' brenda:30931 kegg:C04738;
  compound UDP_Gal 'UDP-Gal' brenda:1336 kegg:C00052;
  compound UDP_Glc 'UDP-Glc' brenda:64 kegg:C00029;
  compound UDP_GlcNAc 'UDP-GlcNAc' brenda:17973;
  compound UMP brenda:133 kegg:C00105;
  compound acetate brenda:47 kegg:C00033;
  compound alpha_Kdo_2_4_alpha_Kdo_2_6_palmitoleoyl_lipid_IVA 'alpha-Kdo-(2->4)-alpha-Kdo-(2->6)-(palmitoleoyl)-lipid IVA' brenda:195410;
  compound galactosyl_1_6_glucosyl_1_2_glucosyl_1_3_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A 'galactosyl-(1,6)-[glucosyl-(1,2)-glucosyl-(1,3)]-glucosyl-(1,3)-[heptosyl-(1,7)]-4-phosphoheptosyl-(1,3)-4-phosphoheptosyl-KDO2-lipid A' brenda:186643;
  compound galactosyl_1_6_glucosyl_1_3_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A 'galactosyl-(1,6)-[glucosyl-(1,3)]-glucosyl-(1,3)-[heptosyl-1,7]-4-phosphoheptosyl-(1,3)-4-phosphoheptosyl-KDO2-lipid A' brenda:186644;
  compound galactosyl_1_6_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyll_1_3_4_phosphoheptosyl_KDO2_lipid_A 'galactosyl-(1,6)-glucosyl-(1,3)-[heptosyl-(1,7)]-4-phosphoheptosyll-(1,3)-4-phosphoheptosyl-KDO2-lipid A' brenda:186645;
  compound glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A 'glucosyl-(1,3)-[heptosyl-(1,7)]-4-phosphoheptosyl-(1,3)-4-phosphoheptosyl-KDO2-lipid A' brenda:186632;
  compound glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A_L186646 'glucosyl-(1,3)-[heptosyl-(1,7)]-4-phosphoheptosyl-(1,3)-4-phosphoheptosyl-KDO2-lipid A' brenda:186646;
  compound hep_1_3_hep_KDO2_lipid_A 'hep-(1,3)-hep-KDO2-lipid A' brenda:186631;
  compound hep_KDO2_lipid_A 'hep-KDO2-lipid A' brenda:186627;
  compound lipid_A_core 'lipid A-core' brenda:186629;
  compound lipid_A_disaccharide 'lipid A disaccharide' brenda:183513 kegg:C04932;
  compound lipid_IVA 'lipid IVA' brenda:107532 kegg:C04919;
  compound lipid_X 'lipid X' brenda:45067 kegg:C04824;
  compound myristoyl_ACP 'myristoyl-ACP' brenda:13529;
  compound palmitoleoyl_ACP_L3103 'palmitoleoyl-ACP' brenda:3103;
  port CMP_alpha_Kdo side R to CMP-KDO-biosynthesis;
  port UDP_GlcNAc side R to UDP-GlcNAc-biosynthesis;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    Kdo2_lipid_IVA
      -B[node3905: 2.3.1.241 | -Dodecanoyl_ACP, +Holo_ACP {br=BS455136, ev=eq}]-> KDO2_lauroyl_lipid_IVA  // Kdo2-lipid IVA acyltransferase
      -L[node3907: 2.3.1.243 | -myristoyl_ACP, +ACP ^L {br=BS454219, ev=eq, match=kegg}]-> KDO_2_lipid_A  // acyl-Kdo2-lipid IVA acyltransferase
      -B[node2068: 2.3.1.243 | -myristoyl_ACP, +ACP ^L]- alpha_Kdo_2_4_alpha_Kdo_2_6_palmitoleoyl_lipid_IVA  // acyl-Kdo2-lipid IVA acyltransferase
      <-R[node2070: 2.3.1.242 | -palmitoleoyl_ACP_L3103, +Holo_ACP {br=BS427337, ev=eq}]- Kdo2_lipid_IVA;  // Kdo2-lipid IVA palmitoleoyltransferase
  }

  KDO_2_lipid_A
    -R[node3983: 2.4.99.23 | ADP_L_glycero_D_manno_heptose>ADP ^R {br=BR51117, ev=cof+eq, match=single}]-> hep_KDO2_lipid_A  // lipopolysaccharide heptosyltransferase I
    -R[node3981: 2.4.99.24 | ADP_L_glycero_D_manno_heptose>ADP, +H {br=BR51118, ev=cof+eq}]-> hep_1_3_hep_KDO2_lipid_A  // lipopolysaccharide heptosyltransferase II
    -R[node3979: 2.4.1.- | UDP_Glc>UDP ^R]- Glc_1_3_heptosyl_1_3_phosphoheptosyl_1_5_KDO2_lipid_A_L186633  // lipopolysaccharide glucosyltransferase I
    -[node3970: 2.7.1.235 | ATP>ADP ^R {br=BR53370, ev=cof+eq}]-> Glc_1_3_heptosyl_1_3_phosphoheptosyl_1_5_KDO2_lipid_A  // lipopolysaccharide core heptose(I) kinase
    -L[node3968: 2.4.99.25 | ADP_L_glycero_D_manno_heptose>ADP]- glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A  // lipopolysaccharide heptosyltransferase III
    -L[node3966: 2.7.1.- | ATP>ADP ^R]- glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A_L186646  // lipopolysaccharide core biosynthesis protein
    -[node3964: 2.4.1.- | UDP_Gal>UDP ^R]- galactosyl_1_6_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyll_1_3_4_phosphoheptosyl_KDO2_lipid_A  // lipopolysaccharide 3-alpha-galactosyltransferase
    -R[node3954: 2.4.1.73 | UDP_Glc>UDP]- galactosyl_1_6_glucosyl_1_3_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A  // lipopolysaccharide glucosyltransferase II
    -R[node3950: 2.4.1.58 | UDP_Glc>UDP, +H]- galactosyl_1_6_glucosyl_1_2_glucosyl_1_3_glucosyl_1_3_heptosyl_1_7_4_phosphoheptosyl_1_3_4_phosphoheptosyl_KDO2_lipid_A  // lipopolysaccharide glucosyltransferase I
    -[node3945: 2.4.1.- | ADP_L_glycero_D_manno_heptose>ADP, +H]- lipid_A_core;  // heptosyl transferse IV

  Kdo2_lipid_IVA
    -R[node3899: 2.4.99.13 | -CMP_alpha_Kdo, +CMP ^L]- Kdo_lipid_IVA;  // (KDO)-lipid IVA 3-deoxy-D-manno-octulosonic acid transferase

  lipid_IVA
    -[node3991: 2.7.1.130 | ATP>ADP ^L]- lipid_A_disaccharide;  // tetraacyldisaccharide 4'-kinase

  UDP_GlcNAc
    -R[node4008: 2.3.1.129 | -3R_3_hydroxymyristoyl_ACP, +Holo_ACP ^L {br=BS370322, ev=cof+eq}]-> UDP_3_O_R_3_hydroxymyristoyl_GlcNAc  // acyl-[acyl-carrier-protein]-UDP-N-acetylglucosamine O-acyltransferase
    -L[node4004: 3.5.1.108 | -H2O, -acetate ^L]- UDP_3_Myr_GlcN  // UDP-3-O-acyl-N-acetylglucosamine deacetylase
    -[node4000: 2.3.1.191 | -3R_3_hydroxymyristoyl_ACP, -Holo_ACP]- UDP_2_3_bis_3_hydroxytetradecanoyl_GlcN  // UDP-3-O-(3-hydroxyacyl)glucosamine N-acyltransferase
    -R[node3996: 3.6.1.54 | -H2O, +UMP ^R {br=BS402961, ev=cof+eq, match=similar}]-> lipid_X;  // UDP-2,3-diacylglucosamine diphosphatase

  (CMP_alpha_Kdo + lipid_IVA) -[node3897: 2.4.99.12 | +CMP {br=BR49179, ev=cof+eq, match=kegg}]-> Kdo_lipid_IVA;  // lipid IVA 3-deoxy-D-manno-octulosonic acid transferase
  (UDP_2_3_bis_3_hydroxytetradecanoyl_GlcN + lipid_X) -[node3994: 2.4.1.182 | +UDP, +H {br=BS422082, ev=cof+eq, match=single}]-> lipid_A_disaccharide;  // lipid-A-disaccharide synthase
}
