    -B[node5256: 4.1.1.22 | +CO2 ^L {br=BR283, ev=cof+eq}]-> Histamine  // Histidine decarboxylase
    -L[node5508: 1.4.3.22 | -O2, -H2O, +NH3, +H2O2 {br=BR48925, ev=cof+eq}]-> imidazol_4_yl_acetaldehyde  // diamine oxidase
    -[node5507: 1.2.1.3 | NAD>NADH, -H2O]- Imidazole_4_acetate  // aldehyde dehydrogenase (NAD+)
    -R[node5503: 1.14.13.5 | NADH>NAD, -O2, +H2O {br=BR36766, ev=cof+eq, match=kegg}]-> 5_hydroxy_1H_imidazol_4_yl_acetic_acid  // imidazoleacetate 4-monooxygenase
    -R[node5504: 3.5.2.- | -H2O ^L]- formimidoyl_Asp  // 3.5.2.-
    -[node5501: 3.5.3.5 | -H2O, +NH3 ^L {br=BR22729, ev=cof+eq, match=kegg}]-> formyl_Asp  // formimidoylaspartate deiminase
    -[node5498: 3.5.1.8 | -H2O, +formate ^L {br=BR22713, ev=cof+eq}]-> Asp;  // formylaspartate deformylase

  His
    -B[node5671: 2.6.1.58 | pyruvate>Ala {br=BS353949, ev=cof+eq, match=single} || node5663: 2.6.1.38 | 2OG>Glu {br=BR47688, ev=cof+eq, match=kegg}]-> 3_imidazol_5_yl_pyruvate  // phenylalanine(histidine) transaminase; histidine transaminase
    -L[node5667: 1.1.1.111 | NADPH>NADP ^R {br=BR29177, ev=cof-eq}]-> S_3_imidazol_5_yl_lactate;  // 3-(imidazol-5-yl)lactate dehydrogenase

  D_Rib_5_P
    -[node5398: 2.7.6.1 | ATP>AMP ^L {br=BR47854, ev=cof+eq}]-> 5_P_alpha_D_Rib_1_PP  // ribose-phosphate diphosphokinase
    -[node5402: 2.4.2.17 | -ATP, +PPi ^L {br=BR47479, ev=cof-eq}]-> phosphoribosyl_ATP  // ATP phosphoribosyltransferase
    -[node5404: 3.6.1.31 | -H2O, +PPi ^L {br=BR22771, ev=cof+eq, match=kegg}]-> Phosphoribosyl_AMP  // phosphoribosyl-ATP diphosphatase
    -[node5408: 3.5.4.19 | -H2O ^L {br=BR26113, ev=cof+eq, match=kegg}]-> P_formimino_AICAR_P  // phosphoribosyl-AMP cyclohydrolase
    -B[node5395: 5.3.1.16 {br=BR225, ev=eq, match=kegg}]-> Phosphoribulosyl_formimino_AICAR_phosphate  // 1-(5-phosphoribosyl)-5-[(5-phosphoribosylamino)methylideneamino]imidazole-4-carboxamide isomerase
    -[node5393: 4.3.2.10 | Gln>Glu, +5_amino_1_5_phospho_beta_D_ribosyl_imidazole_4_carboxamide {br=BR52465, ev=cof+eq, match=similar}]-> EIG3P  // imidazole glycerol-phosphate synthase
    -[node5389: 4.2.1.19 | +H2O ^R {br=BR404, ev=cof+eq}]-> IMACP  // imidazoleglycerol-phosphate dehydratase
    <-[node5386: 2.6.1.9 | 2OG>Glu ^R {br=BR47443, ev=cof+eq}]- His_ol_P  // histidinol-phosphate transaminase
    -B[node5381: 3.1.3.15 | -H2O, +Pi {br=BR19199, ev=cof+eq}]-> His_ol  // histidinol-phosphatase
    -[node5378: 1.1.1.23 | NAD>NADH ^R {br=BS371011, ev=cof+eq}]-> L_Histidinal  // histidinol dehydrogenase
    -[node5376: 1.1.1.23 | NAD>NADH, -H2O {br=BS187855, ev=cof+eq}]-> His;  // histidinol dehydrogenase

  5_formiminotetrahydrofolate
    -L[node5657: 4.3.1.4 | +NH3 ^R {br=BR3426, ev=cof+eq, match=kegg}]-> 5_10_methenyltetrahydrofolate  // formimidoyltetrahydrofolate cyclodeaminase
    -[node5660: 3.5.4.9 | -H2O ^R {br=BR22746, ev=cof+eq}]-> 10_formyltetrahydrofolate;  // methenyltetrahydrofolate cyclohydrolase

  (tRNAHis + His) -[node11019: 6.1.1.21 | ATP>AMP, +PPi {br=BR52, ev=cof+eq}]-> L_histidyl_tRNAHis;  // Histidine-tRNA ligase
  formimino_Glu -[node5480: 2.1.2.5 | -6S_THFA {br=BR43944, ev=cof-eq, match=kegg}]-> (Glu + 5_formiminotetrahydrofolate);  // glutamate formimidoyltransferase
