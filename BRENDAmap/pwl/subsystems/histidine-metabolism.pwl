    -B[node5481: 3.5.3.13 | -H2O, +NH3 ^L {br=BR22723, ev=cof+eq, match=kegg}]-> N_formyl_Glu  // formimidoylglutamate deiminase
    -L[node5483: 3.5.1.68 | -H2O, +formate ^R {br=BR22707, ev=cof+eq}]-> Glu  // N-formylglutamate deformylase
    <-L[node5479: 3.5.3.8 | -H2O, +formamide ^L {br=BR26109, ev=cof+eq, match=kegg}]- formimino_Glu;  // formimidoylglutamase

