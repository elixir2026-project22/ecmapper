pwl 2.0;
subsystem S-reticuline-biosynthesis '(S)-reticuline biosynthesis' {
  // BRENDA subsystem: 15 reactions (13 with direction), 14 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 3_4_dihydroxyphenylacetaldehyde '3,4-dihydroxyphenylacetaldehyde' brenda:3596 kegg:C04043;
  compound 3_4_dihydroxyphenylpyruvate '3,4-dihydroxyphenylpyruvate' brenda:5105 kegg:C04045;
  compound 4_hydroxyphenyl_acetaldehyde '(4-hydroxyphenyl)acetaldehyde' brenda:2132 brenda:5883 kegg:C03765;
  compound 4_hydroxyphenylpyruvate '4-hydroxyphenylpyruvate' brenda:423 brenda:42809;
  compound 4a_hydroxy_tetrahydrobiopterin '4a-hydroxy-tetrahydrobiopterin' brenda:3853 brenda:35294 kegg:C15522;
  compound CO2 brenda:28 kegg:C00011;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_DOPA 'L-DOPA' brenda:320 kegg:C00355;
  compound O2 brenda:9 brenda:1180;
  compound S_3_hydroxy_N_methylcoclaurine '(S)-3\'-hydroxy-N-methylcoclaurine' brenda:21426 kegg:C05202;
  compound S_N_methylcoclaurine '(S)-N-methylcoclaurine' brenda:4750 kegg:C05176;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound S_coclaurine '(S)-coclaurine' brenda:5082 kegg:C06161;
  compound S_norcoclaurine '(S)-norcoclaurine' brenda:10818;
  compound S_norlaudanosoline '(S)-norlaudanosoline' brenda:29218;
  compound S_reticuline '(S)-reticuline' brenda:2631;
  compound Tyr brenda:109 kegg:C00082;
  compound dopamine brenda:242 kegg:C03758;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  compound tetrahydrobiopterin brenda:252 kegg:C00272;
  compound tyramine brenda:280 kegg:C00483;
  port S_reticuline side L to morphine-biosynthesis;

  // ring: cycle of the drawing (12 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    S_norcoclaurine
      -[node582: 2.1.1.128 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BS386680, ev=cof+eq}]-> S_coclaurine  // (RS)-norcoclaurine 6-O-methyltransferase
      -[node578: 2.1.1.140 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR29467, ev=cof+eq}]-> S_N_methylcoclaurine  // (S)-coclaurine-N-methyltransferase
      -R[node571: 1.14.14.102 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR29147, ev=cof+eq}]-> S_3_hydroxy_N_methylcoclaurine  // N-methylcoclaurine 3'-monooxygenase
      -[node568: 2.1.1.116 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR1437, ev=cof+eq}]-> S_reticuline  // 3'-hydroxy-N-methyl-(S)-coclaurine 4'-O-methyltransferase
      -R[node12825: ? | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R]- S_norlaudanosoline;  // unknown enzyme
    3_4_dihydroxyphenylacetaldehyde
      -B[node12817: ? | -H, +CO2 ^R]- 3_4_dihydroxyphenylpyruvate  // unknown enzyme
      <-[node12814: 2.6.1.49 | -2OG, +Glu ^R {br=BR47392, ev=cof+eq}]- L_DOPA  // dihydroxyphenylalanine transaminase
      <-R[node12809: 1.14.18.1 | -O2 ^R {br=BR50166, ev=eq}]- Tyr  // tyrosinase
      -R[node591: 2.6.1.5 | -2OG, +Glu ^L {br=BR47696, ev=cof+eq}]-> 4_hydroxyphenylpyruvate  // tyrosine transaminase
      -[node587: 4.1.1.80 | +CO2 ^L {br=BR40592, ev=cof+eq}]-> 4_hydroxyphenyl_acetaldehyde;  // 4-hydroxyphenylpyruvate decarboxylase
    (4_hydroxyphenyl_acetaldehyde + dopamine) -[node584: 4.2.1.78 | +H2O {br=BR455, ev=cof+eq}]-> S_norcoclaurine;  // (S)-norcoclaurine synthase
    (dopamine + 3_4_dihydroxyphenylacetaldehyde) -[node12821: 4.2.1.78 | +H2O {br=BS2112, ev=cof+eq, match=kegg}]-> S_norlaudanosoline;  // (S)-norcoclaurine synthase
  }

  Tyr
    -[node12800: 4.1.1.25/4.1.1.28 | +CO2 ^L {br=BR286, ev=cof+eq}]-> tyramine  // tyrosine decarboxylase\n/aromatic-L-amino-acid decarboxylase
    -[node12805: 1.14.16.2 | -tetrahydrobiopterin, -O2, +4a_hydroxy_tetrahydrobiopterin {br=BS417733, ev=cof+eq}]-> dopamine  // tyrosine 3-monooxygenase
    <-B[node593: 4.1.1.28 | +CO2 ^L {br=BR287, ev=cof+eq}]- L_DOPA;  // aromatic-L-amino-acid decarboxylase
}
