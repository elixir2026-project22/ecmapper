pwl 2.0;
subsystem hydrogen-production 'hydrogen production' {
  // BRENDA subsystem: 6 reactions (5 with direction), 7 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2 brenda:361 kegg:C00282;
  compound H2S brenda:911 kegg:C00283;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound oxidized_acceptor 'oxidized acceptor' brenda:1387;
  compound reduced_acceptor 'reduced acceptor' brenda:77 kegg:C00030;
  compound sulfur brenda:871 kegg:C00087;
  port H2 side R to coenzyme-M-biosynthesis;

  H
    -[node10835: 1.12.7.2 | Fd_red>Fd_ox ^L {br=BR40489, ev=cof-eq}]-> H2  // ferredoxin hydrogenase
    <-[node10823: 1.12.1.5 | NADPH>NADP {br=BR40490, ev=cof-eq} || node10822: 1.12.1.3 | NADPH>NADP {br=BR40490, ev=cof-eq} || node10819: 1.12.1.2 | NADH>NAD {br=BR40491, ev=cof-eq}]- H#2;  // hydrogen dehydrogenase [NAD(P)+]; hydrogen dehydrogenase (NADP+); hydrogen dehydrogenase

  (sulfur + H2) -[node10838: 1.12.98.4 {br=BR50566, ev=eq}]-> H2S;  // sulfhydrogenase
  react [node10840: 1.12.99.6] {reduced_acceptor, oxidized_acceptor, H2};  // hydrogenase (acceptor)
}
