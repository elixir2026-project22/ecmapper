pwl 2.0;
subsystem gallate-degradation 'gallate degradation' {
  // BRENDA subsystem: 11 reactions (6 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 1E_3E_4_hydroxybuta_1_3_diene_1_2_4_tricarboxylate '(1E,3E)-4-hydroxybuta-1,3-diene-1,2,4-tricarboxylate' brenda:84966 kegg:C04324;
  compound 1E_4_oxobut_1_ene_1_2_4_tricarboxylate '(1E)-4-oxobut-1-ene-1,2,4-tricarboxylate' brenda:27691 kegg:C04434;
  compound 1_2_3_5_tetrahydroxybenzene '1,2,3,5-tetrahydroxybenzene' brenda:5083 kegg:C03743;
  compound 2_hydroxy_4_oxobutane_1_2_4_tricarboxylate '2-hydroxy-4-oxobutane-1,2,4-tricarboxylate' brenda:19927 kegg:C04115;
  compound 2_pyrone_4_6_dicarboxylate '2-pyrone-4,6-dicarboxylate' brenda:2330 kegg:C03671;
  compound 4_carboxy_2_hydroxyhexa_2_4_dienedioate '4-carboxy-2-hydroxyhexa-2,4-dienedioate' brenda:91661;
  compound 4_oxalomesaconate '4-oxalomesaconate' brenda:3157 kegg:C04434;
  compound CO2 brenda:28 kegg:C00011;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound dihydrophloroglucinol brenda:21131 kegg:C06719;
  compound gallate brenda:1973 kegg:C01424;
  compound oxaloacetate brenda:57 kegg:C00036;
  compound phloroglucinol brenda:2282 kegg:C02183;
  compound pyrogallol brenda:658 kegg:C01108;
  compound pyruvate brenda:31 kegg:C00022;
  port oxaloacetate side U to citric-acid-cycle;

  // ring: cycle of the drawing (7 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    gallate
      -L[node10219: 1.13.11.3 | -O2, +H2O ^R {br=BS417952, ev=cof+eq}]-> 2_pyrone_4_6_dicarboxylate  // protocatechuate 3,4-dioxygenase
      -R[node10229: 3.1.1.57 | -H2O, +H ^R]- 4_oxalomesaconate  // 2-pyrone-4,6-dicarboxylate lactonase
      -[node10220: ~? {br=BR52873, ev=eq}]-> 4_carboxy_2_hydroxyhexa_2_4_dienedioate  // spontaneous reaction
      -R[node10205: 4.2.1.83 | -H2O ^L]- 2_hydroxy_4_oxobutane_1_2_4_tricarboxylate  // 4-oxalomesaconate hydratase
      -[node12051: 4.2.1.83 | -H2O ^L]- 1E_3E_4_hydroxybuta_1_3_diene_1_2_4_tricarboxylate  // 4-oxalomesaconate hydratase
      <-R[node12052: 5.3.2.8 {br=BR49625, ev=eq}]- 1E_4_oxobut_1_ene_1_2_4_tricarboxylate  // 4-oxalomesaconate tautomerase
      <-R[node12050: 1.13.11.57 | -O2 ^R {br=BR49586, ev=cof+eq, match=kegg}]- gallate;  // gallate dioxygenase
  }

  gallate
    -[node12061: 4.1.1.59 | +CO2 ^L {br=BR319, ev=cof+eq, match=kegg}]-> pyrogallol  // gallate decarboxylase
    -[node12063: 1.97.1.2 | -1_2_3_5_tetrahydroxybenzene, +1_2_3_5_tetrahydroxybenzene ^L]- phloroglucinol  // pyrogallol hydroxytransferase
    -[node12062: 1.3.1.57 | NADPH>NADP ^L {br=BR29437, ev=cof-eq}]-> dihydrophloroglucinol;  // phloroglucinol reductase

  2_hydroxy_4_oxobutane_1_2_4_tricarboxylate
    -L[node10224: 4.1.3.17 | +pyruvate ^L]- oxaloacetate;  // 4-hydroxy-4-methyl-2-oxoglutarate aldolase
}
