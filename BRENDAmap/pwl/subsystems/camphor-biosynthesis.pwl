pwl 2.0;
subsystem camphor-biosynthesis 'camphor biosynthesis' {
  // BRENDA subsystem: 6 reactions (4 with direction), 7 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound PPi brenda:17 kegg:C00013;
  compound borneol '(-)-borneol' brenda:8975;
  compound bornyl_diphosphate '(-)-bornyl diphosphate' brenda:21359 kegg:C20664;
  compound camphor '(-)-camphor' brenda:19816;
  compound geranyl_diphosphate 'geranyl diphosphate' brenda:175 brenda:46074 kegg:C00341;
  compound plus_borneol '(+)-borneol' brenda:10443 kegg:C01765;
  compound plus_bornyl_diphosphate '(+)-bornyl diphosphate' brenda:48199 kegg:C03190;
  compound plus_camphor '(+)-camphor' brenda:2387 kegg:C00808;

  geranyl_diphosphate
    -[node984: 5.5.1.8 {br=BR266, ev=eq}]-> plus_bornyl_diphosphate  // (+)-bornyl diphosphate synthase
    -[node987: 3.1.3.- | -H2O, +PPi ^R]- plus_borneol  // (+)-bornyl-diphosphate diphosphatase
    -[node981: 1.1.1.198 | NAD>NADH, +H ^R {br=BR29247, ev=cof+eq}]-> plus_camphor;  // (+)-borneol dehydrogenase

  geranyl_diphosphate
    -[node1001: 5.5.1.22 {br=BR50817, ev=eq}]-> bornyl_diphosphate  // (-)-bornyl diphosphate synthase
    -[node995: 3.1.3.- | -H2O, +PPi ^R]- borneol  // (-)-bornyl diphosphate hydrolase
    -[node993: 1.1.1.227 | -NAD, +H, +H ^R {br=BR29266, ev=cof+eq}]-> camphor;  // (-)-borneol dehydrogenase
}
