pwl 2.0;
subsystem NAD-metabolism 'NAD metabolism' {
  // BRENDA subsystem: 22 reactions (17 with direction), 12 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 5_P_alpha_D_Rib_1_PP '5-P-alpha-D-Rib 1-PP' brenda:158 kegg:C00119;
  compound ADP brenda:13 kegg:C00008;
  compound ADP_D_ribosyl_n '(ADP-D-ribosyl)n' brenda:31094 kegg:C03245;
  compound ADP_D_ribosyl_nplus1 '(ADP-D-ribosyl)n+1' brenda:31093 kegg:C03245;
  compound ADP_Rib 'ADP-Rib' brenda:402 kegg:C00301;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Asp brenda:97 kegg:C00049;
  compound CO2 brenda:28 kegg:C00011;
  compound DHAP brenda:278 kegg:C00111;
  compound DNAD brenda:1300 kegg:C00857;
  compound D_Rib_5_P 'D-Rib 5-P' brenda:183 kegg:C00117;
  compound Deamido_NMN 'Deamido-NMN' brenda:5194;
  compound Gln brenda:102 kegg:C00064;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound alpha_iminosuccinate 'alpha-iminosuccinate' brenda:107528;
  compound nicotinamide brenda:267 kegg:C00153;
  compound nicotinamide_mononucleotide 'nicotinamide mononucleotide' brenda:1831 kegg:C00455;
  compound nicotinamide_riboside 'nicotinamide riboside' brenda:2493;
  compound nicotinate brenda:1029 kegg:C00253;
  compound quinolinate brenda:2500 kegg:C03722;
  port NADPH side D to photosynthesis;
  port nicotinamide side L to degradation-of-aromatic-nitrogen-containing-compounds;
  port nicotinate side L to degradation-of-aromatic-nitrogen-containing-compounds;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    nicotinamide
      -R[node9888: 3.5.1.19 | -H2O, +NH3 ^R {br=BR26099, ev=cof+eq}]-> nicotinate  // nicotinamidase
      -L[node9867: 6.3.4.21 | ATP>ADP, -5_P_alpha_D_Rib_1_PP, -H2O, +Pi, +PPi {br=BR47484, ev=cof+eq, match=single}]-> Deamido_NMN  // nicotinate phosphoribosyltransferase
      -L[node10235: 2.7.7.18 | -ATP, +PPi ^R {br=BR47865, ev=cof+eq, match=single}]-> DNAD  // nicotinate-nucleotide adenylyltransferase
      -L[node10237: 6.3.5.1 | ATP>AMP, Gln>Glu, -H2O, +PPi, +H {br=BR147, ev=cof+eq} || node10234: 6.3.1.5 | ATP>AMP, -NH3, +PPi {br=BR96, ev=cof+eq}]-> NAD  // NAD+ synthase (glutamine-hydrolysing); NAD+ synthase
      -[node10625: -> 2.4.2.30 | -ADP_D_ribosyl_n, +ADP_D_ribosyl_nplus1 {br=BR47504, ev=cof+eq} || node9883: <- 3.2.2.5 | -ADP_Rib, +H2O {br=BR16043, ev=cof-eq}]- nicotinamide;  // NAD+ ADP-ribosyltransferase;  NAD+ glycohydrolase
  }

  Asp
    -R[node8292: 1.4.1.21 | NADP>NADPH, +H || node10245: -> 1.4.3.16 | -O2, +H2O2, +H {br=BR36878, ev=cof+eq, match=single}]- alpha_iminosuccinate  // aspartate dehydrogenase; L-aspartate oxidase
    -[node10239: 2.5.1.72 | -DHAP, +2*H2O, +Pi {br=BR48966, ev=cof+eq, match=single}]-> quinolinate  // quinolinate synthase
    -R[node10241: 2.4.2.19 | -H, -5_P_alpha_D_Rib_1_PP, +PPi, +CO2 {br=BR47506, ev=cof-eq, match=single}]-> Deamido_NMN  // nicotinate-nucleotide diphosphorylase (carboxylating)
    <-[node9868: 3.5.1.42 | -H2O, +NH3, +H {br=BR22692, ev=cof+eq, match=single}]- nicotinamide_mononucleotide  // nicotinamide-nucleotide amidase
    -R[node9889: <- 3.6.1.22 | -H2O, +AMP, +H {br=BR22763, ev=cof+eq, match=similar} || node9869: -> 2.7.7.1 | -ATP, +PPi {br=BR47858, ev=cof+eq, match=kegg}]- NAD;  // NAD+ diphosphatase; nicotinamide-nucleotide adenylyltransferase

  NAD
    -B[node11671: -> 1.6.1.3 | -NADPH, +NADH {br=BR36919, ev=cof+eq} || node9859: 3.1.3.2 | -H2O, +Pi || node10178: -> 2.7.1.23 | ATP>ADP, +H {br=BR47763, ev=cof+eq}]- NADP  // NAD(P)+ transhydrogenase; acid phosphatase; NAD+ kinase
    -[node10193: 1.6.1.2 | NAD>NADH ^R]- NADPH;  // NAD(P)+ transhydrogenase (Re/Si-specific)

  nicotinamide_mononucleotide
    -B[node9887: 3.2.2.14 | -H2O, +H, +D_Rib_5_P ^L {br=BR19226, ev=cof+eq, match=kegg}]-> nicotinamide;  // NMN nucleosidase

  nicotinamide_mononucleotide
    -B[node9864: 2.7.1.22 | ATP>ADP, +H || node9866: -> 3.1.3.5 | -H2O, +Pi {br=BS392887, ev=cof+eq}]- nicotinamide_riboside;  // ribosylnicotinamide kinase; 5'-nucleotidase

  react [node10287: 1.6.1.1 | +NADH] {NADPH, NADP, NAD};  // NAD(P)+ transhydrogenase (Si-specific)
  // motifs (detected from the reactions above, see PWL.md)
  motif substrate_cycle { NAD nicotinamide } forward { node10625 } backward { node9883 };
  motif substrate_cycle { NAD nicotinamide_mononucleotide } forward { node9889 } backward { node9869 };
  motif shunt { nicotinamide_mononucleotide Deamido_NMN } bypasses { nicotinamide_mononucleotide nicotinamide nicotinate Deamido_NMN };
}
