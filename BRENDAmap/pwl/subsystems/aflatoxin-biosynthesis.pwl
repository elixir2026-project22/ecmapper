  compound norsolorinic_acid_anthrone 'norsolorinic acid anthrone' brenda:28787 kegg:C20453;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  compound sterigmatocystin brenda:5649 kegg:C00961;
  compound versicolorin_A 'versicolorin A' brenda:250310 kegg:C20583;
  compound versicolorin_B 'versicolorin B' brenda:19692 kegg:C20575;
  compound versicolorone brenda:88411 kegg:C20504;
  compound versiconal brenda:7938 kegg:C20507;
  compound versiconal_hemiacetal_acetate 'versiconal hemiacetal acetate' brenda:15304 kegg:C20505;
  compound versiconol brenda:28802 kegg:C20508;
  compound versiconol_acetate 'versiconol acetate' brenda:28803 kegg:C20506;

  // ring: cycle of the drawing (6 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    1_hydroxyversicolorone
      -[node12521: 1.1.1.353 | NADPH>NADP, -H {br=BR50504, ev=cof-eq}]-> versicolorone  // versiconal hemiacetal acetate reductase
      -B[node12527: ? | NADPH>NADP, -H, -O2, +H2O]- versiconol_acetate  // versiconal hemiacetal acetate synthase
      -L[node868: 3.1.1.94 | -H2O, +acetate ^R {br=BR50546, ev=cof+eq}]-> versiconol  // versiconal hemiacetal acetate esterase
      -R[node862: 1.1.1.353 | NADP>NADPH, +H ^L {br=BR50506, ev=cof+eq}]-> versiconal  // versiconal hemiacetal acetate reductase
      <-R[node860: 3.1.1.94 | -H2O, +acetate ^L {br=BR50545, ev=cof+eq}]- versiconal_hemiacetal_acetate  // versiconal hemiacetal acetate esterase
      -R[node12515: ? | NADPH>NADP, -H, -O2, +H2O]- 1_hydroxyversicolorone;  // versiconal hemiacetal acetate synthase
    chord versiconal_hemiacetal_acetate -[node12533: 1.1.1.353 | NADPH>NADP, -H {br=BR50505, ev=cof-eq}]-> versiconol_acetate;  // versiconal hemiacetal acetate reductase
  }

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    1_S_averantin
      -[node12502: 1.14.14.116 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50522, ev=cof+eq}]-> 1_S_5_S_5_hydroxyaverantin#2  // averantin hydroxylase
      -B[node12510: 1.1.1.352 | NAD>NADH, +H ^R {br=BR50503, ev=cof+eq, match=kegg}]-> 5_oxoaverantin  // 5'-hydroxyaverantin dehydrogenase
      <-[node12500: 1.1.1.352 | NAD>NADH, +H ^R {br=BR50502, ev=cof+eq, match=kegg}]- 1_S_5_S_5_hydroxyaverantin  // 5'-hydroxyaverantin dehydrogenase
      <-B[node12495: 1.14.14.116 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR50521, ev=cof+eq}]- 1_S_averantin;  // averantin hydroxylase
  }

  versiconal
    -R[node856: 4.2.1.143 | +H2O ^R {br=BR50551, ev=cof+eq}]-> versicolorin_B  // versicolorin B synthase
    -L[node853: 1.3.1.- | NADP>NADPH, +H]- versicolorin_A;  // versicolorin B dehydrogenase

  5_oxoaverantin
    -R[node12512: 4.2.1.142 | +H2O ^R {br=BR50550, ev=cof+eq}]-> 1_S_5_S_averufin  // 5'-oxoaverantin cyclase
    -[node872: 1.14.14.- | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O]- 1_hydroxyversicolorone;  // averufin monooxygenase

  norsolorinic_acid_anthrone
    -R[node882: 1.13.12.20 | -O2, +H2O ^L {br=BR50371, ev=cof+eq}]-> norsolorinic_acid  // noranthrone monooxygenase
    -[node877: 1.1.1.349 | NADPH>NADP, -H ^L {br=BR50499, ev=cof-eq}]-> 1_S_averantin;  // norsolorinic acid ketoreductase

  dihydrodemethylsterigmatocystin
    -R[node848: 2.1.1.109 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BS319593, ev=cof+eq}]-> dihydrosterigmatocystin  // demethylsterigmatocystin 6-O-methyltransferase
    -[node845: 2.1.1.110 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR50532, ev=cof+eq}]-> 8_O_methyldihydrosterigmatocystin  // sterigmatocystin 8-O-methyltransferase
    -R[node837: 1.14.14.117 | 2*reduced_NADPH_hemoprotein_reductase>2*oxidized_NADPH_hemoprotein_reductase, -2*O2, +H2O, +CO2, +methanol {br=BR50524, ev=cof+eq}]-> aflatoxin_B2;  // aflatoxin B synthase

  8_O_methyldihydrosterigmatocystin
    -[node835: ?]- aflatoxin_G2;  // unknown enzyme

  6_demethylsterigmatocystin
    -R[node830: 2.1.1.109 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR43868, ev=cof+eq}]-> sterigmatocystin  // demethylsterigmatocystin 6-O-methyltransferase
    -[node820: 2.1.1.110 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BR43870, ev=cof+eq}]-> 8_O_methylsterigmatocystin  // sterigmatocystin 8-O-methyltransferase
    -R[node831: 1.14.14.117 | 2*reduced_NADPH_hemoprotein_reductase>2*oxidized_NADPH_hemoprotein_reductase, -2*O2, +H2O, +CO2, +methanol {br=BR50523, ev=cof+eq}]-> aflatoxin_B1;  // aflatoxin B synthase

  8_O_methylsterigmatocystin
    -[node833: ?]- aflatoxin_G1;  // unknown enzyme

  (7*malonyl_CoA + hexanoyl_ACP) -[node888: 2.3.1.221 | +ACP, +7*CO2, +7*CoA, +2*H2O {br=BR50415, ev=cof+eq}]-> norsolorinic_acid_anthrone;  // noranthrone synthase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { versiconal_hemiacetal_acetate versiconal } bypasses { versiconal_hemiacetal_acetate versiconol_acetate versiconol versiconal };
  motif carrier { NADP NADPH } forward { node853 node862 } backward { node12515 node12521 node12527 node12533 node877 };
}
