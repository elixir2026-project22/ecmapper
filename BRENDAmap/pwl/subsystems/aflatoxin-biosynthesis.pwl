  compound acetate brenda:47 kegg:C00033;
  compound aflatoxin_B1 'aflatoxin B1' brenda:9093 kegg:C06800;
  compound aflatoxin_B2 'aflatoxin B2' brenda:29709 kegg:C16753;
  compound aflatoxin_G1 'aflatoxin G1' brenda:66196 kegg:C16755;
  compound aflatoxin_G2 'aflatoxin G2' brenda:92317 kegg:C16754;
  compound dihydrodemethylsterigmatocystin brenda:20712 kegg:C20444;
  compound dihydrosterigmatocystin brenda:30714 kegg:C20445;
