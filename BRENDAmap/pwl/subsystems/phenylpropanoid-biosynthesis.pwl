pwl 2.0;
subsystem phenylpropanoid-biosynthesis 'phenylpropanoid biosynthesis' {
  // BRENDA subsystem: 21 reactions (17 with direction), 22 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 4_coumarate '4-coumarate' brenda:1215 brenda:19540 kegg:C00811;
  compound 4_coumaroyl_CoA '4-coumaroyl-CoA' brenda:448 kegg:C00223;
  compound 4_coumaroylshikimate '4-coumaroylshikimate' brenda:20627 kegg:C02947;
  compound 4_coumaryl_alcohol '4-coumaryl alcohol' brenda:6575 kegg:C02646;
  compound 4_hydroxybenzalacetone '4-hydroxybenzalacetone' brenda:88234 kegg:C12088;
  compound 5_O_4_coumaroyl_quinate '5-O-(4-coumaroyl)quinate' brenda:91818;
  compound 5_hydroxyconiferaldehyde '5-hydroxyconiferaldehyde' brenda:78504 kegg:C12204;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_quinate 'L-quinate' brenda:2243 kegg:C00296;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Phe brenda:203;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound acetate brenda:47 kegg:C00033;
  compound caffeoyl_CoA 'caffeoyl-CoA' brenda:537 kegg:C00323;
  compound caffeoylshikimate brenda:179021;
  compound coniferaldehyde brenda:3680 kegg:C02666;
  compound coniferyl_acetate 'coniferyl acetate' brenda:4187 kegg:C20225;
  compound coniferyl_alcohol 'coniferyl alcohol' brenda:1202 kegg:C00590;
  compound coumaraldehyde brenda:63251;
  compound eugenol brenda:909 kegg:C10453;
  compound feruloyl_CoA 'feruloyl-CoA' brenda:427 kegg:C00406;
  compound isoeugenol brenda:3640 kegg:C10469;
  compound isomethyleugenol brenda:49488 kegg:C10478;
  compound malonyl_CoA 'malonyl-CoA' brenda:76 kegg:C00083;
  compound oxidized_NADPH_hemoprotein_reductase '[oxidized NADPH-hemoprotein reductase]' brenda:88270 brenda:222173 brenda:282801 kegg:C03161;
  compound reduced_NADPH_hemoprotein_reductase '[reduced NADPH-hemoprotein reductase]' brenda:1123 brenda:88271 brenda:222268 brenda:283138 kegg:C03024;
  compound shikimate brenda:352 kegg:C00493;
  compound sinapaldehyde brenda:5214 kegg:C05610;
  compound sinapyl_alcohol 'sinapyl alcohol' brenda:3670 kegg:C02325;
  compound trans_5_O_caffeoyl_D_quinate 'trans-5-O-caffeoyl-D-quinate' brenda:46404 kegg:C00852;
  compound trans_cinnamate 'trans-cinnamate' brenda:1544 kegg:C00423;
  port Phe side U to phenylalanine-metabolism;

  // ring: cycle of the drawing (6 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    5_O_4_coumaroyl_quinate
      <-[node10550: 2.3.1.133 | -L_quinate, +CoA ^L {br=BS320439, ev=cof+eq, match=single}]- 4_coumaroyl_CoA  // shikimate O-hydroxycinnamoyltransferase
      -R[node10549: 2.3.1.133 | -shikimate, +CoA ^R {br=BR43994, ev=cof+eq}]-> 4_coumaroylshikimate;  // shikimate O-hydroxycinnamoyltransferase
    caffeoylshikimate
      -L[node10561: 2.3.1.99 | -CoA, +shikimate {br=BS320440, ev=cof-eq, match=single}]-> caffeoyl_CoA  // quinate O-hydroxycinnamoyltransferase
      <-[node10562: 2.3.1.99 | -CoA, +L_quinate ^R {br=BS321558, ev=cof-eq}]- trans_5_O_caffeoyl_D_quinate;  // quinate O-hydroxycinnamoyltransferase
    react [node10555: 1.14.14.96 | NADPH>NADP, -H, -O2, +H2O] {trans_5_O_caffeoyl_D_quinate, 5_O_4_coumaroyl_quinate, 4_coumaroylshikimate, caffeoylshikimate};  // 5-O-(4-coumaroyl)-D-quinate 3'-monooxygenase
  }

  caffeoyl_CoA
    -B[node10564: 2.1.1.104 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine {br=BR43863, ev=cof+eq}]-> feruloyl_CoA  // caffeoyl-CoA O-methyltransferase
    -[node10566: 1.2.1.44 | NADPH>NADP, +CoA {br=BS189226, ev=cof+eq, match=single}]-> coniferaldehyde  // cinnamoyl-CoA reductase
    -[node10568: 1.1.1.195 | NADPH>NADP, -H {br=BR36707, ev=cof-eq, match=kegg}]-> coniferyl_alcohol  // cinnamyl-alcohol dehydrogenase
    <-[node11702: 2.3.1.84 | CoA>Ac_CoA ^L {br=BS423190, ev=cof-eq}]- coniferyl_acetate  // acalcohol O-acetyltransferase
    -R[node11704: 1.1.1.318 | -NADP, -NADPH, -acetate {br=BS417926, ev=conflict}]- eugenol;  // eugenol synthase

  coniferyl_acetate
    -L[node11705: 1.1.1.319 | NADPH>NADP, -acetate {br=BR50009, ev=conflict}]- isoeugenol  // isoeugenol synthase
    -L[node11716: 2.1.1.279 {br=BR43877, ev=eq}]-> isomethyleugenol;  // trans-anol O-methyltransferase

  coniferaldehyde
    -L[node10569: 1.14.14.B13 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR52337, ev=cof+eq}]-> 5_hydroxyconiferaldehyde  // coniferylaldehyde 5-hydroxylase
    -[node10571: 2.1.1.68 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^R {br=BS319578, ev=cof+eq}]-> sinapaldehyde  // caffeate O-methyltransferase
    -L[node10573: 1.1.1.195 | NADPH>NADP, -H {br=BS187664, ev=cof+eq}]-> sinapyl_alcohol;  // cinnamyl-alcohol dehydrogenase

  4_coumaroyl_CoA
    -L[node10551: 1.2.1.44 | NADPH>NADP, -H, +CoA {br=BS388396, ev=cof+eq, match=single}]-> coumaraldehyde  // cinnamoyl-CoA reductase
    -L[node10576: 1.1.1.195 | NADPH>NADP, -H {br=BS426143, ev=cof-eq, match=single}]-> 4_coumaryl_alcohol;  // cinnamyl-alcohol dehydrogenase

  4_coumaroyl_CoA
    -B[node1925: 2.3.1.212 | +H2O, +malonyl_CoA, +2*CO2, +2*CoA {br=BR50404, ev=conflict}]- 4_hydroxybenzalacetone;  // benzalacetone synthase

  Phe
    -L[node10543: 4.3.1.24 | +H, +NH3 {br=BR3427, ev=cof+eq, match=single}]-> trans_cinnamate  // phenylalanine ammonia-lyase
    -[node10545: 1.14.14.91 | reduced_NADPH_hemoprotein_reductase>oxidized_NADPH_hemoprotein_reductase, -O2, +H2O {br=BR33713, ev=cof+eq}]-> 4_coumarate  // trans-cinnamate 4-monooxygenase
    -L[node10547: 6.2.1.12 | ATP>AMP, -CoA, +PPi {br=BR63, ev=cof+eq}]-> 4_coumaroyl_CoA;  // 4-Coumarate-CoA ligase
}
