pwl 2.0;
subsystem pyrimidine-metabolism 'pyrimidine metabolism' {
  // BRENDA subsystem: 50 reactions (42 with direction), 36 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2_deoxy_Rib_1_P '2-deoxy-Rib 1-P' brenda:33002;
  compound 2_methyl_3_oxopropanoate '2-methyl-3-oxopropanoate' brenda:3179 kegg:C00349;
  compound 3_Ureidoisobutyrate '3-Ureidoisobutyrate' brenda:182082 kegg:C05100;
  compound 5_10_methylenetetrahydrofolate '5,10-methylenetetrahydrofolate' brenda:401 kegg:C00143;
  compound 5_6_dihydrothymine '5,6-dihydrothymine' brenda:7396 kegg:C00906;
  compound 5_P_alpha_D_Rib_1_PP '5-P-alpha-D-Rib 1-PP' brenda:158 kegg:C00119;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Ala brenda:103 kegg:C00041;
  compound Asp brenda:97 kegg:C00049;
  compound CDP brenda:212 kegg:C00112;
  compound CMP brenda:100 kegg:C00055;
  compound CO2 brenda:28 kegg:C00011;
  compound CTP brenda:60 kegg:C00063;
  compound Cyd brenda:372 kegg:C00475;
  compound DCMP brenda:450 kegg:C00239;
  compound DHF brenda:193 kegg:C00415;
  compound D_ribose 'D-ribose' brenda:292 brenda:16502;
  compound FAD brenda:20 kegg:C00016;
  compound FADH2 brenda:256 kegg:C01352;
  compound GDP brenda:53 kegg:C00035;
  compound GTP brenda:37 kegg:C00044;
  compound Gln brenda:102 kegg:C00064;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2O2 brenda:1126 kegg:C00027;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound R_3_Amino_2_methylpropanoate '(R)-3-Amino-2-methylpropanoate' brenda:10450;
  compound UDP brenda:26 kegg:C00015;
  compound UMP brenda:133 kegg:C00105;
  compound UTP brenda:65 kegg:C00075;
  compound Ura brenda:334 kegg:C00106;
  compound Uri brenda:261 kegg:C00299;
  compound alpha_D_Rib_1_P 'alpha-D-Rib 1-P' brenda:752 kegg:C00620;
  compound carbamoyl_Asp 'carbamoyl-Asp' brenda:4838 kegg:C00438;
  compound carbamoyl_phosphate 'carbamoyl phosphate' brenda:440 kegg:C00169;
  compound cytosine brenda:489 kegg:C00380;
  compound dCDP brenda:1124 kegg:C00705;
  compound dCTP brenda:179 kegg:C00458;
  compound dTDP brenda:542 kegg:C00363;
  compound dTMP brenda:635 kegg:C00364;
  compound dTTP brenda:145 kegg:C00459;
  compound dUDP brenda:1787 kegg:C01346;
  compound dUMP brenda:602 kegg:C00365;
  compound dUTP brenda:435 kegg:C00460;
  compound deoxycytidine brenda:451 kegg:C00881;
  compound deoxyuridine brenda:1060 kegg:C00526;
  compound dihydroorotate brenda:908;
  compound formate brenda:120 kegg:C00058;
  compound orotate brenda:446 kegg:C00295;
  compound orotidine_5_P 'orotidine 5\'-P' brenda:742 kegg:C01103;
  compound ox_thioredoxin 'ox. thioredoxin' brenda:1795 kegg:C00343;
  compound oxidized_glutaredoxin_like_protein 'oxidized glutaredoxin-like protein' brenda:189771;
  compound pyruvate brenda:31 kegg:C00022;
  compound red_thioredoxin 'red. thioredoxin' brenda:1120 kegg:C00342;
  compound reduced_glutaredoxin_like_protein 'reduced glutaredoxin-like protein' brenda:189770;
  compound thymidine brenda:166 kegg:C00214;
  compound thymine brenda:438 kegg:C00178;
  compound ubiquinol brenda:749 kegg:C00390;
  compound ubiquinone brenda:410 kegg:C00399;
  port 2_deoxy_Rib_1_P side L to purine-metabolism;

  // ring: cycle of the drawing (13 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    Cyd
      -L[node6309: 2.7.1.48 | GTP>GDP {br=BS357586, ev=cof+eq}]-> CMP  // uridine/cytidine kinase
      -R[node6313: 2.7.4.14 | ATP>ADP ^R {br=BS359742, ev=cof+eq}]-> CDP  // UMP/CMP kinase
      -[node4344: -> 1.17.4.1 | -red_thioredoxin, +ox_thioredoxin, +H2O {br=BS287792, ev=cof+eq} || node4305: 1.17.4.1 | reduced_glutaredoxin_like_protein>oxidized_glutaredoxin_like_protein, +H2O]- dCDP  // ribonucleoside-diphosphate reductase; ribonucleoside-diphosphate reductase
      -R[node3322: 3.6.1.12 | -H2O, +Pi ^R {br=BS384570, ev=cof+eq}]-> DCMP  // dCTP diphosphatase
      -R[node3318: 3.5.4.12 | -H2O, +NH3 ^L {br=BR29523, ev=cof+eq}]-> dUMP  // dCMP deaminase
      <-R[node11037: 3.5.4.30 | -2*H2O, +PPi, +NH3 {br=BR48302, ev=cof+eq}]- dCTP  // dCTP deaminase (dUMP-forming)
      -B[node6234: 3.5.4.13 | -H2O, +NH3 ^R {br=BR22734, ev=cof+eq}]-> dUTP  // dCTP deaminase
      <-R[node6243: 2.7.4.6 | ATP>ADP, +H {br=BS387815, ev=cof-eq}]- dUDP  // nucleoside-diphosphate kinase
      -[node6238: <- 1.17.4.1 | -red_thioredoxin, +H2O, +ox_thioredoxin {br=BS287795, ev=cof+eq} || node4301: 1.17.4.1 | reduced_glutaredoxin_like_protein>oxidized_glutaredoxin_like_protein, +H2O]- UDP  // ribonucleoside-diphosphate reductase; ribonucleoside-diphosphate reductase
      <-[node4523: 2.7.4.14 | ATP>ADP, +H {br=BR48071, ev=cof+eq} || node7845: 2.7.4.22 | ATP>ADP {br=BR48071, ev=cof+eq}]- UMP  // UMP/CMP kinase; UMP kinase
      -L[node6302: 2.4.2.9 | -PPi, +5_P_alpha_D_Rib_1_PP ^L {br=BR47535, ev=cof+eq}]-> Ura  // uracil phosphoribosyltransferase
      <-B[node6288: 2.4.2.3 | -Pi, +alpha_D_Rib_1_P {br=BR47549, ev=cof+eq} || node2856: 3.2.2.8 | -H2O, +D_ribose {br=BR32612, ev=cof+eq}]- Uri  // uridine phosphorylase; ribosylpyrimidine nucleosidase
      <-[node6284: 3.5.4.5 | -H2O, +NH3 ^L {br=BR22742, ev=cof+eq}]- Cyd;  // cytidine deaminase
    chord dCTP -[node1928: 3.6.1.65 | -PPi, -H2O {br=BR22752, ev=conflict}]- DCMP;  // (d)CTP diphosphatase
    chord Uri -R[node6298: 2.7.1.48 | GTP>GDP, +H {br=BS357585, ev=cof+eq}]-> UMP;  // uridine/cytidine kinase
    chord dCDP -R[node4339: 2.7.4.6 | ATP>ADP, +H {br=BS358245, ev=cof+eq}]-> dCTP;  // nucleoside-diphosphate kinase
    chord dUTP -[node6251: 3.6.1.23 | -H2O, +H, +PPi ^L {br=BR22764, ev=cof+eq}]-> dUMP;  // dUTP diphosphatase
  }

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    2_deoxy_Rib_1_P
      <-L[node6276: 2.4.2.4 | -Pi, +Ura ^L {br=BS354611, ev=cof+eq, match=single}]- deoxyuridine  // thymidine phosphorylase
      -R[node6270: 2.7.1.21 | ATP>ADP, +H {br=BS353774, ev=cof+eq, match=kegg}]-> dUMP  // thymidine kinase
      -R[node6256: 2.1.1.45 | -5_10_methylenetetrahydrofolate, +DHF {br=BR43900, ev=cof+eq} || node8104: 2.1.1.148 | FADH2>FAD, -5_10_methylenetetrahydrofolate {br=BS354165, ev=cof+eq}]-> dTMP  // thymidylate synthase; thymidylate synthase (FAD)
      <-[node6294: 2.7.1.21 | ATP>ADP, +H {br=BR47761, ev=cof+eq}]- thymidine;  // thymidine kinase
    thymidine -[node6280: 2.4.2.4 | -Pi {br=BS355326, ev=cof+eq, match=single}]-> (thymine + 2_deoxy_Rib_1_P);  // thymidine phosphorylase
  }

  Cyd
    -[node2853: 3.2.2.8 | -H2O, +D_ribose ^L {br=BS214504, ev=cof+eq}]-> cytosine#2;  // ribosylpyrimidine nucleosidase

  UDP
    -L[node4518: 2.7.4.6 | ATP>ADP, +H {br=BS358242, ev=cof+eq}]-> UTP  // nucleoside-diphosphate kinase
    -B[node6247: 1.1.98.6 | -formate, +H2O, +CO2 {br=BS439976, ev=cof+eq}]-> dUTP;  // ribonucleoside-triphosphate reductase (formate)

  UTP
    -[node4513: 6.3.4.2 | Gln>Glu, ATP>ADP, +Pi]- CTP  // CTP synthase (glutamine hydrolysing)
    -R[node11693: 3.6.1.5 | -H2O, -H, +PPi {br=BR50549, ev=cof+eq}]-> CMP#2  // apyrase
    -L[node11695: 3.1.3.91 | -H2O, +Pi {br=BR50761, ev=cof+eq}]-> Cyd#2;  // 7-methylguanosine nucleotidase

  CDP
    -B[node4504: 2.7.4.6 | ATP>ADP, +H {br=BS358244, ev=cof+eq}]-> CTP  // nucleoside-diphosphate kinase
    -L[node4334: 1.1.98.6 | -formate, +CO2, +H2O {br=BS439364, ev=cof+eq}]-> dCTP;  // ribonucleoside-triphosphate reductase (formate)

  dTMP
    -[node6260: 2.7.4.9 | ATP>ADP, +H]- dTDP  // dTMP kinase
    -L[node6265: 2.7.4.6 | ATP>ADP, +H {br=BS358250, ev=cof+eq}]-> dTTP;  // nucleoside-diphosphate kinase

  cytosine
    -[node6306: 3.5.4.1 | -H2O, +NH3 ^R {br=BR22732, ev=cof+eq}]-> Ura;  // cytosine deaminase

  carbamoyl_phosphate
    -L[node4543: 2.1.3.2 | -Asp, +Pi, +H {br=BR43949, ev=cof+eq}]-> carbamoyl_Asp  // aspartate carbamoyltransferase
    -R[node4538: 3.5.2.3 | -H, +H2O]- dihydroorotate  // dihydroorotase
    -R[node4534: -> 1.3.5.2 | -ubiquinone, +ubiquinol {br=BS258665, ev=cof+eq} || node8097: 1.3.98.1 | -O2, +H2O2 || node2390: -> 1.3.1.14 | NAD>NADH {br=BS370137, ev=cof+eq}]- orotate  // dihydroorotate dehydrogenase (quinone); dihydroorotate dehydrogenase (fumarate); dihydroorotate dehydrogenase (NAD+)
    -[node4530: 2.4.2.10 | -5_P_alpha_D_Rib_1_PP, +PPi ^R {br=BR44268, ev=cof-eq}]-> orotidine_5_P  // orotate phosphoribosyltransferase
    -L[node4527: 4.1.1.23 | -H, +CO2 {br=BR284, ev=cof+eq}]-> UMP;  // Orotidine-5'-phosphate decarboxylase

  deoxycytidine
    -[node6272: 3.5.4.5 | -H2O, +NH3 ^R {br=BR22735, ev=cof+eq, match=kegg}]-> deoxyuridine;  // cytidine deaminase

  thymine
    -B[node3351: 1.3.1.2 | NADPH>NADP ^R {br=BS231909, ev=cof+eq, match=kegg}]-> 5_6_dihydrothymine  // dihydropyrimidine dehydrogenase (NADP+)
    -[node3353: 3.5.2.2 | -H2O, +H ^L {br=BS140727, ev=cof-eq, match=single}]-> 3_Ureidoisobutyrate  // dihydropyrimidinase
    -R[node3364: 3.5.1.6 | -H2O, -H, +CO2, +NH3]- R_3_Amino_2_methylpropanoate  // beta-ureidopropionase
    -[node3359: 2.6.1.40 | pyruvate>Ala ^R {br=BR47992, ev=cof+eq}]-> 2_methyl_3_oxopropanoate;  // (R)-3-amino-2-methylpropionate-pyruvate transaminase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { CDP CTP CMP };
  motif substrate_cycle { CMP Cyd } forward { node11695 } backward { node6309 };
  motif shunt { CTP dCTP dUTP } bypasses { CTP CMP Cyd Uri UMP UDP UTP dUTP };
  motif shunt { CTP dCTP dUMP } bypasses { CTP CMP CDP dCDP DCMP dUMP };
}
