pwl 2.0;
subsystem cysteine-metabolism 'cysteine metabolism' {
  // BRENDA subsystem: 24 reactions (22 with direction), 22 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OBUT brenda:390 kegg:C00109;
  compound 2OG brenda:34 kegg:C00026;
  compound 3_sulfino_L_alanine '3-sulfino-L-alanine' brenda:30957 kegg:C00606;
  compound 3_sulfinylpyruvate '3-sulfinylpyruvate' brenda:182190 kegg:C05527;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ac_CoA 'Ac-CoA' brenda:29 kegg:C00024;
  compound Ac_Ser 'Ac-Ser' brenda:680 kegg:C00979;
  compound CN 'CN-' brenda:118;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Cys brenda:74 kegg:C00097;
  compound D_Cys 'D-Cys' brenda:1350 kegg:C00793;
  compound GSH brenda:44 kegg:C00051;
  compound GSSG brenda:973 kegg:C00127;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound H2S brenda:911 kegg:C00283;
  compound L_cystathionine 'L-cystathionine' brenda:585 kegg:C02291;
  compound L_cysteate 'L-cysteate' brenda:4827 kegg:C00506;
  compound L_cysteinyl_tRNACys 'L-cysteinyl-tRNACys' brenda:10689 kegg:C03125;
  compound L_cystine 'L-cystine' brenda:1218 kegg:C00491;
  compound L_homocysteine 'L-homocysteine' brenda:305 kegg:C00155;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NCS 'NCS-' brenda:931;
  compound NH3 brenda:27;
  compound O2 brenda:9 brenda:1180;
  compound O_Ac_homoSer 'O-Ac-homoSer' brenda:948 kegg:C01077;
  compound O_phospho_Ser 'O-phospho-Ser' brenda:1189 kegg:C01005;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound Ser brenda:95 kegg:C00065;
  compound acetate brenda:47 kegg:C00033;
  compound bisulfite brenda:2546 kegg:C11481;
  compound hypotaurine brenda:5161 kegg:C00519;
  compound mercaptopyruvate brenda:1122 kegg:C00957;
  compound pyruvate brenda:31 kegg:C00022;
  compound sulfite brenda:92 kegg:C00094;
  compound tRNACys brenda:914 kegg:C01639;
  compound taurine brenda:595 kegg:C00245;
  port Ac_CoA side L to oxidative-decarboxylation-of-pyruvate;
  port Ac_Ser side R to D-cycloserine-biosynthesis;
  port Cys side D to alanine-metabolism;
  port GSH side U to glutathione-metabolism;
  port GSSG side U to glutathione-metabolism;
  port O_phospho_Ser side L to serine-metabolism;
  port Ser side L to serine-metabolism;

  // ring: cycle of the drawing (5 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    Cys
      -B[node5335: 1.13.11.20 | -O2 ^R {br=BR40484, ev=cof+eq}]-> 3_sulfino_L_alanine  // cysteine dioxygenase
      -L[node11333: 2.6.1.1 | 2OG>Glu {br=BS356302, ev=cof+eq, match=single} || node5332: 2.6.1.1 | 2OG>Glu {br=BS356302, ev=cof+eq, match=single}]-> 3_sulfinylpyruvate  // aspartate transaminase; aspartate transaminase
      -L[node5328: ~? | -H2O, +H, +sulfite {br=BR52888, ev=cof+eq}]-> pyruvate  // spontaneous reaction
      <-[node5341: 4.4.1.25 | -H2O, +bisulfite, +NH3 {br=BR48705, ev=cof+eq}]- L_cysteate  // L-cysteate sulfo-lyase
      <-B[node5342: 4.4.1.10 | -sulfite, +H2S {br=BR3436, ev=cof+eq}]- Cys;  // cysteine lyase
    chord Cys -R[node5326: 4.4.1.1 | -H2O, +H2S, +NH3 ^R {br=BR51143, ev=cof+eq}]-> pyruvate;  // cystathionine gamma-lyase
  }

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring ccw {
    hypotaurine
      -R[node512: 1.14.13.8 | NAD>NADH, -H2O, +H {br=BR37006, ev=cof+eq}]-> taurine  // flavin-containing monooxygenase
      -[node514: 4.1.1.29 | +CO2 ^L]- L_cysteate#2  // sulfinoalanine decarboxylase
      <-L[node516: ~? | NAD>NADH, -H2O, +H ^R {br=BR53394, ev=cof+eq}]- 3_sulfino_L_alanine  // spontaneous reaction
      -B[node524: 4.1.1.29 | +CO2 ^R {br=BR288, ev=cof+eq}]-> hypotaurine;  // sulfinoalanine decarboxylase
  }

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    Cys
      -[node5646: 2.6.1.3 | 2OG>Glu {br=BR47681, ev=cof+eq}]-> mercaptopyruvate  // cysteine transaminase
      -R[node5650: 2.8.1.2 | -CN, +NCS ^L {br=BS360032, ev=cof+eq}]-> pyruvate  // 3-mercaptopyruvate sulfurtransferase
      <-B[node5430: 4.4.1.15 | -H2O, +H2S, +NH3 {br=BR48361, ev=cof+eq}]- D_Cys  // D-cysteine desulfhydrase
      -[node5420: 5.1.1.10]- Cys;  // Amino-acid racemase
  }

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    Ac_Ser
      -R[node5419: 2.5.1.47 | -H2S, +acetate ^R {br=BR47463, ev=cof+eq}]-> Cys  // cysteine synthase
      <-B[node5642: 4.4.1.1 | -H2O, +2OBUT, +NH3 {br=BR3435, ev=cof+eq}]- L_cystathionine;  // cystathionine gamma-lyase
    (Ser + Ac_CoA) -[node5413: 2.3.1.30 | +CoA {br=BR44030, ev=cof+eq}]-> Ac_Ser;  // serine O-acetyltransferase
    (Ser + L_homocysteine) -[node5415: 4.2.1.22 | +H2O {br=BR406, ev=cof+eq}]-> L_cystathionine;  // Cystathionine beta-synthase
  }

  Cys
    -[node5426: 1.8.1.6 | NAD>NADH, +H ^L {br=BR40533, ev=cof+eq}]-> L_cystine;  // cystine reductase

  O_phospho_Ser
    -[node5422: 2.5.1.65 | -H2S, +Pi ^L {br=BR48518, ev=cof+eq}]-> Cys;  // O-phosphoserine sulfhydrylase

  O_Ac_homoSer
    -L[node7579: 2.5.1.49 | -H2S, +acetate {br=BS354674, ev=cof+eq}]-> L_homocysteine;  // O-acetylhomoserine aminocarboxypropyltransferase

  (tRNACys + Cys) -[node11028: 6.1.1.16 | ATP>AMP, +PPi {br=BR46, ev=cof+eq}]-> L_cysteinyl_tRNACys;  // Cysteine-tRNA ligase
  (2*GSH + L_cystine) -[node5425: 1.8.4.4 {br=BR37026, ev=eq}]-> (GSSG + 2*Cys);  // glutathione-cystine transhydrogenase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { GSH GSSG } bypasses { GSH Cys L_cystine GSSG };
}
