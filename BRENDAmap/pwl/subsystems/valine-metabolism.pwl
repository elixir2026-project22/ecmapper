pwl 2.0;
subsystem valine-metabolism 'valine metabolism' {
  // BRENDA subsystem: 13 reactions (11 with direction), 15 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 2_methyl_3_oxopropanoate '2-methyl-3-oxopropanoate' brenda:3179 kegg:C00349;
  compound 3_Hydroxyisobutyrate '3-Hydroxyisobutyrate' brenda:55682 kegg:C01188;
  compound 3_hydroxyisobutyryl_CoA '3-hydroxyisobutyryl-CoA' brenda:34361 kegg:C04047;
  compound 3_methyl_2_oxobutanoate '3-methyl-2-oxobutanoate' brenda:829 kegg:C00141;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound Dihydroxyisovalerate brenda:4465 kegg:C04039;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound HCO3 brenda:195 kegg:C00288;
  compound Isobutanal brenda:5980;
  compound Isobutanol brenda:3345 kegg:C14710;
  compound L_valyl_tRNAVal 'L-valyl-tRNAVal' brenda:8242 kegg:C02554;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound PPi brenda:17 kegg:C00013;
  compound S_2_acetolactate_L101726 '(S)-2-acetolactate' brenda:101726;
  compound Val brenda:246 kegg:C00183;
  compound electron_transfer_flavoprotein 'electron-transfer flavoprotein' brenda:1601 kegg:C04253;
  compound isobutyryl_CoA 'isobutyryl-CoA' brenda:842 kegg:C00630;
  compound methacryloyl_CoA 'methacryloyl-CoA' brenda:94022;
  compound propanoyl_CoA 'propanoyl-CoA' brenda:782 kegg:C00100;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_transfer_flavoprotein 'reduced electron-transfer flavoprotein' brenda:2112 kegg:C04570;
  compound tRNAVal brenda:1566 kegg:C01653;
  port 3_methyl_2_oxobutanoate side L to leucine-metabolism;
  port propanoyl_CoA side L to propanol-degradation;

  pyruvate
    -[node4618: 2.2.1.6 | +CO2 ^R {br=BS386675, ev=cof+eq}]-> S_2_acetolactate_L101726  // acetolactate synthase
    -[node4615: 1.1.1.86 | NADPH>NADP ^R]- Dihydroxyisovalerate  // ketol-acid reductoisomerase (NADP+)
    -R[node4611: 4.2.1.9 | +H2O ^R {br=BR3406, ev=cof+eq, match=kegg}]-> 3_methyl_2_oxobutanoate  // dihydroxy-acid dehydratase
    -R[node6082: 4.1.1.1 | -H, +CO2 ^R {br=BS363283, ev=cof+eq, match=kegg}]-> Isobutanal  // Pyruvate decarboxylase
    -[node6083: 1.1.1.1 | NADH>NAD ^R {br=BS186845, ev=cof-eq, match=single}]-> Isobutanol;  // alcohol dehydrogenase

  3_methyl_2_oxobutanoate
    -[node4608: 2.6.1.42 | Glu>2OG ^R {br=BS356553, ev=cof-eq}]-> Val;  // branched-chain-amino-acid transaminase

  3_methyl_2_oxobutanoate
    -[node6052: 1.2.1.25 | NAD>NADH, -CoA, +CO2 {br=BR36775, ev=cof+eq, match=kegg}]-> isobutyryl_CoA  // branched-chain alpha-keto acid dehydrogenase system
    -[node6055: 1.3.8.5 | -electron_transfer_flavoprotein, +H, +reduced_electron_transfer_flavoprotein]- methacryloyl_CoA  // short-chain 2-methylacyl-CoA dehydrogenase
    -R[node6063: 4.2.1.17 | -H2O ^L {br=BS444368, ev=cof+eq, match=single}]-> 3_hydroxyisobutyryl_CoA  // enoyl-CoA hydratase
    -R[node6064: 3.1.2.4 | -H2O, +H, +CoA {br=BR11729, ev=cof+eq, match=kegg}]-> 3_Hydroxyisobutyrate  // 3-hydroxyisobutyryl-CoA hydrolase
    -[node6067: 1.1.1.31 | NAD>NADH ^R {br=BR29294, ev=cof+eq, match=kegg}]-> 2_methyl_3_oxopropanoate  // 3-hydroxyisobutyrate dehydrogenase
    -[node6069: 1.2.1.27 | NAD>NADH, -CoA, -H2O, +HCO3 {br=BR36776, ev=cof+eq}]-> propanoyl_CoA;  // methylmalonate-semialdehyde dehydrogenase (CoA-acylating)

  (tRNAVal + Val) -[node10950: 6.1.1.9 | ATP>AMP, +PPi {br=BR59, ev=cof+eq}]-> L_valyl_tRNAVal;  // Valine-tRNA ligase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node6052 node6067 node6069 } backward { node6083 };
}
