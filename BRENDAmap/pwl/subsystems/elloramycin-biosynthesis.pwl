pwl 2.0;
subsystem elloramycin-biosynthesis 'elloramycin biosynthesis' {
  // BRENDA subsystem: 11 reactions (7 with direction), 12 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 12_demethylelloramycin_A '12-demethylelloramycin A' brenda:212381;
  compound 8_demethyl_8_2_3_di_O_methyl_alpha_L_rhamnosyl_tetracenomycin_C '8-demethyl-8-(2,3-di-O-methyl-alpha-L-rhamnosyl)tetracenomycin C' brenda:195031 kegg:C20976;
  compound 8_demethyl_8_2_O_methyl_alpha_L_rhamnosyl_tetracenomycin_C '8-demethyl-8-(2-O-methyl-alpha-L-rhamnosyl)tetracenomycin C' brenda:195032 kegg:C20975;
  compound 8_demethyl_8_alpha_L_rhamnosyltetracenomycin_C '8-demethyl-8-alpha-L-rhamnosyltetracenomycin C' brenda:175462 kegg:C20974;
  compound 8_demethyltetracenomycin_C '8-demethyltetracenomycin C' brenda:90144 kegg:C12379;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound S_adenosyl_L_homocysteine 'S-adenosyl-L-homocysteine' brenda:36 brenda:843 kegg:C00021;
  compound S_adenosyl_L_methionine 'S-adenosyl-L-methionine' brenda:24 kegg:C00019;
  compound dTDP brenda:542 kegg:C00363;
  compound dTDP_beta_L_rhamnose 'dTDP-beta-L-rhamnose' brenda:11552 kegg:C03319;
  compound elloramycin_A 'elloramycin A' brenda:212379 kegg:C12381;
  compound malonyl_CoA 'malonyl-CoA' brenda:76 kegg:C00083;
  compound tetracenomycin_B2 'tetracenomycin B2' brenda:196394 kegg:C12378;
  compound tetracenomycin_B3 'tetracenomycin B3' brenda:212377 kegg:C12369;
  compound tetracenomycin_D3 'tetracenomycin D3' brenda:61247 kegg:C12368;
  compound tetracenomycin_F1 'tetracenomycin F1' brenda:30248 kegg:C12367;
  compound tetracenomycin_F2 'tetracenomycin F2' brenda:193508 kegg:C12366;
  port malonyl_CoA side R to acetyl-CoA-biosynthesis;

  malonyl_CoA
    -[node1845: 2.3.1.235 | -10*CoA, +10*CO2, +2*H2O {br=BR51186, ev=conflict}]- tetracenomycin_F2  // tetracenomycin F2 synthase
    -[node1840: 4.2.1.154 | +H2O ^L {br=BR51058, ev=cof+eq}]-> tetracenomycin_F1  // tetracenomycin F2 cyclase
    -[node1837: 1.13.12.21 | -O2, +H2O ^L {br=BR50567, ev=cof+eq}]-> tetracenomycin_D3  // tetracenomycin-F1 monooxygenase
    -[node1833: 2.1.1.- | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L]- tetracenomycin_B3  // tetracenomycin D3 3-O-methyltransferase
    -[node1829: 2.1.1.- | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L]- tetracenomycin_B2  // tetracenomycin B3 9-O-methyltransferase
    -[node1825: 1.14.13.200 | 2*NADPH>2*NADP, -2*O2, -2*H, +H2O {br=BS429406, ev=cof+eq}]-> 8_demethyltetracenomycin_C  // tetracenomycin A2 monooxygenase-dioxygenase
    -[node1818: 2.4.1.331 | dTDP_beta_L_rhamnose>dTDP ^L {br=BR50871, ev=cof+eq}]-> 8_demethyl_8_alpha_L_rhamnosyltetracenomycin_C  // 8-demethyltetracenomycin C L-rhamnosyltransferase
    -[node1814: 2.1.1.305 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR50857, ev=cof+eq}]-> 8_demethyl_8_2_O_methyl_alpha_L_rhamnosyl_tetracenomycin_C  // 8-demethyl-8-alpha-L-rhamnosyl tetracenomycin-C 2'-O-methyltransferase
    -[node1810: 2.1.1.306 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR50858, ev=cof+eq}]-> 8_demethyl_8_2_3_di_O_methyl_alpha_L_rhamnosyl_tetracenomycin_C  // 8-demethyl-8-(2-methoxy-alpha-L-rhamnosyl)tetracenomycin-C 3'-O-methyltransferase
    -[node1806: 2.1.1.307 | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L {br=BR50859, ev=cof+eq, match=single}]-> 12_demethylelloramycin_A  // 8-demethyl-8-(2,3-dimethoxy-alpha-L-rhamnosyl)tetracenomycin-C 4'-O-methyltransferase
    -[node1802: 2.1.1.- | S_adenosyl_L_methionine>S_adenosyl_L_homocysteine ^L]- elloramycin_A;  // 12-demethyl-elloramycin C12a O-methyltransferase
}
