pwl 2.0;
subsystem coenzyme-M-biosynthesis 'coenzyme M biosynthesis' {
  // BRENDA subsystem: 16 reactions (13 with direction), 15 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2OG brenda:34 kegg:C00026;
  compound 2R_3_sulfolactate '(2R)-3-sulfolactate' brenda:13424 kegg:C11537;
  compound 2R_O_phospho_3_sulfolactate '(2R)-O-phospho-3-sulfolactate' brenda:50394 kegg:C11536;
  compound 2_sulfomethyl_1_3_thiazolidine_4_carboxylate '2-(sulfomethyl)-1,3-thiazolidine-4-carboxylate' brenda:188809;
  compound 3_sulfopyruvate '3-sulfopyruvate' brenda:3119 kegg:C05528;
  compound CO2 brenda:28 kegg:C00011;
  compound CoB brenda:2300 kegg:C04628;
  compound CoM brenda:1614;
  compound CoM_S_S_CoB 'CoM-S-S-CoB' brenda:5687 kegg:C04832;
  compound Cys brenda:74 kegg:C00097;
  compound F420_ox 'F420 (ox)' brenda:1665 kegg:C00876;
  compound F420_red 'F420 (red)' brenda:1244 kegg:C01080;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2 brenda:361 kegg:C00282;
  compound H2O brenda:1 kegg:C00001;
  compound L_cysteate 'L-cysteate' brenda:4827 kegg:C00506;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NH3 brenda:27;
  compound O_phospho_Ser 'O-phospho-Ser' brenda:1189 kegg:C01005;
  compound PEP brenda:51 kegg:C00074;
  compound Pi brenda:16 kegg:C00009;
  compound S_2_sulfoethyl_L_cysteine 'S-(2-sulfoethyl)-L-cysteine' brenda:190017;
  compound dihydromethanophenazine brenda:13397 kegg:C11904;
  compound formate brenda:120 kegg:C00058;
  compound methane brenda:2028 kegg:C01438;
  compound methanophenazine brenda:22131 kegg:C11903;
  compound methyl_CoM 'methyl-CoM' brenda:3879 kegg:C03920;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound oxidized_ferredoxin_Fe_S_cluster 'oxidized ferredoxin [Fe-S] cluster' brenda:202698 kegg:C00139;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound reduced_ferredoxin_Fe_S_cluster 'reduced ferredoxin [Fe-S] cluster' brenda:202701 kegg:C00138;
  compound sulfite brenda:92 kegg:C00094;
  compound sulfoacetaldehyde brenda:7288 kegg:C00593;
  port CoM side R to methanogenesis-from-CO2;
  port H2 side L to hydrogen-production;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    (methanophenazine + H2) -[node10836: 1.12.98.3 {br=BR40529, ev=eq, match=single}]-> dihydromethanophenazine;  // Methanosarcina-phenazine hydrogenase
    (CoB + CoM + methanophenazine) -[node3230: 1.8.98.1 {br=BR47628, ev=eq}]-> (dihydromethanophenazine + CoM_S_S_CoB);  // dihydromethanophenazine:CoB-CoM heterodisulfide reductase
    (CoB + CoM) -[node1485: 1.8.98.4 | 2*F420_ox>2*F420_red, 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H {br=BR52240, ev=cof+eq}]-> CoM_S_S_CoB;  // coenzyme F420:CoB-CoM heterodisulfide,ferredoxin reductase
    chord (CoB + CoM) -[node1484: 1.8.98.5 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, +2*H2 {br=BR52241, ev=cof+eq}]-> CoM_S_S_CoB;  // H2:CoB-CoM heterodisulfide,ferredoxin reductase
    chord (CoB + CoM) -[node1483: 1.8.98.6 | 2*reduced_ferredoxin_Fe_S_cluster>2*oxidized_ferredoxin_Fe_S_cluster, -2*H, -2*CO2, +2*formate {br=BR52242, ev=cof+eq}]-> CoM_S_S_CoB;  // formate:CoB-CoM heterodisulfide,ferredoxin reductase
  }

  PEP
    <-[node7488: 4.4.1.19 | -sulfite, -H {br=BR47587, ev=cof-eq, rev=eq, match=single}]-> 2R_O_phospho_3_sulfolactate  // phosphosulfolactate synthase
    -[node7481: 3.1.3.71 | -H2O, +Pi ^L {br=BR36951, ev=cof+eq, match=single}]-> 2R_3_sulfolactate  // 2-phosphosulfolactate phosphatase
    -R[node7484: -> 1.1.1.375 | NADP>NADPH {br=BR50231, ev=cof+eq} || node2722: <-> 1.1.1.337 | NAD>NADH {br=BS419706, ev=cof+eq, rev=eq}]- 3_sulfopyruvate  // L-2-hydroxycarboxylate dehydrogenase [NAD(P)+]; L-2-hydroxycarboxylate dehydrogenase (NAD+)
    -R[node7493: 4.1.1.79 | -H, +CO2 ^R {br=BR47974, ev=cof+eq, match=kegg}]-> sulfoacetaldehyde  // sulfopyruvate decarboxylase
    -[node7496: ? | -Cys, +H2O, +H ^R]- 2_sulfomethyl_1_3_thiazolidine_4_carboxylate  // unknown enzyme
    -[node7504: ? | reduced_electron_acceptor>oxidized_electron_acceptor, -H]- S_2_sulfoethyl_L_cysteine  // unknown enzyme
    -B[node7507: ? | -H2O, +NH3, +pyruvate, +H]- CoM;  // unknown enzyme

  CoB
    -R[node3225: 2.8.4.1 | -methyl_CoM, +methane ^R {br=BR36948, ev=cof+eq}]-> CoM_S_S_CoB;  // coenzyme-B sulfoethylthiotransferase

  O_phospho_Ser
    -[node11121: 2.5.1.76 | -sulfite, +Pi ^R {br=BR49121, ev=cof+eq}]-> L_cysteate  // cysteate synthase
    -B[node11123: 2.6.1.1 | 2OG>Glu {br=BS423733, ev=cof+eq}]-> 3_sulfopyruvate;  // aspartate transaminase
}
