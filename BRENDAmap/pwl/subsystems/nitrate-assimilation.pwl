pwl 2.0;
subsystem nitrate-assimilation 'nitrate assimilation' {
  // BRENDA subsystem: 8 reactions (6 with direction), 6 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2 brenda:361 kegg:C00282;
  compound H2O brenda:1 kegg:C00001;
  compound N2 brenda:6051 kegg:C00697;
  compound NH2OH brenda:85 kegg:C00192;
  compound NH3 brenda:27;
  compound NO2 brenda:168 kegg:C00088;
  compound NO3 brenda:308 kegg:C00244;
  compound O2 brenda:9 brenda:1180;
  compound Pi brenda:16 kegg:C00009;
  compound a_reduced_acceptor 'a reduced acceptor' brenda:200967;
  compound an_acceptor 'an acceptor' brenda:200969;
  compound electron_transferring_flavoprotein 'electron-transferring flavoprotein' brenda:2297 kegg:C04253;
  compound ferricytochrome_c 'ferricytochrome c' brenda:313 kegg:C00125;
  compound ferrocytochrome_c 'ferrocytochrome c' brenda:530 kegg:C00126;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  compound reduced_electron_transferring_flavoprotein 'reduced electron-transferring flavoprotein' brenda:1892 brenda:3252 kegg:C04570;
  port N2 side L to denitrification;
  port NH3 side U to alanine-metabolism;
  port NO2#2 side L to denitrification;

  NO3
    -[node10851: -> 1.7.7.2 | Fd_red>Fd_ox, -2*H, +H2O {br=BR40549, ev=cof-eq} || node6318: 1.7.99.- | -H, -ferrocytochrome_c, +H2O, +ferricytochrome_c]- NO2#2  // ferredoxin-nitrate reductase; nitrite:(acceptor) oxidoreductase
    -[node6316: 1.7.7.1 | 3*Fd_red>3*Fd_ox, -7*H, +2*H2O ^R {br=BR36987, ev=cof-eq}]-> NH3  // ferredoxin-nitrite reductase
    -[node3508: <- 1.18.6.1 | 4*Fd_red>4*Fd_ox, 16*ATP>16*ADP, -8*H, -16*H2O, +16*Pi, +H2 {br=BR40514, ev=cof+eq} || node2698: 1.19.6.1 | ATP>ADP, -reduced_electron_transferring_flavoprotein, -H, +electron_transferring_flavoprotein, +Pi]- N2;  // nitrogenase; nitrogenase (flavodoxin)

  NH3
    -L[node10856: <- 1.7.99.1 | reduced_electron_acceptor>oxidized_electron_acceptor, +H2O {br=BR36980, ev=cof-eq} || node2714: -> 1.14.99.39 | -O2, -a_reduced_acceptor, +H2O, +an_acceptor {br=BR49216, ev=cof+eq, match=kegg}]- NH2OH  // hydroxylamine reductase; ammonia monooxygenase
    -L[node2712: 1.7.2.6 | -H2O, -4*ferricytochrome_c, +4*ferrocytochrome_c, +5*H {br=BR50247, ev=cof+eq}]-> NO2;  // hydroxylamine dehydrogenase
  // motifs (detected from the reactions above, see PWL.md)
  motif cycle { NH2OH NO2 NH3 };
  motif substrate_cycle { NH2OH NH3 } forward { node10856 } backward { node2714 };
}
