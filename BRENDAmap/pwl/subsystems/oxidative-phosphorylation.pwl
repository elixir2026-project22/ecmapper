pwl 2.0;
subsystem oxidative-phosphorylation 'oxidative phosphorylation' {
  // BRENDA subsystem: 8 reactions (3 with direction), 9 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compartment side1 'side 1';
  compartment side2 'side 2';
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound O2 brenda:9 brenda:1180;
  compound Pi brenda:16 kegg:C00009;
  compound electron_transferring_flavoprotein 'electron-transferring flavoprotein' brenda:2297 kegg:C04253;
  compound oxidized_cytochrome_c 'oxidized cytochrome c' brenda:3116;
  compound reduced_cytochrome_c 'reduced cytochrome c' brenda:856 kegg:C00126;
  compound reduced_electron_transferring_flavoprotein 'reduced electron-transferring flavoprotein' brenda:1892 brenda:3252 kegg:C04570;
  compound ubiquinol brenda:749 kegg:C00390;
  compound ubiquinone brenda:410 kegg:C00399;

  reduced_cytochrome_c
    -L[node8627: 7.1.1.9 | -O2, +H2O ^R]- oxidized_cytochrome_c;  // cytochrome-c oxidase

  ubiquinone
    -L[node10033: 1.5.5.1 | -reduced_electron_transferring_flavoprotein, +electron_transferring_flavoprotein ^L {br=BR36912, ev=cof+eq}]-> ubiquinol;  // electron-transferring-flavoprotein dehydrogenase

  H
    -[node10028: 7.1.2.1/7.1.2.2 | -Pi, -ADP, +H2O, +H@side1]- ATP  // P-type H+-exporting transporter;H+-transporting two-sector ATPase
    -[node10050: 3.6.1.15 | -H2O, +Pi ^R {br=BR22769, ev=cof+eq}]-> ADP;  // nucleoside-triphosphate phosphatase

  Fd_red
    -[node10046: 1.18.1.3 | NAD>NADH, -H {br=BR40366, ev=cof+eq}]-> Fd_ox;  // ferredoxin-NAD+ reductase

  react [node8624: 7.1.1.8] {reduced_cytochrome_c, oxidized_cytochrome_c, ubiquinol, ubiquinone};  // quinol-cytochrome-c reductase
  react [node10039: 7.1.1.2 | NADH>NAD, -H@side1] {ubiquinol, ubiquinone, H@side2};  // NADH:ubiquinone reductase (H+-translocating)
  react [node10034: 7.1.1.3 | -H@side1, -O2, +2*H2O] {2*ubiquinol, 2*ubiquinone, H@side2};  // ubiquinol oxidase (H+-transporting)
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node10046 } backward { node10039 };
  motif transport { H@side1 H@side2 } via { node10039 };
  motif transport { H@side1 H@side2 } via { node10034 };
}
