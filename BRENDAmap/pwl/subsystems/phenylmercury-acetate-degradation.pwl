pwl 2.0;
subsystem phenylmercury-acetate-degradation 'phenylmercury acetate degradation' {
  // BRENDA subsystem: 2 reactions (2 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound Bn brenda:1750 kegg:C01407;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound Hg brenda:9181 kegg:C01319;
  compound Hg2 'Hg2+' brenda:33 kegg:C00703;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound acetate brenda:47 kegg:C00033;
  compound phenyl_mercuric_acetate 'phenyl mercuric acetate' brenda:12860;
  port acetate side R to acetate-fermentation;

  Hg2
    -L[node10204: 1.16.1.1 | NADPH>NADP, +H {br=BR40379, ev=cof-eq}]-> Hg;  // mercury(II) reductase

  phenyl_mercuric_acetate -[node10214: 4.99.1.2 | -H, +Bn {br=BS382547, ev=cof+eq}]-> (Hg2 + acetate);  // alkylmercury lyase
}
