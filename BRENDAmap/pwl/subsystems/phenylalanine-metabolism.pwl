pwl 2.0;
subsystem phenylalanine-metabolism 'phenylalanine metabolism' {
  // BRENDA subsystem: 21 reactions (18 with direction), 22 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2OG brenda:34 kegg:C00026;
  compound 2_phenylethanol '2-phenylethanol' brenda:1667 kegg:C05853;
  compound 3_amino_3_phenylpropanoyl_CoA '3-amino-3-phenylpropanoyl-CoA' brenda:41650;
  compound 4a_hydroxy_tetrahydrobiopterin '4a-hydroxy-tetrahydrobiopterin' brenda:3853 brenda:35294 kegg:C15522;
  compound 6_7_dihydrobiopterin '6,7-dihydrobiopterin' brenda:239173 kegg:C00268;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Ala brenda:103 kegg:C00041;
  compound CO2 brenda:28 kegg:C00011;
  compound CoA brenda:18 brenda:534 kegg:C00010;
  compound D_Phe 'D-Phe' brenda:1232 kegg:C02265;
  compound D_beta_phenylalanine 'D-beta-phenylalanine' brenda:12227 kegg:C20488;
  compound E_cinnamate '(E)-cinnamate' brenda:6144;
  compound E_cinnamoyl_CoA '(E)-cinnamoyl-CoA' brenda:16822;
  compound Fd_ox brenda:289 kegg:C00139;
  compound Fd_red brenda:265 kegg:C00138;
  compound Glu brenda:41 kegg:C00025;
  compound Glu_L202 'Glu' brenda:202;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_Phe_tRNAPhe 'L-Phe-tRNAPhe' brenda:8125 kegg:C03511;
  compound L_arogenate 'L-arogenate' brenda:883 kegg:C00826;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound O2 brenda:9 brenda:1180;
  compound PPPN brenda:30591 kegg:C05629;
  compound PPi brenda:17 kegg:C00013;
  compound Pac brenda:776;
  compound Phe brenda:203;
  compound R_phenyllactate '(R)-phenyllactate' brenda:5237 kegg:C05607;
  compound R_phenyllactyl_CoA '(R)-phenyllactyl-CoA' brenda:50413 kegg:C16257;
  compound Tyr brenda:109 kegg:C00082;
  compound a_5_6_7_8_tetrahydropteridine 'a 5,6,7,8-tetrahydropteridine' brenda:110471;
  compound chorismate brenda:204 kegg:C00251;
  compound electron_transfer_flavoprotein 'electron-transfer flavoprotein' brenda:1601 kegg:C04253;
  compound phenylacetaldehyde brenda:769 kegg:C00601;
  compound phenylacetyl_CoA 'phenylacetyl-CoA' brenda:1147 kegg:C00582;
  compound phenylpyruvate brenda:198 kegg:C00166;
  compound prephenate brenda:353 kegg:C00254;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_transfer_flavoprotein 'reduced electron-transfer flavoprotein' brenda:2112 kegg:C04570;
  compound tRNAPhe brenda:1384 kegg:C01648;
  compound tetrahydrobiopterin brenda:252 kegg:C00272;
  port 3_amino_3_phenylpropanoyl_CoA side L to taxol-biosynthesis;
  port L_arogenate side R to tyrosine-metabolism;
  port Phe side D to phenylpropanoid-biosynthesis;
  port Phe side U to suberin-monomers-biosynthesis;
  port Tyr side R to tyrosine-metabolism;
  port chorismate side U to chorismate-metabolism;
  port prephenate side R to tyrosine-metabolism;
  port prephenate side U to bacilysin-biosynthesis;

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    prephenate
      -L[node5910: 2.6.1.79 | Glu>2OG ^L {br=BR48630, ev=cof-eq}]-> L_arogenate  // glutamate-prephenate aminotransferase
      -R[node5914: 4.2.1.91 | +H2O, +CO2 {br=BR48340, ev=cof+eq, match=single}]-> Phe  // arogenate dehydratase
      -B[node4788: 2.6.1.58 | pyruvate>Ala {br=BR47420, ev=cof+eq, match=single} || node5906: 2.6.1.57 | -Glu_L202, -2OG {br=BS353519, ev=cof+eq}]-> phenylpyruvate  // phenylalanine(histidine) transaminase; aromatic-amino-acid transaminase
      <-R[node5902: 4.2.1.51 | +CO2, +H2O ^R {br=BR3398, ev=cof+eq}]- prephenate;  // prephenate dehydratase
  }

  phenylpyruvate
    -R[node4797: 4.1.1.43 | +CO2 ^L {br=BR303, ev=cof+eq}]-> phenylacetaldehyde  // Phenylpyruvate decarboxylase
    -L[node4794: 1.2.1.39 | NAD>NADH, -H2O, +H {br=BR36781, ev=cof+eq}]-> Pac;  // phenylacetaldehyde dehydrogenase

  phenylacetaldehyde
    -[node4785: 1.1.1.1 | NADH>NAD ^R {br=BS186840, ev=cof-eq, match=single}]-> 2_phenylethanol;  // alcohol dehydrogenase

  Phe
    -R[node11599: 5.4.3.10 {br=BR50482, ev=eq, match=single}]-> D_beta_phenylalanine  // phenylalanine aminomutase (L-beta-phenylalanine forming)
    -[node12114: 6.2.1.- | ATP>AMP, -CoA, +PPi]- 3_amino_3_phenylpropanoyl_CoA;  // 

  phenylpyruvate
    -R[node11185: 1.2.7.7/1.2.7.8 | Fd_ox>Fd_red, -CoA, +CO2 {br=BS359419, ev=cof+eq}]-> phenylacetyl_CoA;  // 3-methyl-2-oxobutanoate dehydrogenase (ferredoxin);indolepyruvate ferredoxin oxidoreductase

  phenylpyruvate
    -B[node1380: 1.1.1.110 | NADH>NAD ^R {br=BS187840-a, ev=eq}]-> R_phenyllactate;  // aromatic 2-oxoacid reductase

  Phe
    -R[node10687: 6.1.1.20 | ATP>AMP, -tRNAPhe, +PPi {br=BR51, ev=cof+eq, match=single}]-> L_Phe_tRNAPhe;  // Phenylalanine-tRNA ligase

  Phe
    -R[node4781: 5.1.1.11 | ATP>AMP, -H2O, +PPi]- D_Phe;  // Phenylalanine racemase (ATP-hydrolysing)

  chorismate
    -[node4649: 5.4.99.5 {br=BR252, ev=eq}]-> prephenate;  // Chorismate mutase

  E_cinnamate
    -L[node12345: 1.3.8.15 | -reduced_electron_transfer_flavoprotein, +electron_transfer_flavoprotein ^R {br=BR52971, ev=cof-eq}]-> PPPN;  // 3-(aryl)acrylate reductase

  R_phenyllactyl_CoA
    -L[node12026: 4.2.1.175 | +H2O ^R {br=BR51461, ev=cof+eq, match=kegg}]-> E_cinnamoyl_CoA;  // (R)-3-(aryl)lactoyl-CoA dehydratase

  4a_hydroxy_tetrahydrobiopterin
    -[node4803: 4.2.1.96 | +H2O ^R {br=BR468, ev=cof+eq, match=single}]-> 6_7_dihydrobiopterin  // 4a-hydroxytetrahydrobiopterin dehydratase
    <-R[node4800: 1.5.1.34 | NADH>NAD ^R {br=BR43856, ev=eq, match=similar}]- a_5_6_7_8_tetrahydropteridine;  // 6,7-dihydropteridine reductase

  (R_phenyllactate + E_cinnamoyl_CoA) -[node1376: 2.8.3.17 {br=BR47452, ev=eq, match=single}]-> (E_cinnamate + R_phenyllactyl_CoA);  // 3-(aryl)acryloyl-CoA:(R)-3-(aryl)lactate CoA-transferase
  react [node4808: 1.14.16.1 | -O2, -tetrahydrobiopterin] {Phe, 4a_hydroxy_tetrahydrobiopterin, Tyr};  // phenylalanine 4-monooxygenase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { R_phenyllactate E_cinnamate } bypasses { R_phenyllactate R_phenyllactyl_CoA E_cinnamoyl_CoA E_cinnamate };
  motif shunt { prephenate phenylpyruvate } bypasses { prephenate L_arogenate Phe phenylpyruvate };
  motif carrier { NAD NADH } forward { node4794 } backward { node1380 node4785 node4800 };
}
