pwl 2.0;
subsystem dapdiamides-biosynthesis 'dapdiamides biosynthesis' {
  // BRENDA subsystem: 9 reactions (8 with direction), 11 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound 2OG brenda:34 kegg:C00026;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound Gln brenda:102 kegg:C00064;
  compound Glu brenda:41 kegg:C00025;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound Ile brenda:311 kegg:C00407;
  compound Leu brenda:127 kegg:C00123;
  compound N3_fumaroyl_S_2_3_diaminopropanoate 'N3-fumaroyl-(S)-2,3-diaminopropanoate' brenda:199298 kegg:C20961;
  compound N3_fumarylcarboxyamido_L_2_3_diaminopropionic_acid 'N3-fumarylcarboxyamido-L-2,3-diaminopropionic acid' brenda:31057;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound N_2S_2_amino_2_carboxyethyl_L_Glu 'N-[(2S)-2-amino-2-carboxyethyl]-L-Glu' brenda:212362 kegg:C21559;
  compound O_phospho_Ser 'O-phospho-Ser' brenda:1189 kegg:C01005;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound S_2_3_diaminopropanoate '(S)-2,3-diaminopropanoate' brenda:199297;
  compound Ser brenda:95 kegg:C00065;
  compound dapdiamide_A 'dapdiamide A' brenda:200961 kegg:C20962;
  compound dapdiamide_B 'dapdiamide B' brenda:200964 kegg:C20963;
  compound dapdiamide_C 'dapdiamide C' brenda:200965 kegg:C20964;
  port Ser side L to serine-metabolism;

  Ser
    -[node11876: 2.7.1.225 | ATP>ADP, +H {br=BR52693, ev=cof+eq} || node11877: 2.7.1.226 | ADP>AMP, +H {br=BR52694, ev=cof+eq}]-> O_phospho_Ser;  // L-serine kinase (ATP); L-serine kinase (ADP)

  S_2_3_diaminopropanoate
    -L[node11613: 6.3.2.46 {br=BR51256, ev=eq}]-> N3_fumaroyl_S_2_3_diaminopropanoate  // fumarate-(S)-2,3-diaminopropanoate ligase
    -L[node2005: ? | ATP>AMP, Gln>Glu, -H2O, +PPi]- N3_fumarylcarboxyamido_L_2_3_diaminopropionic_acid  // N-3-fumaroyl-(S)-2,3-diaminopropanoate aminotransferase
    -[node1999: 6.3.2.47 | -Ile, +ADP, +Pi {br=BR51331, ev=cof+eq}]-> dapdiamide_B;  // dapdiamide synthase

  N3_fumarylcarboxyamido_L_2_3_diaminopropionic_acid
    -B[node2003: 6.3.2.47 | +ADP, +Pi ^R {br=BR51330, ev=cof+eq, match=kegg}]-> dapdiamide_A;  // dapdiamide synthase

  N3_fumarylcarboxyamido_L_2_3_diaminopropionic_acid
    -B[node1998: 6.3.2.47 | -Leu, +ADP, +Pi {br=BR51332, ev=cof+eq}]-> dapdiamide_C;  // dapdiamide synthase

  (O_phospho_Ser + Glu) -[node11879: 2.5.1.140 | +Pi {br=BR52061, ev=cof+eq}]-> N_2S_2_amino_2_carboxyethyl_L_Glu;  // N-(2-amino-2-carboxyethyl)-L-glutamate synthase
  N_2S_2_amino_2_carboxyethyl_L_Glu -[node11881: 1.5.1.51 | NAD>NADH, -H2O {br=BR51928, ev=cof+eq}]-> (2OG + S_2_3_diaminopropanoate);  // N-[(2S)-2-amino-2-carboxyethyl]-L-glutamate dehydrogenase
}
