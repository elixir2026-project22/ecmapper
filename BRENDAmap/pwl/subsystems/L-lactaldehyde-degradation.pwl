pwl 2.0;
subsystem L-lactaldehyde-degradation 'L-lactaldehyde degradation' {
  // BRENDA subsystem: 4 reactions (4 with direction), 4 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow down;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_lactaldehyde 'L-lactaldehyde' brenda:2968 kegg:C00424;
  compound L_lactate 'L-lactate' brenda:403 kegg:C00186;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound S_propane_1_2_diol '(S)-propane-1,2-diol' brenda:20321;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  port L_lactaldehyde side R to degradation-of-hexoses;

  L_lactaldehyde
    -[node2280: 1.2.1.22 | NADP>NADPH, -H2O, +2*H {br=BS402294, ev=cof+eq} || node9269: 1.2.1.22 | NAD>NADH, -H2O, +H {br=BR29393, ev=cof+eq}]-> L_lactate  // lactaldehyde dehydrogenase; lactaldehyde dehydrogenase
    -[node9265: 1.1.1.27 | oxidized_electron_acceptor>reduced_electron_acceptor ^R {br=BR29287, ev=eq}]-> pyruvate;  // L-lactate dehydrogenase

  L_lactaldehyde
    -B[node9261: 1.1.1.77 | NADH>NAD ^L {br=BS188642, ev=cof-eq}]-> S_propane_1_2_diol;  // lactaldehyde reductase
  // motifs (detected from the reactions above, see PWL.md)
  motif carrier { NAD NADH } forward { node9269 } backward { node9261 };
}
