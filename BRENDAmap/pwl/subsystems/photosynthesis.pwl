pwl 2.0;
subsystem photosynthesis 'photosynthesis' {
  // BRENDA subsystem: 22 reactions (19 with direction), 26 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compartment side1 'side 1';
  compartment side2 'side 2';
  compound 1_3_BPG '1,3-BPG' brenda:2125;
  compound 3_phospho_D_glycerate '3-phospho-D-glycerate' brenda:201 kegg:C00197;
  compound ADP brenda:13 kegg:C00008;
  compound AMP brenda:30 kegg:C00020;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound DHAP brenda:278 kegg:C00111;
  compound D_Rib_5_P 'D-Rib 5-P' brenda:183 kegg:C00117;
  compound D_Rul_5_P 'D-Rul 5-P' brenda:443 kegg:C00199;
  compound D_Xul_5_P 'D-Xul 5-P' brenda:644 kegg:C00231;
  compound D_sedoheptulose_1_7_PP 'D-sedoheptulose 1,7-PP' brenda:20229 kegg:C00447;
  compound E4P brenda:500 kegg:C00279;
  compound FBP brenda:6523;
  compound Fru_6_P 'Fru 6-P' brenda:87 kegg:C00085;
  compound GAP brenda:147 kegg:C00118;
  compound H 'H+' brenda:12 brenda:7924 brenda:7925 kegg:C00080;
  compound H2O brenda:1 kegg:C00001;
  compound L_malate 'L-malate' brenda:200 brenda:247;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound O2 brenda:9 brenda:1180;
  compound PEP brenda:51 kegg:C00074;
  compound PPi brenda:17 kegg:C00013;
  compound Pi brenda:16 kegg:C00009;
  compound Rul_1_5_PP 'Rul 1,5-PP' brenda:490 brenda:4373 kegg:C01182;
  compound S7P_L1657 'S7P' brenda:1657 kegg:C05382;
  compound hv brenda:1405 kegg:C00205;
  compound oxaloacetate brenda:57 kegg:C00036;
  compound oxidized_ferredoxin_Fe_S_cluster 'oxidized ferredoxin [Fe-S] cluster' brenda:202698 kegg:C00139;
  compound oxidized_plastocyanin 'oxidized plastocyanin' brenda:16309 kegg:C03162;
  compound plastoquinol brenda:3663 kegg:C16693;
  compound plastoquinone brenda:3359 kegg:C02061;
  compound pyruvate brenda:31 kegg:C00022;
  compound reduced_ferredoxin_Fe_S_cluster 'reduced ferredoxin [Fe-S] cluster' brenda:202701 kegg:C00138;
  compound reduced_plastocyanin 'reduced plastocyanin' brenda:9404 kegg:C03025;
  port NADPH side U to NAD-metabolism;

  // ring: cycle of the drawing (9 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    D_Rib_5_P
      -L[node9842: 5.3.1.6 {br=BR237, ev=eq}]-> D_Rul_5_P  // Ribose-5-phosphate isomerase
      -R[node9837: 2.7.1.19 | ATP>ADP, +H ^R {br=BR47758, ev=cof+eq}]-> Rul_1_5_PP  // phosphoribulokinase
      -[node9729: 4.1.1.39 | -H2O, -CO2, +2*H {br=BR297, ev=cof-eq}]-> 3_phospho_D_glycerate  // Ribulose-bisphosphate carboxylase
      -R[node9834: 2.7.2.3 | ATP>ADP, +H {br=BR47826, ev=cof+eq, match=single}]-> 1_3_BPG  // phosphoglycerate kinase
      -[node8288: 1.2.1.59 | NADPH>NADP, -H, +Pi {br=BR1125, ev=cof-eq, match=single} || node9840: 1.2.1.13 | NADPH>NADP, -H, +Pi {br=BR1125, ev=cof-eq, match=single}]-> GAP  // glyceraldehyde-3-phosphate dehydrogenase (NAD(P)+) (phosphorylating); glyceraldehyde-3-phosphate dehydrogenase (NADP+) (phosphorylating)
      -R[node9832: 5.3.1.1 {br=BR219, ev=eq, match=kegg}]-> DHAP  // Triose-phosphate isomerase
      -[node9833: 4.1.2.13 | -E4P ^R {br=BS1655, ev=cof-eq, match=kegg}]-> D_sedoheptulose_1_7_PP  // fructose-bisphosphate aldolase
      -[node9831: 3.1.3.37 | -H2O, +Pi {br=BR15940, ev=cof+eq}]-> S7P_L1657;  // sedoheptulose-bisphosphatase
    S7P_L1657 -[node9839: 2.2.1.1 | -GAP {br=BR43957, ev=cof+eq}]-> (D_Xul_5_P + D_Rib_5_P);  // transketolase
  }

  // ring: cycle of the drawing (8 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    react [node9566: 1.10.3.9 | -hv] {H2O, plastoquinone, O2, plastoquinol};  // photosystem II
    (2*oxidized_plastocyanin + plastoquinol) -[node1425: 7.1.1.6 | -H@side1, +H@side2 {br=BR37057, ev=eq}]-> (plastoquinone + 2*reduced_plastocyanin);  // plastoquinol-plastocyanin reductase
    (oxidized_ferredoxin_Fe_S_cluster + reduced_plastocyanin) -[node9562: 1.97.1.12 | -hv {br=BS413562, ev=cof+eq, match=kegg}]-> (oxidized_plastocyanin + reduced_ferredoxin_Fe_S_cluster);  // photosystem I
    react [node9558: 1.18.1.6] {oxidized_ferredoxin_Fe_S_cluster, NADPH, reduced_ferredoxin_Fe_S_cluster, NADP};  // adrenodoxin-NADP+ reductase
  }

  // ring: cycle of the drawing (4 metabolite nodes); see the motifs for biochemical cycles
  ring cw {
    PEP
      -R[node9687: 4.1.1.31 | -H2O, -CO2, +H, +Pi]- oxaloacetate  // phosphoenolpyruvate carboxylase
      -[node9685: 1.1.1.82 | NADPH>NADP, -H {br=BR29342, ev=cof-eq}]-> L_malate  // malate dehydrogenase (NADP+)
      -R[node9668: 1.1.1.40 | NADP>NADPH, +CO2 {br=BR29303, ev=cof+eq}]-> pyruvate  // malate dehydrogenase (oxaloacetate-decarboxylating) (NADP+)
      -B[node9663: 2.7.9.1 | ATP>AMP, -Pi, +PPi, +H {br=BR48096, ev=cof+eq}]-> PEP;  // pyruvate, phosphate dikinase
  }

  DHAP
    -L[node9820: 4.1.2.13 | -GAP ^L {br=BR344, ev=cof-eq, match=kegg}]-> FBP  // Fructose-bisphosphate aldolase
    -[node9822: 3.1.3.11 | -H2O, +Pi ^L {br=BR19198, ev=cof+eq}]-> Fru_6_P  // fructose-bisphosphatase
    -L[node9824: 2.2.1.1 | -GAP, +E4P ^R {br=BS320170, ev=cof-eq}]-> D_Xul_5_P  // transketolase
    <-R[node9826: 5.1.3.1 {br=BR184, ev=eq}]- D_Rul_5_P;  // ribulose-phosphate 3-epimerase
  // motifs (detected from the reactions above, see PWL.md)
  motif shunt { S7P_L1657 D_Xul_5_P } bypasses { S7P_L1657 D_Rib_5_P D_Rul_5_P D_Xul_5_P };
  motif shunt { oxidized_ferredoxin_Fe_S_cluster reduced_ferredoxin_Fe_S_cluster } bypasses { oxidized_ferredoxin_Fe_S_cluster oxidized_plastocyanin reduced_plastocyanin reduced_ferredoxin_Fe_S_cluster };
  motif shunt { plastoquinol plastoquinone } bypasses { plastoquinol reduced_plastocyanin oxidized_plastocyanin plastoquinone };
  motif carrier { NADP NADPH } forward { node9668 } backward { node8288 node9685 node9840 };
  motif transport { H@side1 H@side2 } via { node1425 };
}
