pwl 2.0;
subsystem ascorbate-metabolism 'ascorbate metabolism' {
  // BRENDA subsystem: 32 reactions (20 with direction), 27 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 1_dehydro_L_sorbose '1-dehydro-L-sorbose' brenda:13189 kegg:C19679;
  compound 2_3_dioxo_L_gulonate '2,3-dioxo-L-gulonate' brenda:29193 kegg:C04575;
  compound 2_dehydro_L_gulonolactone '2-dehydro-L-gulonolactone' brenda:182172;
