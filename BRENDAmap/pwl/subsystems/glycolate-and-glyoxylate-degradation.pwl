pwl 2.0;
subsystem glycolate-and-glyoxylate-degradation 'glycolate and glyoxylate degradation' {
  // BRENDA subsystem: 7 reactions (7 with direction), 7 drawn main-metabolite nodes.
  // flow, turn letters, ring, star and wrap describe the drawing; arrows and groups describe the reactions.
  flow right;
  compound 2_O_alpha_D_Glc_glycerate '2-O-(alpha-D-Glc)-glycerate' brenda:8878 kegg:C19792;
  compound 2_O_alpha_D_glucopyranosyl_3_phospho_D_glycerate '2-O-(alpha-D-glucopyranosyl)-3-phospho-D-glycerate' brenda:3045 kegg:C19791;
  compound 2_hydroxy_3_oxopropanoate '2-hydroxy-3-oxopropanoate' brenda:7099 kegg:C01146;
  compound 3_phospho_D_glycerate '3-phospho-D-glycerate' brenda:201 kegg:C00197;
  compound ADP brenda:13 kegg:C00008;
  compound ATP brenda:4 kegg:C00002;
  compound CO2 brenda:28 kegg:C00011;
  compound D_glycerate 'D-glycerate' brenda:2454 kegg:C00258;
  compound H2O brenda:1 kegg:C00001;
  compound NAD 'NAD+' brenda:7 kegg:C00003;
  compound NADH brenda:8 kegg:C00004;
  compound NADP 'NADP+' brenda:10 brenda:50;
  compound NADPH brenda:5 brenda:40;
  compound NDP brenda:1474 kegg:C00454;
  compound NDP_Glc 'NDP-Glc' brenda:22142 kegg:C15541;
  compound Pi brenda:16 kegg:C00009;
  compound glycolate brenda:479 kegg:C00160;
  compound glyoxylate brenda:101 kegg:C00048;
  compound oxidized_electron_acceptor 'oxidized electron acceptor' brenda:374 brenda:12937;
  compound reduced_electron_acceptor 'reduced electron acceptor' brenda:1661 kegg:C00030;
  port 2_hydroxy_3_oxopropanoate side L to degradation-of-sugar-acids;
  port D_glycerate side L to degradation-of-sugar-acids;
  port glycolate side U to degradation-of-pentoses;

  glycolate
    -[node2717: 1.1.1.79 | NADP>NADPH {br=BR29338, ev=cof+eq} || node10370: 1.1.1.26 | NAD>NADH {br=BR29285, ev=cof+eq} || node9228: 1.1.99.14 | oxidized_electron_acceptor>reduced_electron_acceptor {br=BR33706, ev=cof+eq}]-> glyoxylate  // glyoxylate reductase (NADP+); glyoxylate reductase; glycolate dehydrogenase
    -R[node9246: 4.1.1.47 | +CO2 ^L {br=BR306, ev=cof+eq}]-> 2_hydroxy_3_oxopropanoate;  // Tartronate-semialdehyde synthase

  D_glycerate
    -[node9226: 2.7.1.31 | ATP>ADP ^R {br=BR47771, ev=cof+eq}]-> 3_phospho_D_glycerate  // glycerate 3-kinase
    -R[node2635: 2.4.1.266 | -NDP_Glc, +NDP ^L {br=BR49464, ev=cof+eq}]-> 2_O_alpha_D_glucopyranosyl_3_phospho_D_glycerate  // glucosyl-3-phosphoglycerate synthase
    -[node11051: 3.1.3.85 | -H2O, +Pi ^L {br=BR49486, ev=cof+eq}]-> 2_O_alpha_D_Glc_glycerate;  // glucosyl-3-phosphoglycerate phosphatase
}
